#!/bin/bash
# Git hook: автодеплой на kamatera-chess при коммите/мерже в main
# Устанавливается через: bash scripts/install-hooks.sh

REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_DIR" ]; then
    echo "[post-hook] Ошибка: не удалось определить корень репозитория"
    exit 0
fi

BRANCH="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null)"

if [ "$BRANCH" != "main" ]; then
    exit 0
fi

echo ""
echo "=== [post-hook] Ветка main — запуск деплоя на kamatera-chess ==="
bash "$REPO_DIR/scripts/deploy-local.sh"
