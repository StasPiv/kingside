#!/bin/bash
# Pre-commit hook: проверка типов TypeScript (tsc --noEmit)
# Предотвращает коммиты с TS ошибками
# Устанавливается через: bash scripts/install-hooks.sh
#
# ВАЖНО: Используем git-common-dir (не show-toplevel) чтобы всегда
# получить основной репо, а не worktree path.
# Вызываем бинарники напрямую (не npx) — npx может модифицировать
# workspace symlinks в node_modules.

# Получаем путь к основному репо (не worktree)
GIT_COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
if [ -z "$GIT_COMMON_DIR" ]; then
    exit 0
fi
REPO_DIR="$(dirname "$GIT_COMMON_DIR")"

# Пропускаем проверку для internal: коммитов (через env variable)
if [ "$SKIP_TSC_CHECK" = "1" ]; then
    exit 0
fi

# Прямые пути к бинарникам (без npx — он ломает workspace symlinks)
TSC_CLI="$REPO_DIR/node_modules/typescript/bin/tsc"
PRISMA_CLI="$REPO_DIR/node_modules/prisma/build/index.js"

if [ ! -f "$TSC_CLI" ]; then
    echo "[pre-commit] WARN: tsc не найден ($TSC_CLI), пропускаем проверку"
    exit 0
fi

echo "[pre-commit] Проверка типов TypeScript..."

ERRORS=0

# apps/api
if [ -f "$REPO_DIR/apps/api/tsconfig.json" ]; then
    echo "  Generating Prisma client..."
    if [ -f "$PRISMA_CLI" ]; then
        node "$PRISMA_CLI" generate --schema="$REPO_DIR/apps/api/prisma/schema.prisma" 2>&1 | tail -1
    fi
    echo ""
    echo "  Checking apps/api..."
    node "$TSC_CLI" --noEmit --project "$REPO_DIR/apps/api/tsconfig.json" 2>&1
    if [ $? -ne 0 ]; then
        echo "  ❌ apps/api: TS ошибки"
        ERRORS=1
    else
        echo "  ✅ apps/api: OK"
    fi
fi

# apps/web
if [ -f "$REPO_DIR/apps/web/tsconfig.json" ]; then
    echo "  Checking apps/web..."
    node "$TSC_CLI" --noEmit --project "$REPO_DIR/apps/web/tsconfig.json" 2>&1
    if [ $? -ne 0 ]; then
        echo "  ❌ apps/web: TS ошибки"
        ERRORS=1
    else
        echo "  ✅ apps/web: OK"
    fi
fi

if [ $ERRORS -ne 0 ]; then
    echo ""
    echo "[pre-commit] Коммит отклонён — исправьте TS ошибки."
    echo "Для пропуска проверки: SKIP_TSC_CHECK=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Типы OK"

# --- features-catalog check (KS-2963 / ADR-062 §15.3) ---
# Каталог фич AI-ассистента (packages/shared/src/features-catalog/)
# должен оставаться в строгом соответствии с реальными роутами
# apps/web/src/App.tsx. Скрипт читает скомпилированный каталог из
# packages/shared/dist/features-catalog/index.js — если dist не собран,
# сам же скажет «Run tsc --build packages/shared first».
#
# Пропуск: SKIP_FEATURES_CHECK=1 git commit ...
if [ "$SKIP_FEATURES_CHECK" = "1" ]; then
    echo "[pre-commit] features-catalog: пропущено (SKIP_FEATURES_CHECK=1)"
    exit 0
fi

CHECK_SCRIPT="$REPO_DIR/tools/check-features-catalog.mjs"
if [ ! -f "$CHECK_SCRIPT" ]; then
    echo "[pre-commit] WARN: $CHECK_SCRIPT не найден, пропускаем features-catalog check"
    exit 0
fi

echo "[pre-commit] Проверка каталога фич (check:features)..."
( cd "$REPO_DIR" && node "$CHECK_SCRIPT" )
FEATURES_EXIT=$?
if [ $FEATURES_EXIT -ne 0 ]; then
    echo ""
    echo "[pre-commit] Коммит отклонён — features-catalog рассинхронизирован."
    echo "Подробности выше. Для пропуска: SKIP_FEATURES_CHECK=1 git commit ..."
    exit 1
fi

echo "[pre-commit] features-catalog OK"
exit 0
