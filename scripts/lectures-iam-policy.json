{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadWriteDeleteLectureAudio",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::kingside-lectures/audio/*"
    },
    {
      "Sid": "AllowListLecturesBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::kingside-lectures",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "audio/*",
            "audio/"
          ]
        }
      }
    },
    {
      "Sid": "AllowReadCloudfrontSigningKey",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:342946498289:secret:kingside/cloudfront/lectures-signing-key-*"
    }
  ]
}
