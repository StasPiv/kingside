# Build artefacts
dist/
*.tsbuildinfo

# Dataset generator outputs (KS-2360 v1 + KS-3091 v2).
# Только meta-манифесты коммитим; cell-битмапы (>1M файлов, ~4 GB) и
# пакованные h5 уходят на S3 (регенерация — `python3 src/python/dataset_gen.py`).
# Preview-сетки v2 (~400 KB) — выкладываем в S3 через upload-board-dataset.sh,
# в репо не лежат.
data/v1/
data/v2/
!data/manifest_v1.json
!data/manifest_v2.json

# Cached SVG sources (re-fetched on demand by scripts/fetch_styles.sh).
styles_cache/

# Python
__pycache__/
*.pyc
