generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid()) @db.Uuid
  username              String?  @unique
  requiresUsernameSetup Boolean  @default(false) @map("requires_username_setup")
  email                 String?  @unique
  passwordHash          String?  @map("password_hash")
  oauthProvider         String?  @map("oauth_provider")
  oauthProviderId       String?  @map("oauth_provider_id")
  telegramId            String?  @unique @map("telegram_id")
  ratingBullet          Int      @default(1500) @map("rating_bullet")
  ratingBlitz           Int      @default(1500) @map("rating_blitz")
  ratingRapid           Int      @default(1500) @map("rating_rapid")
  ratingClassical       Int      @default(1500) @map("rating_classical")
  ratingPuzzle          Int      @default(1500) @map("rating_puzzle")
  /// KS-2311 (methodology §10.4): drill rating (Glicko-1) и его RD.
  /// Cold-start 1500 / 350. Только drill mode обновляет; sprint — нет.
  ratingDrill           Int      @default(1500) @map("rating_drill")
  ratingDrillDev        Int      @default(350)  @map("rating_drill_dev")
  ratingPuzzleDev       Int      @default(350) @map("rating_puzzle_dev")
  puzzleStreak          Int      @default(0) @map("puzzle_streak")
  /// KS-3440 / ADR-088 §10. Глобальный best-streak в blind-board.
  /// Обновляется при finish сессии (только для авторизованных) —
  /// используется лидербордом топ-N. Default 0 — у новых юзеров.
  blindBoardBestStreak  Int      @default(0) @map("blind_board_best_streak")
  /// KS-3551 / ADR-088 V3 §16.5. Лучший достигнутый уровень в
  /// blind-board. Считается с учётом `BlindBoardSession.startConfig
  /// .levelDurationRounds` той сессии, где был достигнут рекорд:
  /// `floor(bestStreak / levelDurationRounds) + 1`. Хранится отдельно
  /// (а не выводится на лету), потому что для подсчёта нужен config
  /// конкретной рекордной сессии — её can удалить позже (KS-3530), и
  /// тогда рассчитать ретроспективно невозможно. Backfill: V2 эра —
  /// `floor(bestStreak / 10) + 1`.
  blindBoardBestLevel   Int      @default(1) @map("blind_board_best_level")
  /// KS-3551 / ADR-088 V3 §16.6. `true` если рекордная сессия была
  /// сыграна на дефолтном `BlindBoardConfig`
  /// (`isDefaultBlindBoardConfig(...)===true`). Используется лидербордом
  /// для метки «эталонный режим» и фильтра «только default». До V3 у
  /// всех записей backfill = true (другого конфига не существовало).
  blindBoardBestConfigIsDefault Boolean @default(true) @map("blind_board_best_config_is_default")
  gamesPlayedBullet     Int      @default(0) @map("games_played_bullet")
  gamesPlayedBlitz      Int      @default(0) @map("games_played_blitz")
  gamesPlayedRapid      Int      @default(0) @map("games_played_rapid")
  gamesPlayedClassical  Int      @default(0) @map("games_played_classical")
  createdAt             DateTime @default(now()) @map("created_at")
  lastSeenAt            DateTime @default(now()) @map("last_seen_at")
  locale                String   @default("en") @map("locale")
  /// KS-4695 / ADR-147 §6.2. Согласие пользователя на трекинг analytics-
  /// событий (`actor_events`) и показ контекстных подсказок.
  /// Default false — ужесточение относительно текущего Notification flow,
  /// необходимо для GDPR. `EventsService.track({type:'user',id})` первым
  /// делом читает это поле и при false выкидывает событие на входе.
  /// Отзыв согласия (банер → снять галочку) — отдельный endpoint
  /// `PATCH /me/consent {analytics:false}` (входит в Этап 2 ADR-147,
  /// отдельная задача). Здесь — только storage.
  analyticsConsent      Boolean  @default(false) @map("analytics_consent")
  boardTheme            String   @default("default") @map("board_theme")
  pieceSet              String   @default("standard") @map("piece_set")
  soundEnabled          Boolean  @default(true) @map("sound_enabled")
  /// KS-4311. Пользовательский флаг отображения отладочной панели
  /// шахматного движка (`BotEngineDebugPanel` на фронте). Включается
  /// в настройках профиля, на сервере хранится здесь же — рядом с
  /// остальными UI-настройками. По умолчанию выключен.
  showBotEngineDebugPanel Boolean @default(false) @map("show_bot_engine_debug_panel")
  isBot                 Boolean  @default(false) @map("is_bot")
  /// KS-2160 (ADR-034 §2.1). Synthetic-user — отдельная категория от `isBot`:
  /// - `isBot=true`  — старая legacy-роль 30s matchmaking fallback (12 fixed UUID-ов
  ///   из `MATCHMAKING_BOTS`); готовится к выводу в KS-2161+.
  /// - `isSynthetic=true` — новая категория эмулированных пользователей с
  ///   полноценной игрой через Stockfish-pool, профили, presence (KS-2161+).
  /// На время миграции возможны записи c обоими флагами; data-migration
  /// `20260430120000_add_synthetic_fields` переводит 12 legacy-ботов в
  /// `isBot=false, isSynthetic=true` (см. KS-2160 §3).
  isSynthetic           Boolean  @default(false) @map("is_synthetic")
  /// KS-2255 (ADR-036 §3, screenshot tooling E1). Признак seed-аккаунта,
  /// созданного для генерации скриншотов. Используется фильтрацией
  /// в публичных endpoint'ах (KS-2256) — не светим эти аккаунты в
  /// общих списках/чартах. Пишет только seed-скрипт screenshot tooling.
  isTestAccount         Boolean  @default(false) @map("is_test_account")
  /// KS-2255 (ADR-036 §3, screenshot tooling E1). Универсальный флаг
  /// «скрыт из публичных выдач» (модерация / временная блокировка /
  /// служебные аккаунты). Совместно с `isTestAccount` фильтруется в
  /// KS-2256.
  isHidden              Boolean  @default(false) @map("is_hidden")
  /// KS-2160. Двухбуквенный ISO-3166-1 alpha-2 (RU, US, IN, BR…). Используется
  /// в профиле пользователя для отображения флага. Nullable — реальные
  /// пользователи могут не указывать страну. Для synthetic-ов обязателен,
  /// проставляется генератором профиля (KS-2162).
  country               String?  @db.Char(2)
  chesscomUsername      String?  @map("chesscom_username")
  lichessUsername       String?  @map("lichess_username")
  /// KS-2210: JSON-объект с сохранёнными фильтрами архивного поиска.
  /// Nullable — для пользователей, не выставлявших фильтры.
  archiveFilters        Json?    @map("archive_filters")

  whiteGames             Game[]                   @relation("WhitePlayer")
  blackGames             Game[]                   @relation("BlackPlayer")
  chatMessages           ChatMessage[]
  timeControls           UserTimeControl[]
  puzzleAttempts         PuzzleAttempt[]
  puzzleRushScores       PuzzleRushScore[]
  gameAnalyses           GameAnalysis[]
  analyses               Analysis[]
  savedFilters           SavedFilter[]
  pgnImports             PgnImport[]
  sentMessages           DirectMessage[]          @relation("SentMessages")
  receivedMessages       DirectMessage[]          @relation("ReceivedMessages")
  sentFriendships        Friendship[]             @relation("FriendshipRequester")
  receivedFriendships    Friendship[]             @relation("FriendshipAddressee")
  blockedUsers           BlockedUser[]            @relation("Blocker")
  blockedByUsers         BlockedUser[]            @relation("Blocked")
  ratingHistory          RatingHistory[]
  arenaEntries           ArenaTournamentEntry[]
  notifications          Notification[]
  puzzleRatingSnapshots  PuzzleRatingSnapshot[]
  chatConversations      ChatConversation[]
  feedback               Feedback[]
  feedbackComments       FeedbackComment[]
  courseProgress         UserCourseProgress[]
  lessonProgress         UserLessonProgress[]
  lessonReviews          LessonReview[]
  mistakes               UserMistake[]
  // KS-2639 / ADR-054 §3.2 Phase A. Курсы, у которых User —
  // владелец (Course.ownerId). Системные курсы остаются с
  // ownerId=NULL и в этой связи не участвуют. onDelete Cascade —
  // удаление пользователя сносит его авторские курсы.
  // KS-2649 / Phase E3: legacy `userCourses`, `userCoursePlayProgress`,
  // `userLessonPlayProgress` relations удалены вместе с моделями.
  ownedCourses           Course[]                 @relation("OwnedCourses")
  // KS-2226 (ADR-035 §4): Drills attempt'ы и sprint-скоры юзера.
  tacticDrillAttempts    TacticDrillAttempt[]
  tacticDrillSprintScores TacticDrillSprintScore[]
  // KS-2373: статистика посещений разделов для динамического
  // MobileBottomBar (top-3 разделы → нижняя панель, остальные в «Ещё»).
  navStats               UserNavStat[]
  // KS-4982 / ADR-167: итоги Sprint-сессий Vision-тренажёра (зрение доски).
  visionScores           VisionScore[]
  // KS-3208 / ADR-074 §10 B4: audit-журнал AI-генераций курсов.
  aiLessonGenerations    AiLessonGeneration[]
  // KS-3270 / ADR-077: репертуары и сессии Opening Trainer'а.
  openingRepertoires       OpeningRepertoire[]
  openingTrainerSessions   OpeningTrainerSession[]
  // KS-3287 (M2 §2.5): per-path прогресс линий.
  openingLineProgress      OpeningLineProgress[]
  // KS-3342 / ADR-079 §3.6.1: Precision-рейтинг (Glicko-1, отдельная
  // кривая от ratingPuzzle — precision имеет свою сложность).
  precisionRating          UserPrecisionRating?
  // KS-3730 / ADR-110: live-трансляции анализа партии (owner-relation).
  liveAnalyses             LiveAnalysis[]
  // KS-3783 / ADR-113 §2: лекции тренера (owner-relation, onDelete: Cascade).
  lectures                 Lecture[]
  // KS-3930 / ADR-118 §3.2: allowlist-записи, выданные этим пользователем
  // (audit-связь grantedBy → User). Сам факт «у пользователя есть доступ
  // к чужой лекции» здесь НЕ хранится (это subjectId в lecture_access_grants,
  // которая полиморфна и не имеет FK).
  grantedAccess            LectureAccessGrant[]    @relation("LectureAccessGrants")
  // KS-4008 / ADR-121 Phase 1: чат лекции.
  //   - `lectureChatMessages` — все сообщения, авторизованные этим юзером
  //     (onDelete: SetNull в LectureChatMessage; сообщения сохраняются).
  //   - `lectureChatMutesReceived` — мьюты в чате лекций, выписанные на
  //     этого юзера (onDelete: Cascade — удаление юзера сносит мьюты).
  //   - `lectureChatMutesIssued` — мьюты, наложенные этим юзером как
  //     тренером (onDelete: Cascade — снос вместе с автором).
  lectureChatMessages       LectureChatMessage[]   @relation("LectureChatAuthor")
  lectureChatMutesReceived  LectureChatMute[]      @relation("LectureChatMutedUser")
  lectureChatMutesIssued    LectureChatMute[]      @relation("LectureChatMutedBy")
  // KS-4023 / KS-4026 / ADR-122. Кто запустил расчёт позиционной
  // трассы анализа (audit-поле, не для авторизации; права на запись
  // регулируются guard'ом контроллера).
  positionalTraces          AnalysisPositionalTrace[] @relation("PositionalTraceCreatedBy")
  // KS-4339 / ADR-135 §2.1: новый банк tactic-пазлов на Maia-difficulty.
  // Полностью изолирован от puzzleAttempts / precisionRating — другой
  // концепт, своя кривая рейтинга.
  tacticPuzzleAttempts      TacticPuzzleAttempt[]
  tacticUserMistakes        TacticUserMistake[]
  tacticRating              UserTacticRating?
  // KS-4354 / ADR-136 §3.6: дневной снимок рейтинга по разделу
  // «Точность» — источник графика динамики на /tactic-puzzles/stats.
  tacticRatingSnapshots     TacticRatingSnapshot[]
  // KS-4467 / ADR-140 T1: лайки и комментарии под статьями блога.
  // Лайк onDelete: Cascade — удаление пользователя сносит его лайки.
  // Комментарий onDelete: Restrict — нельзя удалить пользователя с
  // комментариями без явной обработки (см. ADR-140 §2.1).
  blogPostLikes             BlogPostLike[]
  blogPostComments          BlogPostComment[]
  // KS-4880 / ADR-160 §3, KS-4927 / ADR-163: тренировки (до 5),
  // сгенерированные сессии, каналы уведомлений и снапшоты активности.
  studySchedules            StudySchedule[]
  studySessions             StudySession[]
  notificationChannels      NotificationChannel[]
  externalActivitySnapshots ExternalActivitySnapshot[]

  @@unique([oauthProvider, oauthProviderId])
  /// KS-2160. Partial-индекс по synthetic-флагу. На реальных пользователях
  /// (~99% выборки) `is_synthetic=false`, поэтому полный индекс — почти
  /// весь sequential scan. Postgres `@@index` без `where` всё равно
  /// быстрее scan'а (особенно для scheduler'а из KS-2164, который делает
  /// `findMany WHERE is_synthetic=true LIMIT N`).
  @@index([isSynthetic])
  /// KS-2311 (Drills E6, Glicko leaderboard): индекс для быстрой
  /// сортировки по drill rating в leaderboard'е. Создан миграцией
  /// `20260503170000_drill_rating`. Имя `users_rating_drill_idx`
  /// зафиксировано для совпадения с БД (KS-2608: drift fix).
  @@index([ratingDrill(sort: Desc)], name: "users_rating_drill_idx")
  @@map("users")
}

enum GameStatus {
  waiting
  active
  finished
  aborted
}

enum GameResult {
  white
  black
  draw
}

enum Termination {
  checkmate
  resignation
  timeout
  draw_agreement
  stalemate
  insufficient
  repetition
  fifty_moves
  abort
  abandon
}

enum TimeControlType {
  bullet
  blitz
  rapid
  classical
}

model Game {
  id                String          @id @default(uuid()) @db.Uuid
  whiteId           String          @map("white_id") @db.Uuid
  blackId           String          @map("black_id") @db.Uuid
  status            GameStatus      @default(waiting)
  result            GameResult?
  termination       Termination?
  timeControlType   TimeControlType @map("time_control_type")
  timeInitialSec    Int             @map("time_initial_sec")
  timeIncrementSec  Int             @map("time_increment_sec")
  pgn               String?
  eco               String?
  finalFen          String?         @map("final_fen")
  whiteRatingBefore Int?            @map("white_rating_before")
  blackRatingBefore Int?            @map("black_rating_before")
  whiteRatingAfter  Int?            @map("white_rating_after")
  blackRatingAfter  Int?            @map("black_rating_after")
  whiteBerserk      Boolean         @default(false) @map("white_berserk")
  blackBerserk      Boolean         @default(false) @map("black_berserk")
  isBot             Boolean         @default(false) @map("is_bot")
  botLevel          Int?            @map("bot_level")
  /// KS-2160 (ADR-034 §2.1). Маркер «одна из сторон — synthetic-user».
  /// Используется для аудита, фильтров в админке и будущих use-cases.
  /// **Не используется для исключения из публичных чартов** — KS-2167
  /// отменена, synthetic = полноценный пользователь и виден в публичных
  /// листингах как обычный.
  isSyntheticOpponent Boolean       @default(false) @map("is_synthetic_opponent")
  /// KS-2160. Имя «фонового» соперника для отображения в истории партий
  /// — на случай если в будущем мы захотим показать имя без создания
  /// `User`-записи (Q4 ADR-034). Пока nullable и не используется
  /// (текущее решение — реальный User-record для каждого synthetic).
  opponentNameSynthetic String?     @map("opponent_name_synthetic")
  createdAt         DateTime        @default(now()) @map("created_at")
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  tournamentId      String?         @map("tournament_id") @db.Uuid

  white        User             @relation("WhitePlayer", fields: [whiteId], references: [id])
  black        User             @relation("BlackPlayer", fields: [blackId], references: [id])
  moves        Move[]
  chatMessages ChatMessage[]
  analyses     GameAnalysis[]
  report       GameReport?
  tournament   ArenaTournament? @relation(fields: [tournamentId], references: [id])
  mistakes     UserMistake[]

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
  @@index([createdAt])
  @@index([isBot, status])
  /// KS-2160. Индекс по `is_synthetic_opponent` НЕ создан — KS-2167
  /// (исключение synthetic из публичных чартов) отменена, и без её
  /// SELECT'ов селективного use-case у индекса не остаётся. Поле
  /// сохранено как маркер для аудита/админки.
  @@index([tournamentId])
  @@map("games")
}

enum PieceColor {
  white
  black
}

model Move {
  id         String     @id @default(uuid()) @db.Uuid
  gameId     String     @map("game_id") @db.Uuid
  moveNumber Int        @map("move_number")
  color      PieceColor
  uci        String
  san        String
  fenAfter   String     @map("fen_after")
  timeLeftMs Int        @map("time_left_ms")
  createdAt  DateTime   @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId, moveNumber])
  @@map("moves")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([gameId])
  @@map("chat_messages")
}

model UserTimeControl {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String?
  initialSec   Int      @map("initial_sec")
  incrementSec Int      @map("increment_sec")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_time_controls")
}

model Puzzle {
  id         String   @id
  fen        String
  moves      String
  rating     Int      @default(1500)
  ratingDev  Int      @default(350) @map("rating_dev")
  popularity Int      @default(0)
  nbPlays    Int      @default(0) @map("nb_plays")
  themes     String   @default("")
  source     String   @default("lichess")
  createdAt  DateTime @default(now()) @map("created_at")

  // Lichess-specific (nullable for generated)
  gameUrl     String? @map("game_url")
  openingTags String? @map("opening_tags")

  // Generated-specific (nullable for lichess)
  sourceType     String? @map("source_type")
  sourceId       String? @map("source_id")
  sourceMoveNum  Int?    @map("source_move_num")
  gap            Int?
  depth          Int?
  createdBy      String? @map("created_by") @db.Uuid
  isPublic       Boolean @default(true) @map("is_public")
  sourceMetadata String? @map("source_metadata") @db.Text
  acceptedMoves  String? @map("accepted_moves")
  /// KS-2762. ELO белых/чёрных в партии-источнике (денормализованная
  /// копия из `archive_games.white_elo` / `black_elo`). Используется
  /// фильтром /puzzles/browse по рейтингу зевнувшего: CASE по
  /// side-to-move из `source_metadata.fenBeforeBlunder`.
  /// Заполняется генератором tactic-worker; для lichess/legacy = NULL.
  sourceWhiteElo Int?    @map("source_white_elo")
  sourceBlackElo Int?    @map("source_black_elo")

  // KS-2463 / ADR-044 §3.2. Режим решения пазла:
  //   - 'forced-line' — классический пазл с фиксированной линией;
  //   - 'play-vs-engine' — открытая защита (решатель играет против
  //     движка, удерживая WDL ≥ порога). Старые пазлы получают
  //     'forced-line' через DEFAULT.
  solutionMode String @default("forced-line") @map("solution_mode")

  /// KS-3639 / ADR-106 §2.5. Суммарная вероятность Maia сыграть один
  /// из «слабых» ходов (`loss_E > 0.02` относительно лучшего из
  /// `{firstMovePV1} ∪ MaiaTopK`). Заполняется offline-разметкой
  /// admin-CLI `tools/maia-puzzle-annotation/` (T1) либо tactic-
  /// worker'ом при создании нового пазла (T2). `NULL` — ещё не
  /// размечен (safe fallback: фронт пропускает такие пазлы).
  ///
  /// Семантика инвертирована относительно отменённой ADR-104:
  /// пазл проходит фильтр, если значение `>=` порога
  /// `PRECISION_MAIA_DEFAULT_THRESHOLD` (default 0.3). Историческое имя
  /// колонки `maia_top1_prob` переименовано миграцией KS-3639; значения
  /// под старой семантикой считаются «грязными» до T1 `--force`
  /// (ADR-106 §5).
  maiaWeakChoiceProb Float? @map("maia_weak_choice_prob")

  /// KS-3639 / ADR-106 §2.5. Версия алгоритма расчёта
  /// `maiaWeakChoiceProb`. `1` = ADR-106 §2.1 (динамический MaiaTopK
  /// порог `policy > 0.10`, K_max=8, weak = `loss_E > 0.02`).
  /// Инкрементируется при любой смене формулы (K_max / порог policy /
  /// порог loss_E). `NULL` — значение либо не размечено, либо
  /// унаследовано от отменённой ADR-104; фронт по `maiaMetricVersion
  /// != 1` исключает такие строки из активного фильтра (см. ADR-106 §5
  /// и WHERE для `--resume` в T1).
  maiaMetricVersion Int? @map("maia_metric_version")

  /// KS-3631 / ADR-104 §4 (поле сохранено в ADR-106 §2.5). ELO, под
  /// которым прогоняли Maia. Хранится для воспроизводимости и для
  /// проверки актуальности значения при смене ENV
  /// `PRECISION_MAIA_ANNOTATION_ELO`: если ENV != `maiaTop1Elo` —
  /// admin-CLI с `--force --elo NEW` перерасчитывает.
  maiaTop1Elo  Int?   @map("maia_top1_elo")

  attempts           PuzzleAttempt[]
  dailyPuzzles       DailyPuzzle[]
  rushSessionPuzzles PuzzleRushSessionPuzzle[]
  mistakes           UserMistake[]

  @@index([rating])
  @@index([themes])
  @@index([source])
  @@index([createdBy])
  @@index([solutionMode])
  // KS-2557: ORDER BY created_at DESC LIMIT 20 для /puzzles/browse —
  // на 6M lichess строк без индекса делал full scan + sort.
  @@index([createdAt])
  // KS-2762. Фильтрация на /precision по рейтингу зевнувшего —
  // запрос пробегает по source_*_elo (CASE по side-to-move).
  @@index([sourceWhiteElo])
  @@index([sourceBlackElo])
  /// KS-3639 / ADR-106 §2.5. Composite-индекс под основной precision-
  /// запрос: `WHERE solution_mode = 'play-vs-engine' AND
  /// (maia_weak_choice_prob IS NULL OR maia_weak_choice_prob >=
  /// threshold)`. Покрывает основной фильтр без лишних seq-scan'ов.
  /// (Историческое имя `puzzles_solution_mode_maia_top1_prob_idx`
  /// переименовано той же миграцией.)
  @@index([solutionMode, maiaWeakChoiceProb])
  // KS-2562: getNextPuzzle делает range scan по rating + ORDER BY
  // popularity DESC LIMIT 10. Полный composite на 6M строк не вмещается
  // в shared_buffers t3.micro — partial WHERE popularity >= 50
  // (топ-10% lichess-пазлов) сжимает индекс до ~25 МБ → hot cache.
  // Prisma 6 не умеет partial-индексы декларативно — индекс создаётся
  // только через миграцию `20260507162355_puzzles_popular_partial_idx`.
  @@map("puzzles")
}

model PuzzleAttempt {
  id                 String   @id @default(uuid()) @db.Uuid
  puzzleId           String   @map("puzzle_id")
  userId             String   @map("user_id") @db.Uuid
  solved             Boolean
  timeMs             Int      @map("time_ms")
  ratingBefore       Int      @map("rating_before")
  ratingAfter        Int      @map("rating_after")
  puzzleRatingBefore Int?     @map("puzzle_rating_before")
  puzzleRatingAfter  Int?     @map("puzzle_rating_after")
  userMoves          String?  @map("user_moves")
  hintsUsed          Int      @default(0) @map("hints_used")
  createdAt          DateTime @default(now()) @map("created_at")

  // KS-2675: Cascade при удалении пазла — иначе DELETE /puzzles/:id
  // падает на FK при наличии хоть одной попытки. Семантически
  // attempt-история конкретного пазла теряет смысл без него.
  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  /// KS-2717 / ADR-056 §3. 1:1 — для PVE-attempts здесь живут
  /// доменные precision-метрики (для forced-line отсутствует).
  precisionAttempt PrecisionAttempt?

  @@index([userId])
  @@index([puzzleId])
  @@index([userId, createdAt])
  @@index([userId, puzzleId, solved])
  @@map("puzzle_attempts")
}

/// KS-2717 / ADR-056 §3.2. Доменная сводка одной play-vs-engine
/// попытки. 1:1 с `puzzle_attempts` (PK = FK = `attempt_id`); для
/// forced-line попыток записи нет.
model PrecisionAttempt {
  attemptId String @id @map("attempt_id") @db.Uuid

  /// Стартовый и финальный WDL_signed [-1..+1] от лица решающего.
  /// Snapshot — на момент попытки (пазл может быть отредактирован/
  /// перегенерирован позже, оригинальное значение не пересчитываем).
  wdlAtStartSigned Float @map("wdl_at_start_signed")
  wdlAtEndSigned   Float @map("wdl_at_end_signed")
  /// Сколько полуходов решающего сыграно. ≤ halfMovesTarget.
  halfMovesPlayed  Int   @map("half_moves_played")
  /// Целевая длина (halfMovesN из puzzle params).
  halfMovesTarget  Int   @map("half_moves_target")

  /// Серверный пересчёт; клиентскому полю не верим (ADR-056 §3.3).
  accuracyPercent     Float @map("accuracy_percent")
  bestMovesCount      Int   @map("best_moves_count")
  goodMovesCount      Int   @map("good_moves_count")
  inaccuraciesCount   Int   @map("inaccuracies_count")
  mistakesCount       Int   @map("mistakes_count")
  blundersCount       Int   @map("blunders_count")
  /// 1-based ply первого `mistake|blunder`. null — ошибок не было.
  firstMistakePly     Int?  @map("first_mistake_ply")
  /// Σ(wdlBefore − wdlAfter) по ходам решающего, [0..N].
  wdlLeakSum          Float @map("wdl_leak_sum")

  /// `'win' | 'win-mate' | 'win-engine-resign' | 'lose-wdl' |
  /// 'lose-mate' | 'timeout' | 'aborted'`.
  endReason String @map("end_reason")

  /// KS-2998 / ADR-065 §6.1. 5-балльная оценка решения precision-задачи.
  /// 1..5 stars. `null` для:
  ///  - legacy-attempt'ов без per-move WDL и без cp (бэкфил B5 пройдёт
  ///    только по тем, у кого есть данные);
  ///  - attempt'ов с `halfMovesPlayed < 2` (ADR-065 §3.2);
  ///  - attempt'ов где >50% per-move-данных отсутствуют (§3.4).
  /// См. `computePrecisionScore` в `packages/shared/src/utils/precision-score.ts`.
  score    Int?    @map("score")
  /// KS-2998 / ADR-065 §6.1. scorePct (0..100) до округления до звёзд —
  /// используется фронтом для подписи «87% точности» и trend-графиков.
  /// `null` синхронно со `score`.
  scorePct Float?  @map("score_pct")

  /// KS-3246. Достигнута ли цель пазла (по objective из source_metadata).
  /// Правила (E = (W + D/2) / 1000, POV игрока):
  ///   - convertAdvantage: end_E ≥ start_E − 0.02 (зона округления);
  ///   - saveEquality:     end_E ≥ start_E − 0.05.
  /// `null` для legacy-attempt'ов без per-move WDL (backfill в миграции
  /// проставит для тех, у кого данные есть). Колонка нужна для:
  ///   1) frontend-плашки KS-3248 (терминологически корректный текст
  ///      по матрице star × goal_achieved);
  ///   2) аналитики «доля решённых-но-не-точных», «упустил перевес» и т.п.
  objectiveAchieved Boolean? @map("objective_achieved")

  /// KS-3342 / ADR-079 §3.6.2: Precision-рейтинг ДО попытки. `null` для:
  ///  - гостей (рейтинг не пишется);
  ///  - User.isHidden / User.isTestAccount (service-аккаунты, ADR-035 §10.7-4);
  ///  - self-created puzzle (anti-cheat KS-3339 ревизия 3);
  ///  - legacy-attempt'ов до выкатки ADR-079 (backfill не делаем — §3.6.3).
  ratingBefore Float? @map("rating_before")
  /// KS-3342 / ADR-079 §3.6.2: Precision-рейтинг ПОСЛЕ попытки. `null` синхронно с before.
  ratingAfter  Float? @map("rating_after")

  attempt PuzzleAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  moves   PrecisionAttemptMove[]

  @@map("precision_attempts")
  @@index([accuracyPercent])
  @@index([endReason])
  /// KS-2998 / ADR-065 §6.1. Индекс для агрегатов «средний балл /
  /// распределение по звёздам» в Уровне А и trend-графиков.
  @@index([score])
  /// KS-3246. Агрегаты «решено vs цель достигнута», фильтры на
  /// /precision/history по поведению пользователя.
  @@index([objectiveAchieved])
}

/// KS-3342 / ADR-079 §3.6.1. Precision-рейтинг пользователя (Glicko-1).
/// Отдельная таблица от `User.ratingPuzzle` — precision имеет свою
/// кривую сложности (ADR-044 §3.5), смешивание двух метрик неверно.
/// Cold-start: rating=1500, deviation=350, volatility=0.06.
/// Обновляется в `PrecisionService.create` через
/// `PrecisionRatingService.applyRatingChange` (KS-3343).
model UserPrecisionRating {
  userId        String    @id @map("user_id") @db.Uuid
  rating        Float     @default(1500)
  /// Glicko RD. Большой RD (350) → высокая неопределённость, рейтинг
  /// двигается быстрее. После многих попыток сужается до ~50-100.
  deviation     Float     @default(350)
  /// Glicko-2 параметр (для будущего; в MVP не используется,
  /// `applyRatingChange` идёт по Glicko-1 continuous через
  /// `GlickoRatingService`).
  volatility   Float     @default(0.06)
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_precision_ratings")
}

/// KS-2717 / ADR-056 §3.2. Per-move детализация — для PostGameReview
/// (Уровень Б) и SQL-агрегатов «top типов ошибок» (Уровень В).
model PrecisionAttemptMove {
  attemptId    String  @map("attempt_id") @db.Uuid
  /// 1-based по полуходам пользователя в попытке.
  ply          Int
  fenBefore    String  @map("fen_before")
  playedUci    String  @map("played_uci")
  /// PV1 движка для `fenBefore` (best). NULL не допускается — без
  /// best-хода classification невозможна; принудительный отбой
  /// на уровне сервиса.
  bestUci      String  @map("best_uci")
  /// KS-2754. UCI ответного хода движка на user-ход (например `e7e5`).
  /// NULL если движок не успел ответить (последний user-полуход
  /// партии: мат, пат, abort) или для legacy-attempt'ов до KS-2754.
  engineUci    String? @map("engine_uci")
  /// WDL per-mille (0..1000) raw от Stockfish, POV side-to-move
  /// в `fenBefore` (для wdlBefore) и в позиции после хода (wdlAfter).
  wdlBeforeW   Int?    @map("wdl_before_w")
  wdlBeforeD   Int?    @map("wdl_before_d")
  wdlBeforeL   Int?    @map("wdl_before_l")
  wdlAfterW    Int?    @map("wdl_after_w")
  wdlAfterD    Int?    @map("wdl_after_d")
  wdlAfterL    Int?    @map("wdl_after_l")
  depth        Int?
  /// `'best' | 'good' | 'inaccuracy' | 'mistake' | 'blunder'` —
  /// серверный пересчёт через `classifyMove` из @kingside/shared.
  classification String @map("classification")

  attempt PrecisionAttempt @relation(fields: [attemptId], references: [attemptId], onDelete: Cascade)

  @@id([attemptId, ply])
  @@map("precision_attempt_moves")
  @@index([classification])
}

/// KS-3408 / ADR-086 §6. Сессия «угадай ход»: пользователь угадывает
/// ходы одной стороны в конкретной партии; ход сравнивается с реально
/// сыгранным по win-probability (см. `compareGuessMove` в shared).
/// `userId` — поле без FK-relation (как PuzzleRushScore).
model GuessSession {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  /// Источник партии: 'archive' | 'pgn' | 'own' (M2) | 'broadcast' (M2).
  gameSource String  @map("game_source")
  /// archive gameId / иной ref; NULL для inline PGN.
  gameRef    String? @map("game_ref")
  /// Inline PGN (source='pgn') или snapshot партии.
  pgn        String? @db.Text
  /// 'white' | 'black' — за кого угадывает пользователь.
  side       String
  /// 'active' | 'finished' | 'abandoned'.
  status     String  @default("active")
  /// precision-композит по ходам пользователя [0..100]; NULL до finish.
  userAccuracy   Float? @map("user_accuracy")
  /// Та же accuracy по реально сыгранным ходам игрока; NULL до finish.
  playerAccuracy Float? @map("player_accuracy")
  /// Звёзды 1..5 по userAccuracy; NULL до finish.
  userStars      Int?   @map("user_stars")
  score                 Int @default(0)
  bestStreak            Int @default(0) @map("best_streak")
  betterThanPlayerCount Int @default(0) @map("better_than_player_count")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  moves GuessMove[]

  @@index([userId, finishedAt])
  @@map("guess_sessions")
}

/// KS-3408 / ADR-086 §6. Per-move детали сессии (для review/истории и
/// будущего лидерборда). Образец — precision_attempt_moves: составной
/// PK [sessionId, ply], cascade-delete с сессией. Метрики — серверный
/// пересчёт из присланных клиентом WDL (server-trust, ADR-086 §8).
model GuessMove {
  sessionId String @map("session_id") @db.Uuid
  /// 1-based ply угадываемого полухода в партии.
  ply       Int
  fenBefore String @map("fen_before")
  /// Реально сыгранный в партии ход (UCI).
  playedUci String @map("played_uci")
  /// Ход пользователя (UCI); == playedUci если угадал точно.
  userUci   String @map("user_uci")
  /// PV1 движка на fenBefore (UCI).
  bestUci   String @map("best_uci")
  /// win-probability выбранной стороны: до / после реального / после user.
  eBefore      Float @map("e_before")
  eAfterPlayed Float @map("e_after_played")
  eAfterUser   Float @map("e_after_user")
  /// loss = max(0, eBefore − eAfter*).
  lossPlayer   Float @map("loss_player")
  lossUser     Float @map("loss_user")
  /// accuracy% (Lichess-формула) — денормализовано для review без пересчёта.
  accuracyPlayer Float @map("accuracy_player")
  accuracyUser   Float @map("accuracy_user")
  /// 'best' | 'good' | 'inaccuracy' | 'mistake' | 'blunder' (classifyMove).
  userClass String @map("user_class")
  /// 'strongest' | 'betterThanPlayer' | 'asPlayer' | 'weaker' (§3.5).
  verdict   String
  createdAt DateTime @default(now()) @map("created_at")

  session GuessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, ply])
  @@map("guess_moves")
  @@index([verdict])
}

/// KS-3440 / ADR-088 §10. Blind-board сессия: 5 фигур (Q/R/N/B/B) на
/// пустой доске, игрок не видит позицию, угадывает «вовлечённую»
/// фигуру по ходу компьютера. Позиция держится ТОЛЬКО на сервере
/// (анти-чит §5). user_id — без FK (как guess_sessions); гость = NULL
/// (М1 решение в B2 — JwtAuthGuard, но колонка nullable на будущее).
model BlindBoardSession {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String? @map("user_id") @db.Uuid
  /// Стартовая расстановка JSON: [{square, type}, ...] (5 элементов).
  startPosition   Json    @map("start_position")
  /// Текущая позиция JSON; меняется после каждого хода компа.
  currentPosition Json    @map("current_position")
  /// Фигура, которой комп ходит СЛЕДУЮЩИМ ходом (или NULL если
  /// сессия finished). JSON `{square, type}`.
  nextTargetPiece Json?   @map("next_target_piece")
  /// KS-3441. Текущий ход компа `{from, to}` — то, что клиент видит
  /// на доске сейчас и на что ждём ответ. NULL когда сессия finished.
  /// Хранится отдельно от nextTargetPiece (та станет target_piece
  /// для следующего хода после ответа игрока).
  currentCompMove Json?   @map("current_comp_move")
  /// KS-3485 (ADR-088 V2 §15). Прогрессивная сложность.
  /// `level` — текущий уровень сессии, начинается с 1, увеличивается на
  /// каждый level-up (streak % 10 === 0 + есть следующая фигура в
  /// `startConfig.addOrder`). Для лидерборда maxLevel вычисляется как
  /// `floor(bestStreak / 10) + 1` (derive, не хранится отдельно).
  level           Int     @default(1)
  /// KS-3485. Snapshot конфига `BlindBoardConfig` на момент старта
  /// сессии: `{ startPieces, addOrder, memorizeTimeSec }`. Тренировка
  /// идёт по этой расстановке/очереди добавления, даже если default
  /// поменяется в будущем — сессия играется в своём контексте.
  startConfig     Json    @map("start_config")
  streak          Int     @default(0)
  bestStreak      Int     @default(0) @map("best_streak")
  /// 'active' | 'finished' (см. BlindBoardSessionStatus в shared).
  status          String  @default("active")
  /// 'wrong-answer' | 'dead-end' | 'abandoned'; NULL пока active.
  finishReason    String? @map("finish_reason")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  attempts BlindBoardAttempt[]

  @@index([userId, finishedAt])
  @@map("blind_board_sessions")
}

/// KS-3440 / ADR-088 §10. Audit одного раунда blind-board: ход компа,
/// ожидаемый ответ, что ответил игрок, результат. Cascade-delete с
/// сессией. Per-round для review/анти-чит проверки.
model BlindBoardAttempt {
  id                String @id @default(uuid()) @db.Uuid
  sessionId         String @map("session_id") @db.Uuid
  /// 1-based номер раунда в сессии.
  round             Int
  /// Координаты хода компа: например 'e4' → 'h7'.
  compMoveFrom      String @map("comp_move_from")
  compMoveTo        String @map("comp_move_to")
  /// Что должен был ответить игрок (вовлечённая фигура).
  expectedSquare    String @map("expected_square")
  /// 'Q' | 'R' | 'B' | 'N'.
  expectedPieceType String @map("expected_piece_type")
  /// Ответ игрока; NULL если ответ ещё не пришёл (для частичной записи).
  userSquare        String? @map("user_square")
  userPieceType     String? @map("user_piece_type")
  /// Совпал ли ответ игрока с expected.
  correct           Boolean
  createdAt         DateTime @default(now()) @map("created_at")

  session BlindBoardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, round])
  @@map("blind_board_attempts")
}

model PuzzleRushScore {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  timeMode  String   @map("time_mode")
  createdAt DateTime @default(now()) @map("created_at")

  user           User                      @relation(fields: [userId], references: [id])
  sessionPuzzles PuzzleRushSessionPuzzle[]

  @@index([userId])
  @@index([score])
  @@index([timeMode, score])
  @@index([userId, timeMode])
  @@map("puzzle_rush_scores")
}

model PuzzleRushSessionPuzzle {
  id       String  @id @default(uuid()) @db.Uuid
  scoreId  String  @map("score_id") @db.Uuid
  puzzleId String  @map("puzzle_id")
  solved   Boolean
  position Int

  score  PuzzleRushScore @relation(fields: [scoreId], references: [id])
  // KS-2675: Cascade — без пазла session-ссылка не имеет смысла.
  puzzle Puzzle          @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@map("puzzle_rush_session_puzzles")
}

model DailyPuzzle {
  id        String   @id @default(uuid()) @db.Uuid
  puzzleId  String   @map("puzzle_id")
  date      DateTime @unique @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  // KS-2675: Cascade — daily-привязка пропадает вместе с пазлом.
  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@map("daily_puzzles")
}

model Analysis {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  title           String
  headline        String?
  pgn             String? @db.Text
  fen             String?
  opening         String?
  event           String?
  site            String?
  pgnDate         String? @map("pgn_date")
  round           String?
  white           String?
  black           String?
  whiteElo        String? @map("white_elo")
  blackElo        String? @map("black_elo")
  result          String?
  category        String  @default("analysis")
  tags            String  @default("")
  currentPosition Int?    @map("current_position")
  /// KS-3045. Ориентация доски, сохранённая автором (white|black).
  /// `null` означает «не задано» — фронт использует свой дефолт.
  /// Хранится per-user-per-analysis, синхронизируется между устройствами
  /// (поправка к KS-3044, где было через localStorage).
  boardOrientation BoardOrientation? @map("board_orientation")
  /// KS-2600 (ADR-051 §3, share-1). Флаг публичности анализа.
  /// Если `true` — запись доступна по `GET /analyses/public/:id`
  /// без авторизации (см. share-2). Toggle делает автор через
  /// `PATCH /analyses/:id/share` (см. share-3). По умолчанию `false`
  /// — все существующие записи остаются приватными после миграции.
  isPublic        Boolean @default(false) @map("is_public")

  /// KS-3261. Детерминированный ключ источника партии — для дедупа
  /// при повторном открытии «В мастерской» из Архива/Трансляции.
  /// Приоритет вычисления (см. `computeSourceHash`):
  ///   1. `lichess:<lichessGameId>` — для Lichess broadcast'ов.
  ///   2. `archive:<archiveGameId>` — для наших archive_games.
  ///   3. `pgn:<sha256(lower(white)|lower(black)|date|event|round)>` —
  ///      fallback по PGN-headers.
  /// `null` если headers неполные (нет хотя бы одного из white/black/date)
  /// — такие анализы НЕ дедуплицируются (safer, лучше дубль чем потерянная
  /// работа).
  sourceHash      String? @map("source_hash")
  /// KS-3261. Прямые ссылки на исходник партии — для bulk-check архив-
  /// карточек («уже в мастерской»). Дублируют информацию из sourceHash
  /// (lichess_game_id содержится в "lichess:..." варианте), но даны
  /// отдельными колонками с индексами для O(1) lookup'а по конкретному
  /// id вместо парсинга hash-prefix'а.
  lichessGameId   String? @map("lichess_game_id")
  archiveGameId   String? @map("archive_game_id") @db.Uuid
  /// KS-3460 / ADR-089 §6.3. Soft-ссылка на guess-сессию, из которой
  /// был сгенерирован этот анализ через POST /guess/sessions/:id/to-analysis.
  /// Без FK — guess-сессии могут удаляться. UNIQUE с user_id даёт
  /// идемпотентность endpoint'а (повторный клик возвращает existing).
  /// NULL для всех анализов, не созданных из guess-flow.
  guessSessionId  String? @map("guess_session_id") @db.Uuid
  /// KS-3602 / ADR-100 §8.2. Soft-ссылка на оригинал для авто-
  /// аннотированных дубликатов («Разобрать партию» через Stockfish+Maia).
  /// NULL для оригиналов и независимо созданных анализов.
  /// Без FK — оригинал может быть удалён пользователем, дубль остаётся
  /// висячим (фронт обрабатывает 410 на регенерацию). Идемпотентность
  /// duplicate-annotated endpoint'а — через findFirst+update/create
  /// (UNIQUE индекс не ставим: §«Не делать», избегаем 409 на race).
  originalAnalysisId String? @map("original_analysis_id") @db.Uuid
  /// KS-3261. LRU-сортировка списка «Мои анализы». Обновляется на каждое
  /// «открытие» (создание нового / повторный POST /analyses, который
  /// возвращает existing). Default = createdAt для бэкфила legacy-записей.
  lastOpenedAt    DateTime @default(now()) @map("last_opened_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  // KS-3757 / ADR-112: обратная связь к live-трансляциям, привязанным
  // к этому анализу. При удалении анализа в `LiveAnalysis.analysisId`
  // ставится NULL (см. relation там, `onDelete: SetNull`) — трансляции
  // не удаляются ради аудита, просто теряют binding.
  liveAnalyses LiveAnalysis[]

  /// KS-4026 / ADR-122. Кеш позиционных метрик SF-trace по полуходам
  /// анализа. Одна запись на анализ (UNIQUE по analysisId на стороне
  /// AnalysisPositionalTrace). Cascade-delete: при удалении анализа
  /// запись исчезает. Привязка именно к Analysis, потому что реальный
  /// поток пользователя — `openAnalysisFromPgn` создаёт новый Analysis
  /// под архивную партию (см. KS-4026 переезд с gameId на analysisId).
  positionalTrace AnalysisPositionalTrace?

  @@index([userId])
  @@index([userId, createdAt])
  /// KS-3261. LRU-сортировка в findAll.
  @@index([userId, lastOpenedAt(sort: Desc)])
  /// KS-3261. Bulk-check архив-карточек: «WHERE user_id=X AND
  /// lichess_game_id IN (...)» — попадает в индекс.
  @@index([userId, lichessGameId])
  @@index([userId, archiveGameId])
  /// KS-3261. Partial-unique индекс: один user × один source = один
  /// анализ. NULL source_hash повторяется (legacy и записи без source).
  @@unique([userId, sourceHash], map: "analyses_user_source_uniq")
  /// KS-3460 / ADR-089 §6.3. Идемпотентность guess→analysis: один user ×
  /// одна guess-сессия = один анализ. NULL повторяется (legacy и обычные
  /// анализы не из guess-flow).
  @@unique([userId, guessSessionId], map: "analyses_user_guess_session_uniq")
  /// KS-3602 / ADR-100 §8.2. Поиск дубля для duplicate-annotated
  /// endpoint'а (findFirst по userId+originalAnalysisId).
  @@index([userId, originalAnalysisId])
  @@map("analyses")
}

/// KS-3045. Ориентация доски в анализе.
