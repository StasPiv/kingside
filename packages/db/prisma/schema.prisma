generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid()) @db.Uuid
  username              String?  @unique
  requiresUsernameSetup Boolean  @default(false) @map("requires_username_setup")
  email                 String?  @unique
  passwordHash          String?  @map("password_hash")
  oauthProvider         String?  @map("oauth_provider")
  oauthProviderId       String?  @map("oauth_provider_id")
  telegramId            String?  @unique @map("telegram_id")
  ratingBullet          Int      @default(1500) @map("rating_bullet")
  ratingBlitz           Int      @default(1500) @map("rating_blitz")
  ratingRapid           Int      @default(1500) @map("rating_rapid")
  ratingClassical       Int      @default(1500) @map("rating_classical")
  ratingPuzzle          Int      @default(1500) @map("rating_puzzle")
  /// KS-2311 (methodology §10.4): drill rating (Glicko-1) и его RD.
  /// Cold-start 1500 / 350. Только drill mode обновляет; sprint — нет.
  ratingDrill           Int      @default(1500) @map("rating_drill")
  ratingDrillDev        Int      @default(350)  @map("rating_drill_dev")
  ratingPuzzleDev       Int      @default(350) @map("rating_puzzle_dev")
  puzzleStreak          Int      @default(0) @map("puzzle_streak")
  gamesPlayedBullet     Int      @default(0) @map("games_played_bullet")
  gamesPlayedBlitz      Int      @default(0) @map("games_played_blitz")
  gamesPlayedRapid      Int      @default(0) @map("games_played_rapid")
  gamesPlayedClassical  Int      @default(0) @map("games_played_classical")
  createdAt             DateTime @default(now()) @map("created_at")
  lastSeenAt            DateTime @default(now()) @map("last_seen_at")
  locale                String   @default("en") @map("locale")
  boardTheme            String   @default("default") @map("board_theme")
  pieceSet              String   @default("standard") @map("piece_set")
  soundEnabled          Boolean  @default(true) @map("sound_enabled")
  isBot                 Boolean  @default(false) @map("is_bot")
  /// KS-2160 (ADR-034 §2.1). Synthetic-user — отдельная категория от `isBot`:
  /// - `isBot=true`  — старая legacy-роль 30s matchmaking fallback (12 fixed UUID-ов
  ///   из `MATCHMAKING_BOTS`); готовится к выводу в KS-2161+.
  /// - `isSynthetic=true` — новая категория эмулированных пользователей с
  ///   полноценной игрой через Stockfish-pool, профили, presence (KS-2161+).
  /// На время миграции возможны записи c обоими флагами; data-migration
  /// `20260430120000_add_synthetic_fields` переводит 12 legacy-ботов в
  /// `isBot=false, isSynthetic=true` (см. KS-2160 §3).
  isSynthetic           Boolean  @default(false) @map("is_synthetic")
  /// KS-2255 (ADR-036 §3, screenshot tooling E1). Признак seed-аккаунта,
  /// созданного для генерации скриншотов. Используется фильтрацией
  /// в публичных endpoint'ах (KS-2256) — не светим эти аккаунты в
  /// общих списках/чартах. Пишет только seed-скрипт screenshot tooling.
  isTestAccount         Boolean  @default(false) @map("is_test_account")
  /// KS-2255 (ADR-036 §3, screenshot tooling E1). Универсальный флаг
  /// «скрыт из публичных выдач» (модерация / временная блокировка /
  /// служебные аккаунты). Совместно с `isTestAccount` фильтруется в
  /// KS-2256.
  isHidden              Boolean  @default(false) @map("is_hidden")
  /// KS-2160. Двухбуквенный ISO-3166-1 alpha-2 (RU, US, IN, BR…). Используется
  /// в профиле пользователя для отображения флага. Nullable — реальные
  /// пользователи могут не указывать страну. Для synthetic-ов обязателен,
  /// проставляется генератором профиля (KS-2162).
  country               String?  @db.Char(2)
  chesscomUsername      String?  @map("chesscom_username")
  lichessUsername       String?  @map("lichess_username")
  /// KS-2210: JSON-объект с сохранёнными фильтрами архивного поиска.
  /// Nullable — для пользователей, не выставлявших фильтры.
  archiveFilters        Json?    @map("archive_filters")

  whiteGames             Game[]                   @relation("WhitePlayer")
  blackGames             Game[]                   @relation("BlackPlayer")
  chatMessages           ChatMessage[]
  timeControls           UserTimeControl[]
  puzzleAttempts         PuzzleAttempt[]
  puzzleRushScores       PuzzleRushScore[]
  gameAnalyses           GameAnalysis[]
  analyses               Analysis[]
  savedFilters           SavedFilter[]
  pgnImports             PgnImport[]
  sentMessages           DirectMessage[]          @relation("SentMessages")
  receivedMessages       DirectMessage[]          @relation("ReceivedMessages")
  sentFriendships        Friendship[]             @relation("FriendshipRequester")
  receivedFriendships    Friendship[]             @relation("FriendshipAddressee")
  blockedUsers           BlockedUser[]            @relation("Blocker")
  blockedByUsers         BlockedUser[]            @relation("Blocked")
  ratingHistory          RatingHistory[]
  arenaEntries           ArenaTournamentEntry[]
  notifications          Notification[]
  puzzleRatingSnapshots  PuzzleRatingSnapshot[]
  chatConversations      ChatConversation[]
  feedback               Feedback[]
  feedbackComments       FeedbackComment[]
  courseProgress         UserCourseProgress[]
  lessonProgress         UserLessonProgress[]
  lessonReviews          LessonReview[]
  mistakes               UserMistake[]
  userCourses            UserCourse[]
  userCoursePlayProgress UserCoursePlayProgress[]
  userLessonPlayProgress UserLessonPlayProgress[]
  // KS-2226 (ADR-035 §4): Drills attempt'ы и sprint-скоры юзера.
  tacticDrillAttempts    TacticDrillAttempt[]
  tacticDrillSprintScores TacticDrillSprintScore[]
  // KS-2373: статистика посещений разделов для динамического
  // MobileBottomBar (top-3 разделы → нижняя панель, остальные в «Ещё»).
  navStats               UserNavStat[]

  @@unique([oauthProvider, oauthProviderId])
  /// KS-2160. Partial-индекс по synthetic-флагу. На реальных пользователях
  /// (~99% выборки) `is_synthetic=false`, поэтому полный индекс — почти
  /// весь sequential scan. Postgres `@@index` без `where` всё равно
  /// быстрее scan'а (особенно для scheduler'а из KS-2164, который делает
  /// `findMany WHERE is_synthetic=true LIMIT N`).
  @@index([isSynthetic])
  @@map("users")
}

enum GameStatus {
  waiting
  active
  finished
  aborted
}

enum GameResult {
  white
  black
  draw
}

enum Termination {
  checkmate
  resignation
  timeout
  draw_agreement
  stalemate
  insufficient
  repetition
  fifty_moves
  abort
  abandon
}

enum TimeControlType {
  bullet
  blitz
  rapid
  classical
}

model Game {
  id                String          @id @default(uuid()) @db.Uuid
  whiteId           String          @map("white_id") @db.Uuid
  blackId           String          @map("black_id") @db.Uuid
  status            GameStatus      @default(waiting)
  result            GameResult?
  termination       Termination?
  timeControlType   TimeControlType @map("time_control_type")
  timeInitialSec    Int             @map("time_initial_sec")
  timeIncrementSec  Int             @map("time_increment_sec")
  pgn               String?
  eco               String?
  finalFen          String?         @map("final_fen")
  whiteRatingBefore Int?            @map("white_rating_before")
  blackRatingBefore Int?            @map("black_rating_before")
  whiteRatingAfter  Int?            @map("white_rating_after")
  blackRatingAfter  Int?            @map("black_rating_after")
  whiteBerserk      Boolean         @default(false) @map("white_berserk")
  blackBerserk      Boolean         @default(false) @map("black_berserk")
  isBot             Boolean         @default(false) @map("is_bot")
  botLevel          Int?            @map("bot_level")
  botClientSide     Boolean         @default(false) @map("bot_client_side")
  /// KS-2160 (ADR-034 §2.1). Маркер «одна из сторон — synthetic-user».
  /// Используется для аудита, фильтров в админке и будущих use-cases.
  /// **Не используется для исключения из публичных чартов** — KS-2167
  /// отменена, synthetic = полноценный пользователь и виден в публичных
  /// листингах как обычный.
  isSyntheticOpponent Boolean       @default(false) @map("is_synthetic_opponent")
  /// KS-2160. Имя «фонового» соперника для отображения в истории партий
  /// — на случай если в будущем мы захотим показать имя без создания
  /// `User`-записи (Q4 ADR-034). Пока nullable и не используется
  /// (текущее решение — реальный User-record для каждого synthetic).
  opponentNameSynthetic String?     @map("opponent_name_synthetic")
  createdAt         DateTime        @default(now()) @map("created_at")
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  tournamentId      String?         @map("tournament_id") @db.Uuid

  white        User             @relation("WhitePlayer", fields: [whiteId], references: [id])
  black        User             @relation("BlackPlayer", fields: [blackId], references: [id])
  moves        Move[]
  chatMessages ChatMessage[]
  analyses     GameAnalysis[]
  report       GameReport?
  tournament   ArenaTournament? @relation(fields: [tournamentId], references: [id])
  mistakes     UserMistake[]

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
  @@index([createdAt])
  @@index([isBot, status])
  /// KS-2160. Индекс по `is_synthetic_opponent` НЕ создан — KS-2167
  /// (исключение synthetic из публичных чартов) отменена, и без её
  /// SELECT'ов селективного use-case у индекса не остаётся. Поле
  /// сохранено как маркер для аудита/админки.
  @@index([tournamentId])
  @@map("games")
}

enum PieceColor {
  white
  black
}

model Move {
  id         String     @id @default(uuid()) @db.Uuid
  gameId     String     @map("game_id") @db.Uuid
  moveNumber Int        @map("move_number")
  color      PieceColor
  uci        String
  san        String
  fenAfter   String     @map("fen_after")
  timeLeftMs Int        @map("time_left_ms")
  createdAt  DateTime   @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId, moveNumber])
  @@map("moves")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([gameId])
  @@map("chat_messages")
}

model UserTimeControl {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String?
  initialSec   Int      @map("initial_sec")
  incrementSec Int      @map("increment_sec")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_time_controls")
}

model Puzzle {
  id         String   @id
  fen        String
  moves      String
  rating     Int      @default(1500)
  ratingDev  Int      @default(350) @map("rating_dev")
  popularity Int      @default(0)
  nbPlays    Int      @default(0) @map("nb_plays")
  themes     String   @default("")
  source     String   @default("lichess")
  createdAt  DateTime @default(now()) @map("created_at")

  // Lichess-specific (nullable for generated)
  gameUrl     String? @map("game_url")
  openingTags String? @map("opening_tags")

  // Generated-specific (nullable for lichess)
  sourceType     String? @map("source_type")
  sourceId       String? @map("source_id")
  sourceMoveNum  Int?    @map("source_move_num")
  gap            Int?
  depth          Int?
  createdBy      String? @map("created_by") @db.Uuid
  isPublic       Boolean @default(true) @map("is_public")
  sourceMetadata String? @map("source_metadata") @db.Text
  acceptedMoves  String? @map("accepted_moves")

  // KS-2463 / ADR-044 §3.2. Режим решения пазла:
  //   - 'forced-line' — классический пазл с фиксированной линией;
  //   - 'play-vs-engine' — открытая защита (решатель играет против
  //     движка, удерживая WDL ≥ порога). Старые пазлы получают
  //     'forced-line' через DEFAULT.
  solutionMode String @default("forced-line") @map("solution_mode")

  attempts           PuzzleAttempt[]
  dailyPuzzles       DailyPuzzle[]
  rushSessionPuzzles PuzzleRushSessionPuzzle[]
  mistakes           UserMistake[]

  @@index([rating])
  @@index([themes])
  @@index([source])
  @@index([createdBy])
  @@index([solutionMode])
  // KS-2557: ORDER BY created_at DESC LIMIT 20 для /puzzles/browse —
  // на 6M lichess строк без индекса делал full scan + sort.
  @@index([createdAt])
  @@map("puzzles")
}

model PuzzleAttempt {
  id                 String   @id @default(uuid()) @db.Uuid
  puzzleId           String   @map("puzzle_id")
  userId             String   @map("user_id") @db.Uuid
  solved             Boolean
  timeMs             Int      @map("time_ms")
  ratingBefore       Int      @map("rating_before")
  ratingAfter        Int      @map("rating_after")
  puzzleRatingBefore Int?     @map("puzzle_rating_before")
  puzzleRatingAfter  Int?     @map("puzzle_rating_after")
  userMoves          String?  @map("user_moves")
  hintsUsed          Int      @default(0) @map("hints_used")
  createdAt          DateTime @default(now()) @map("created_at")

  puzzle Puzzle @relation(fields: [puzzleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([puzzleId])
  @@index([userId, createdAt])
  @@index([userId, puzzleId, solved])
  @@map("puzzle_attempts")
}

model PuzzleRushScore {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  timeMode  String   @map("time_mode")
  createdAt DateTime @default(now()) @map("created_at")

  user           User                      @relation(fields: [userId], references: [id])
  sessionPuzzles PuzzleRushSessionPuzzle[]

  @@index([userId])
  @@index([score])
  @@index([timeMode, score])
  @@index([userId, timeMode])
  @@map("puzzle_rush_scores")
}

model PuzzleRushSessionPuzzle {
  id       String  @id @default(uuid()) @db.Uuid
  scoreId  String  @map("score_id") @db.Uuid
  puzzleId String  @map("puzzle_id")
  solved   Boolean
  position Int

  score  PuzzleRushScore @relation(fields: [scoreId], references: [id])
  puzzle Puzzle          @relation(fields: [puzzleId], references: [id])

  @@index([scoreId])
  @@map("puzzle_rush_session_puzzles")
}

model DailyPuzzle {
  id        String   @id @default(uuid()) @db.Uuid
  puzzleId  String   @map("puzzle_id")
  date      DateTime @unique @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  puzzle Puzzle @relation(fields: [puzzleId], references: [id])

  @@map("daily_puzzles")
}

model Analysis {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  title           String
  headline        String?
  pgn             String? @db.Text
  fen             String?
  opening         String?
  event           String?
  site            String?
  pgnDate         String? @map("pgn_date")
  round           String?
  white           String?
  black           String?
  whiteElo        String? @map("white_elo")
  blackElo        String? @map("black_elo")
  result          String?
  category        String  @default("analysis")
  tags            String  @default("")
  currentPosition Int?    @map("current_position")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@map("analyses")
}

model SavedFilter {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  name      String
  category  String?
  tags      String?
  search    String?
  sortOrder String? @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("saved_filters")
}

model PgnImport {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  user  User            @relation(fields: [userId], references: [id])
  games PgnImportGame[]

  @@index([userId])
  @@map("pgn_imports")
}

model PgnImportGame {
  id       String  @id @default(uuid()) @db.Uuid
  importId String  @map("import_id") @db.Uuid
  pgn      String  @db.Text
  white    String?
  black    String?
  result   String?
  date     String?
  opening  String?
  position Int

  import PgnImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("pgn_import_games")
}

model GameAnalysis {
  id          String   @id @default(uuid()) @db.Uuid
  gameId      String   @map("game_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  analysisPgn String   @map("analysis_pgn") @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@map("game_analyses")
}

/// Дневник ошибок пользователя (L-31, KS-1802).
///
/// Единая таблица агрегирует неудачные попытки из двух доменов:
///  - `source = 'puzzle'`      — при неправильной попытке в `PuzzleAttempt`
///    (hook из `PuzzleService.submitAttempt`). Идемпотентность: на один
///    `(userId, puzzleId)` допускается максимум одна запись — при повторной
///    неудаче обновляется только `occurredAt`. Это чтобы ретраи по одной и
///    той же задаче не искажали агрегаты по темам.
///  - `source = 'game_review'` — ошибка в анализе партии (ход классифицирован
///    как `mistake` / `blunder`, `ply` — номер полухода). Идемпотентность:
///    `(userId, gameId, ply)`.
///
/// `themes` — массив тем (строки из `Puzzle.themes` и/или разбора партии).
/// Хранится как Postgres `TEXT[]` для эффективной группировки через
/// `UNNEST` в агрегирующих запросах.
///
/// Partial-уникальные индексы (см. миграцию) удобнее реализовать в SQL,
/// Prisma `@@unique` не умеет `WHERE`-фильтры. В Prisma-уровне даём обычные
/// индексы + уникальность обеспечиваем в `MistakesService`.
model UserMistake {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  source     String // 'puzzle' | 'game_review' — см. UserMistakeSource в shared
  puzzleId   String?  @map("puzzle_id")
  gameId     String?  @map("game_id") @db.Uuid
  ply        Int?
  themes     String[] @default([])
  occurredAt DateTime @default(now()) @map("occurred_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle Puzzle? @relation(fields: [puzzleId], references: [id])
  game   Game?   @relation(fields: [gameId], references: [id])

  @@index([userId, occurredAt])
  @@index([userId, source])
  @@map("user_mistakes")
}

model GameReport {
  id            String   @id @default(uuid()) @db.Uuid
  gameId        String   @unique @map("game_id") @db.Uuid
  depth         Int      @default(18)
  whiteAccuracy Float    @map("white_accuracy")
  blackAccuracy Float    @map("black_accuracy")
  moves         String   @db.Text // JSON array of MoveAnalysis
  status        String   @default("pending") // pending, analyzing, complete, error
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId])
  @@map("game_reports")
}

// Broadcast/BroadcastRound/BroadcastGame модели перенесены в
// packages/broadcasts-db (ADR-021 §2.1, KS-1697). Таблицы broadcasts,
// broadcast_rounds, broadcast_games удалены из main БД через миграцию
// 20260422_drop_broadcast_tables. Источник истины для broadcasts —
// отдельный сервис apps/broadcast-service + БД broadcasts_kingside.

model DirectMessage {
  id         String    @id @default(uuid()) @db.Uuid
  senderId   String    @map("sender_id") @db.Uuid
  receiverId String    @map("receiver_id") @db.Uuid
  text       String
  createdAt  DateTime  @default(now()) @map("created_at")
  readAt     DateTime? @map("read_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@map("direct_messages")
}

model LiveTournament {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  chessResultsId  String   @unique @map("chess_results_id")
  chessResultsUrl String   @map("chess_results_url")
  livechessUuid   String   @map("livechess_uuid")
  status          String   @default("unknown")
  description     String?
  location        String?
  timeControl     String?  @map("time_control")
  playerCount     Int?     @map("player_count")
  startDate       String?  @map("start_date")
  endDate         String?  @map("end_date")
  totalRounds     Int?     @map("total_rounds")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([livechessUuid])
  @@map("live_tournaments")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model BlockedUser {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

model RatingHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  category  String // bullet, blitz, rapid, classical
  rating    Int
  gameId    String?  @map("game_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, category, createdAt])
  @@map("rating_history")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String // challenge_received, friend_request, game_started, message
  payload   String   @db.Text // JSON
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model PuzzleRatingSnapshot {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  rating   Int
  date     DateTime @db.Date
  attempts Int      @default(0)
  solved   Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@map("puzzle_rating_snapshots")
}

model ArenaTournament {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  createdBy        String   @map("created_by") @db.Uuid
  type             String   @default("arena") // arena, swiss, round_robin
  status           String   @default("upcoming") // upcoming, active, finished
  timeControlType  String   @map("time_control_type") // bullet, blitz, rapid
  timeInitialSec   Int      @map("time_initial_sec")
  timeIncrementSec Int      @map("time_increment_sec")
  durationMin      Int      @map("duration_min") // arena: 30-180
  totalRounds      Int?     @map("total_rounds") // swiss/rr
  cycles           Int      @default(1) // round-robin: number of circles
  roundPauseMin    Int?     @map("round_pause_min") // minutes between rounds
  maxPlayers       Int?     @map("max_players")
  pointsWin        Float    @default(1) @map("points_win")
  pointsDraw       Float    @default(0.5) @map("points_draw")
  pointsLoss       Float    @default(0) @map("points_loss")
  currentRound     Int      @default(0) @map("current_round")
  startsAt         DateTime @map("starts_at")
  finishesAt       DateTime @map("finishes_at")
  visibility       String   @default("public") // public, unlisted, private
  inviteCode       String?  @unique @map("invite_code")
  createdAt        DateTime @default(now()) @map("created_at")

  entries ArenaTournamentEntry[]
  games   Game[]
  rounds  TournamentRound[]
  invites TournamentInvite[]

  @@index([status])
  @@index([startsAt])
  @@map("arena_tournaments")
}

model TournamentInvite {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @map("tournament_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  invitedBy    String   @map("invited_by") @db.Uuid
  status       String   @default("pending") // pending, accepted, declined
  createdAt    DateTime @default(now()) @map("created_at")

  tournament ArenaTournament @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, userId])
  @@map("tournament_invites")
}

model ArenaTournamentEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tournamentId String   @map("tournament_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  score        Float    @default(0)
  wins         Int      @default(0)
  draws        Int      @default(0)
  losses       Int      @default(0)
  streak       Int      @default(0)
  withdrawn    Boolean  @default(false)
  joinedAt     DateTime @default(now()) @map("joined_at")

  tournament ArenaTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([tournamentId, score])
  @@map("arena_tournament_entries")
}

model TournamentRound {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @map("tournament_id") @db.Uuid
  roundNumber  Int       @map("round_number")
  status       String    @default("pending") // pending, active, finished
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  tournament ArenaTournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pairings   TournamentPairing[]

  @@unique([tournamentId, roundNumber])
  @@map("tournament_rounds")
}

model TournamentPairing {
  id      String  @id @default(uuid()) @db.Uuid
  roundId String  @map("round_id") @db.Uuid
  whiteId String  @map("white_id") @db.Uuid
  blackId String? @map("black_id") @db.Uuid // null = bye
  gameId  String? @map("game_id") @db.Uuid
  result  String? // 1-0, 0-1, 1/2-1/2, bye
  board   Int     @default(1)

  round TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@map("tournament_pairings")
}

model ChatConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User                   @relation(fields: [userId], references: [id])
  messages ChatAssistantMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatAssistantMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String // user, assistant, system
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_assistant_messages")
}

model Feedback {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  email        String?
  title        String?
  type         String // bug, suggestion, question
  message      String   @db.Text
  page         String?
  userAgent    String?  @map("user_agent")
  status       String   @default("new") // new, read, resolved
  isPublic     Boolean  @default(true) @map("is_public")
  voteCount    Int      @default(0) @map("vote_count")
  upCount      Int      @default(0) @map("up_count")
  downCount    Int      @default(0) @map("down_count")
  commentCount Int      @default(0) @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user     User?             @relation(fields: [userId], references: [id])
  comments FeedbackComment[]
