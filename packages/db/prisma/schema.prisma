  // KS-2925 / Phase A1. `section` — дискриминатор секции (workshop|archive).
  // CHECK на доменное множество висит на уровне БД (см. миграцию
  // 20260513090000_ks2925_saved_filters_section_params). `params` — JSONB,
  // форма соответствует SavedFilterParams из @kingside/shared (KS-2928).
  // KS-2943 (Phase D1): плоские колонки category/tags/search/sortOrder
  // удалены — фронт переехал на `/api/user/saved-filters`, данные
  // целиком живут в `params`.
  section   String  @default("workshop")
  params    Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt        @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, section, createdAt(sort: Desc)], map: "saved_filters_user_section_idx")
