// ─── Lessons module (ADR-024, KS-1756/KS-1757/KS-1758) ───────────────
// Источник истины shape: packages/shared/src/types/lessons.ts
// Политика payload: JSONB + дискриминированный union в shared + API DTO
// class-validator + seed-линтер (см. ADR-024 §2.2).

model Course {
  id               String   @id @default(uuid()) @db.Uuid
  /// KS-2639 / ADR-054 §3.2 Phase A. Владелец пользовательского курса.
  /// `NULL` — системный курс (как и было до миграции). UUID — авторский
  /// курс пользователя. FK на User c onDelete Cascade: удаление автора
  /// сносит его курсы (и каскадом — уроки/шаги/прогресс).
  ownerId          String?  @map("owner_id") @db.Uuid
  slug             String
  /// KS-2095: язык контента курса. У одного `parentCourseId` максимум
  /// один курс на каждый lang. Root-курсы (parentCourseId=NULL) имеют
  /// один lang каждый; через `parentCourseId` к ним привязываются
  /// языковые варианты (`Course.parent` ↔ `Course.translations`).
  lang             String   @default("ru")
  /// KS-2095: ссылка на «канонический» курс — обычно root (RU). Для
  /// root равен NULL. Используется фильтрами /api/lessons/courses?lang=
  /// и нормализацией прогресса (UserCourseProgress.courseId всегда
  /// хранится как root id).
  parentCourseId   String?  @map("parent_course_id") @db.Uuid
  /// KS-2640 / ADR-054 §4 Phase B. NULLable: пользовательские курсы не
  /// имеют формального уровня сложности и i18n-ключей — это поля
  /// исключительно системных. У существующих системных записей значения
  /// сохраняются (миграция `DROP NOT NULL` без переписи).
  level            String?  // "beginner" | "intermediate" | "advanced" — только для системных
  titleKey         String?  @map("title_key")
  descriptionKey   String?  @map("description_key")
  // KS-1964: inline-поля admin API. Имеют приоритет над i18n-ключами;
  // если null — UI/сервис берёт `*Key` как fallback (см. B-3/B-4).
  title            String?
  description      String?
  audience         String?
  hook             String?
  outcome          String?
  coverUrl         String?  @map("cover_url")
  /// KS-2640 / ADR-054 §4 Phase B. NULLable для пользовательских.
  difficulty       Int?     // 1=easy, 2=medium, 3=hard — только для системных
  estimatedMinutes Int?     @map("estimated_minutes")
  audienceI18nKey  String?  @map("audience_i18n_key")
  hookI18nKey      String?  @map("hook_i18n_key")
  outcomeI18nKey   String?  @map("outcome_i18n_key")
  tags             String[] @default([])
  // KS-2037: упорядоченный список `blockKey` уроков курса
  // (`Lesson.blockKey`). Если пусто — порядок блоков на фронте по
  // умолчанию (алфавит/min(order)). Уроки с `blockKey`, отсутствующим
  // в `blockOrder`, фронт рендерит после известных. Это снимает
  // хардкод `BLOCK_ORDER` с фронта.
  blockOrder       String[] @default([]) @map("block_order")
  order            Int      @default(0)
  isPublished      Boolean  @default(false) @map("is_published")
  /// KS-2639 / ADR-054 §3.2 Phase A. Видимость пользовательского курса:
  /// FALSE — приватный (только владелец), TRUE — публичный.
  /// Семантически имеет смысл только при `ownerId IS NOT NULL`. Для
  /// системных курсов (ownerId IS NULL) поле обязано оставаться FALSE
  /// — эта инвариант пока не закреплён CHECK constraint'ом (будет в
  /// Phase E, см. §6 ADR), но enforced на уровне сервиса.
  isPublic         Boolean  @default(false) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// KS-2639 / ADR-054 §3.2 Phase A. Связь на владельца авторского
  /// курса. Для системных курсов — NULL.
  owner        User?     @relation("OwnedCourses", fields: [ownerId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  progress     UserCourseProgress[]
  /// KS-2095: self-relation для языковых вариантов.
  parent       Course?   @relation("CourseTranslations", fields: [parentCourseId], references: [id], onDelete: SetNull)
  translations Course[]  @relation("CourseTranslations")
  /// KS-3208 / ADR-074 §10 B4. Audit-журнал AI-генераций, в которых
  /// этот курс — результирующий (status='created'). Удаление курса
  /// зануляет `createdCourseId` в записи, но саму запись не удаляет.
  aiGenerations AiLessonGeneration[]

  /// KS-2639 / ADR-054 §3.2 Phase A. Slug-namespace по владельцу:
  /// уникальность `(slug, lang)` для системных и `(owner_id, slug)`
  /// для пользовательских реализована partial-unique индексами в SQL
  /// (Prisma 6.x не умеет partial-unique в schema). Старый
  /// `@@unique([slug, lang])` снят и заменён на partial-индекс
  /// `courses_slug_lang_system_uniq` с `WHERE owner_id IS NULL` —
  /// поведение для системных курсов идентично прежнему.
  /// KS-2095: один lang на parent. PostgreSQL UNIQUE с NULL trips каждый
  /// NULL distinct, поэтому root-курсы с одинаковым lang не конфликтуют —
  /// уникальность работает только когда parent_course_id IS NOT NULL.
  @@unique([parentCourseId, lang])
  @@index([level, order])
  @@index([isPublished])
  @@index([lang, isPublished])
  /// KS-2639 / ADR-054 §3.2 Phase A. Listing «свои курсы» сортируется
  /// по `updatedAt` — индекс покрывает запрос автора.
  @@index([ownerId, updatedAt])
  @@map("courses")
}

/// KS-3208 / ADR-074 §10 B4. Audit-журнал генераций курсов через AI-
/// ассистента. Каждый вызов tool'а `create_user_course` пишет строку
/// `pending` с исходным `planJson` (вход модели); после успешного
/// создания статус переключается на `created` и `createdCourseId` ←
/// id нового `Course`; при ошибке — `failed` + `error`.
///
/// Шкала состояний (хранится как String, без Prisma-enum — добавление
/// новых статусов не должно тянуть миграцию):
///   - `pending`  — заявка принята, курс ещё не создан.
///   - `created`  — `createdCourseId` указывает на готовый курс.
///   - `failed`   — `error` содержит причину; курс не создан.
model AiLessonGeneration {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  planJson        Json     @map("plan_json")
  status          String
  createdCourseId String?  @map("created_course_id") @db.Uuid
  error           String?
  /// KS-3226 / ADR-075 §7 B6. Audit-журнал всех tool-call'ов, сделанных
  /// Anthropic-сессией для этой генерации (включая
  /// create_user_lesson, create_user_lesson_step, add_puzzle_step_filter,
  /// add_game_step_from_analysis, add_tactical_drill_step, ...). Поле
  /// опциональное (исторические записи остаются NULL); заполняется
  /// webhook'ом / backend'ом постепенно. Shape: `Array<{ name, input,
  /// status: 'ok'|'error', output?, error?, ts }>`.
  toolCalls       Json?    @map("tool_calls")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// KS-3208: связь не cascade — удалять курс не должно сносить
  /// audit-запись. На уровне БД FK ON DELETE SET NULL.
  createdCourse Course? @relation(fields: [createdCourseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_lesson_generations")
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  /// KS-2639 / ADR-054 §3.2 Phase A. Денормализация `Course.ownerId` —
  /// чтобы guard'ы и фильтры могли проверять владельца без JOIN.
  /// Сервис обязан держать `Lesson.ownerId === Course.ownerId` уроков,
  /// которым он принадлежит. Для системных курсов — NULL. FK на User
  /// сознательно не ставится: целостность обеспечивается через
  /// `course_id → courses → owner_id`.
  ownerId     String?  @map("owner_id") @db.Uuid
  /// KS-2640 / ADR-054 §4 Phase B. NULLable для пользовательских уроков:
  /// у них нет slug / blockKey / kind / *Key — все эти поля — атрибуты
  /// системных курсов. Существующие системные записи остаются
  /// заполненными.
  slug        String?
  order       Int      @default(0)
  blockKey    String?  @map("block_key") // только для системных
  kind        String?  // "theory" | "tactics_set" | "endgame_set" | "opening_line" | "game_review" | "quiz"
  titleKey    String?  @map("title_key")
  summaryKey  String?  @map("summary_key")
  // KS-1964: inline-поля admin API. Приоритет над `*Key` (см. B-3/B-4).
  title       String?
  summary     String?
  estMinutes  Int      @default(10) @map("est_minutes")
  /// KS-2095: язык контента. Денормализован из Course.lang — упрощает
  /// фильтрацию выборок и проверки в API/импортёре. Значение должно
  /// совпадать с Course.lang курса-владельца.
  lang        String   @default("ru")
  /// KS-2095: ссылка на «канонический» урок (обычно из root-RU курса).
  /// Для уроков root-курса равен NULL. Используется нормализацией
  /// прогресса: UserLessonProgress.lessonId всегда хранится как root.
  parentLessonId String? @map("parent_lesson_id") @db.Uuid
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  steps        LessonStep[]
  progress     UserLessonProgress[]
  reviews      LessonReview[]
  /// KS-2095: self-relation для языковых вариантов урока.
  parent       Lesson?  @relation("LessonTranslations", fields: [parentLessonId], references: [id], onDelete: SetNull)
  translations Lesson[] @relation("LessonTranslations")

  @@unique([courseId, slug])
  @@index([courseId, order])
  @@index([courseId, blockKey, order])
  @@index([isPublished])
  @@index([parentLessonId])
  /// KS-2639 / ADR-054 §3.2 Phase A. Owner-guard ищет уроки конкретного
  /// автора по курсу — индекс по `(owner_id, course_id)`.
  @@index([ownerId, courseId])
  @@map("lessons")
}

model LessonStep {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  /// KS-2639 / ADR-054 §3.2 Phase A. Денормализация `Course.ownerId` /
  /// `Lesson.ownerId`. NULL для шагов системных уроков. FK не ставим:
  /// целостность через `lesson_id → lessons → courses → owner_id`.
  ownerId   String?  @map("owner_id") @db.Uuid
  order     Int      @default(0)
  type      String // "text" | "position" | "puzzle" | "quiz" | "video" | "game_review"
  payload   Json // JSONB; shape — дискриминированный union StepPayload
  createdAt DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@map("lesson_steps")
}

model UserCourseProgress {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  courseId        String    @map("course_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  currentLessonId String?   @map("current_lesson_id") @db.Uuid
  // KS-1955: lastActivityAt для Hero Variant B («Последняя активность: N дней назад»).
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("user_course_progress")
}

model UserLessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  masteredAt  DateTime? @map("mastered_at")
  score       Int       @default(0)
  stepsState  Json      @map("steps_state") // { [stepId]: "done" | "failed" | "skipped" }
  // KS-1955: трогается при каждом updateStepProgress / completeLesson.
  // Используется как источник lastActivityAt для активного курса в Hero.
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, completedAt])
  @@map("user_lesson_progress")
}

// ─── SM-2 Review (ADR-025 / L-21) ─────────────────────────────────────
//
// Трек повторений урока по алгоритму SuperMemo 2 (Piotr Woźniak, 1987).
// Запись создаётся при первом прохождении урока со `score ≥ 80`
// (одновременно с `UserLessonProgress.masteredAt`) и обновляется после
// каждого следующего повтора. Выборка «к повторению сегодня» идёт
// on-demand через индекс `(userId, dueAt)`.

model LessonReview {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lessonId       String    @map("lesson_id") @db.Uuid
  easiness       Float     @default(2.5) // SM-2 EF, нижняя граница 1.3
  interval       Int       @default(1) // дней до следующего повтора
  repetitions    Int       @default(0) // серия успешных повторов (q ≥ 3)
  dueAt          DateTime  @map("due_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  lastQuality    Int?      @map("last_quality") // 0..5
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, dueAt])
  @@map("lesson_reviews")
}

// ─── User Courses (ADR-026 → ADR-054 Phase E3 / KS-2649) ─────────────
//
// KS-2649: legacy-таблицы `user_courses` / `user_lessons` /
// `user_lesson_steps` / `user_course_play_progress` /
// `user_lesson_play_progress` дропнуты миграцией
// `20260509150000_adr054_phase_e3_drop_user_tables`. Их функциональность
// поглощена едиными таблицами `courses`/`lessons`/`lesson_steps` (с
// `owner_id` денормализованным из `Course.ownerId`) и системными
// `user_course_progress` / `user_lesson_progress`.
//
// CHECK constraints (см. миграцию E3):
//   * `courses_visibility_owner_check` — взаимоисключение
//     `is_published` (system) и `is_public` (user).
//   * `lessons_published_user_check` — пользовательский урок не
//     может быть `is_published=true`.

// ─── Feature flags (KS-2104) ──────────────────────────────────────────
//
// Runtime-флаги, читает `GET /api/config` (публичный endpoint, кэш
// 60s). Меняются админом через `PATCH /api/admin/feature-flags/:key`.
// Whitelist известных ключей — в коде (`KNOWN_FEATURE_FLAGS`); таблица
// служит только хранилищем значений. При старте api недостающие
// записи seeded дефолтами из whitelist.

model FeatureFlag {
  key       String   @id
  value     Boolean
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("feature_flags")
}


// ─── Tactical drills (KS-2226 / ADR-035 §4) ───────────────────────────
//
// Drill — короткая тактическая задача с ответом одной из четырёх форм
// (square / squares[] / number / move). Эталон в `answer` (JSONB),
// shape-discriminator валидируется backend'ом перед INSERT (см.
// tactical-drill-api-contract.md §3 / KS-DRILL-API).
//
// `attempts` пишется только для авторизованных юзеров (гости играют
// без записи прогресса — см. контракт §6). `sprint_scores` — итоги
// sprint-сессий (3-/5-минутный микс).

model TacticDrill {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Один из 8 типов из methodology §2. Хранится строкой, чтобы
  /// расширяться без миграции enum'а; на уровне backend whitelist.
  type       String
  fen        String
  /// Эталон в discriminated-union формате (см. shared
  /// `TacticDrillAnswer`). Для гостей и юзеров одинаковый, не отдаётся
  /// в `/next`-DTO — только в `/attempt`-response после submit'а.
  answer     Json
  /// Сложность 1..5 (KS-2225). На уровне БД ограничения не ставим —
  /// формула может меняться, валидация на backend'е.
  difficulty Int
  /// Источник эталона: `'generated-lichess'`, `'generated-archive'`,
  /// `'curated'` (KS-DRILL-CURATED, E5). Хранится строкой.
  source     String
  createdAt  DateTime @default(now()) @map("created_at")
  /// KS-2311 (methodology §10.3, §10.12): фиксированный drill rating
  /// (по difficulty bucket: 1→1000, 2→1300, 3→1500, 4→1700, 5→2000).
  /// Не обновляется на основе попыток; задаётся при INSERT (BACKFILL).
  rating          Int      @default(1500)
  // KS-2247 (ADR-035 §6.3 R5): поля sf_validated_at / sf_rejected /
  // sf_rejection_reason удалены в KS-2433 — Stockfish-валидация
  // отключена вместе с движком в api. См. миграцию
  // `20260505120000_drop_tactic_drills_sf_validation`.
  /// KS-2250-fix: метаданные UI рендера. На MVP содержит:
  ///  - `highlightedSquare?: Square` — для count-attackers (целевая клетка).
  ///  - `attackerColor?: 'w'|'b'` — для count-attackers (чьи атакующие).
  ///  - `expectedCount?: number` — для find-all-checks (UI прогресс).
  /// Прокидывается в `TacticDrillDto.meta` в /next, /by-step, /sprint,
  /// /daily. `null` для drill'ов где UI-meta не требуется.
  meta            Json?

  attempts TacticDrillAttempt[]

  @@index([type, difficulty])
  /// KS-2355 / KS-2433: композитный `(type, id)` индекс — покрывает
  /// keyset-random выборку `/tactic-drill/next` (`WHERE type=$1 AND
  /// id >= gen_random_uuid() ORDER BY id LIMIT 1`). Раньше индекс
  /// включал `sf_rejected`; после удаления SF-валидации этот столбец
  /// больше не существует.
  @@index([type, id])
  /// KS-2229: дедуп для индексера (одна (type, FEN)-комбинация —
  /// одна запись). UNIQUE constraint позволяет использовать
  /// `createMany({ skipDuplicates: true })` без race condition.
  @@unique([type, fen])
  /// KS-2250: обратная связь для daily-drill-history.
  dailyAssignments DailyTacticDrill[]
  @@map("tactic_drills")
}

/**
 * KS-2250 (ADR-035 §11 / E6): бронирование drill'а на дату для daily Telegram-рассылки.
 *
 * Один drill на дату — единый для всей аудитории. Бронирование lazy: создаётся
 * при первом GET /api/tactic-drill/daily?date=ISO. Повторный GET возвращает тот
 * же drill (детерминизм).
 *
 * Поля:
 *  - `drillType` / `difficulty` — денормализация для быстрого 14-day no-repeat
 *    запроса без JOIN на tactic_drills.
 *  - `isRepeat` / `originalDate` — fallback ветка контракта: если банк
 *    исчерпан, drill повторно используется (≥14 дней назад). Маркетинг это
 *    видит для аналитики, в caption Telegram не показывается.
 *
 * FK `drillId → tactic_drills.id` без CASCADE — запрещаем удаление drill'а,
 * который использовался в daily (иначе теряем историю показов).
 */
model DailyTacticDrill {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date         DateTime @unique @map("date") @db.Date
  drillId      String   @map("drill_id") @db.Uuid
  drillType    String   @map("drill_type")
  difficulty   String // 'easy' | 'medium' | 'hard'
  isRepeat     Boolean  @default(false) @map("is_repeat")
  /// Если `isRepeat=true` — дата предыдущего показа того же drill'а
  /// (для аналитики, чтобы понять «через сколько дней повторился»).
  originalDate DateTime? @map("original_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  drill TacticDrill @relation(fields: [drillId], references: [id], onDelete: Restrict)

  @@index([drillId])
  @@index([drillType, date])
  @@map("daily_tactic_drills")
}

model TacticDrillAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// nullable — для гостей запись не пишется, поле зарезервировано на
  /// случай, если в v2 решим логировать гостевые попытки анонимно.
  userId      String?  @map("user_id") @db.Uuid
  drillId     String   @map("drill_id") @db.Uuid
  correct     Boolean
  /// Время решения в миллисекундах от показа до submit'а.
  timeMs      Int      @map("time_ms")
  /// Что прислал пользователь (тот же AnswerData shape, что и эталон).
  /// Хранится для разбора истории попыток и аналитики.
  answerGiven Json     @map("answer_given")
  createdAt   DateTime @default(now()) @map("created_at")
  /// KS-2311 (methodology §10.11): rating до/после применения попытки.
  /// nullable для legacy-записей и для гостевых попыток (rating не
  /// обновляется). `capped=true` — daily cap (+50 в drill mode) обрезал
  /// прирост.
  ratingBefore Int?    @map("rating_before")
  ratingAfter  Int?    @map("rating_after")
  ratingCapped Boolean @default(false) @map("rating_capped")

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  drill TacticDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([drillId])
  @@map("tactic_drill_attempts")
}

model TacticDrillSprintScore {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// Кол-во правильно решённых задач в sprint'е.
  score       Int
  /// Общее число задач в сессии.
  drillsCount Int      @map("drills_count")
  /// `score / drillsCount`, [0..1], округлено до 2 знаков на backend'е.
  accuracy    Float
  /// Например `'3min-mixed'` / `'5min-checks-only'` — whitelist на
  /// backend.
  mode        String
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mode, score])
  @@index([userId, createdAt])
  @@map("tactic_drill_sprint_scores")
}

/**
 * KS-4982 / ADR-167 §5.1: итог одной Sprint-сессии Vision-тренажёра
 * (зрение доски). Генерация и подсчёт — на клиенте; сервер хранит только
 * агрегат сессии и отдаёт лидерборд/статистику/историю. Пер-вопросных
 * записей нет. Гость не сохраняется (userId всегда задан для сохранённых;
 * поле nullable по ADR §5.1). Лидерборд «тренировочного» класса —
 * анти-чит осознанно отложен (ADR §5.2).
 */
model VisionScore {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  /// 'color' | 'find' | 'name' | 'relation' | 'geometry' | 'mixed'
  mode          String
  /// '30s' | '60s' | '120s'
  timeMode      String   @map("time_mode")
  /// Уровень сложности 1..N.
  difficulty    Int
  /// Верных ответов.
  score         Int
  /// Всего вопросов.
  total         Int
  /// `score / total`, [0..1], округлено на backend'е.
  accuracy      Float
  maxStreak     Int      @map("max_streak")
  avgResponseMs Int      @map("avg_response_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mode, timeMode, score])
  @@index([userId, createdAt])
  @@map("vision_scores")
}

/**
 * KS-2373: статистика посещений разделов для динамического
 * MobileBottomBar — три самых посещаемых раздела отображаются
 * в нижней панели мобильной версии, остальные — через меню «Ещё».
 *
 * Хранится на сервере (не в localStorage), чтобы топ был
 * cross-device — пользователь видит свой набор на любом девайсе.
 *
 * `route` — короткий идентификатор раздела (`'play'`, `'archive'`,
 * `'drills'` и т. п.; whitelist на backend в DTO). UNIQUE на
 * (user_id, route): по одной записи на пользователя × раздел,
 * `count` инкрементируется через UPSERT.
 *
 * Index `(user_id, count desc)` — для быстрого `top N` запроса.
 */
model UserNavStat {
  userId    String   @map("user_id") @db.Uuid
  /// Whitelist'ed route id (см. `apps/web/src/components/MobileBottomBar.tsx`).
  route     String
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, route])
  @@index([userId, count(sort: Desc)])
  @@map("user_nav_stats")
}

/**
 * KS-3270 (ADR-077 §2.1, §2.2, §2.6). Дебютный репертуар пользователя —
 * структурированное PGN-дерево для тренировки. Источник истины для
 * Opening Trainer'а (отдельный продукт от `Analysis`, см. §2.1).
 *
 * Парсинг PGN → tree происходит на бэке при INSERT/UPDATE'е (KS-3271).
 * Транспозиции схлопываются по FEN — одна позиция = один node в `tree.nodes`.
 *
 * Лимиты (валидируются в DTO, KS-3272):
 *   - `nodeCount ≤ 2000`
 *   - `edgeCount ≤ 5000`
 *   - `maxDepth ≤ 80` полуходов
 *   - размер `pgn` ≤ 500 КБ
 *   - максимум 50 репертуаров на пользователя
 *
 * Soft-delete через `deletedAt` (ADR §3 / §8): окно восстановления 30 дней,
 * после чего hard-delete отдельным job'ом. `is_public` (M3) добавится
 * отдельной миграцией когда подключим sharing.
 */
model OpeningRepertoire {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// KS-4674 / ADR-146 §2.2. Nullable: для админских/демо репертуаров
  /// (`isDemo=true`) владельца нет — поле NULL. Для пользовательских
  /// (`isDemo=false`) — UUID владельца. Инвариант enforce'ится
  /// БД-CHECK (см. миграцию `20260627_ks4674_*`).
  userId      String?  @map("user_id") @db.Uuid
  /// KS-4674 / ADR-146 §2.1. Стабильный человекочитаемый идентификатор
  /// демо-репертуара — фигурирует в URL `/opening-trainer/demo/<slug>`.
  /// У пользовательских репертуаров — NULL. Partial UNIQUE по миграции
  /// (`opening_repertoires_demo_slug_uniq WHERE is_demo=true`).
  slug        String?
  /// KS-4674 / ADR-146. Флаг «админский/публичный демо-репертуар».
  /// Двойственная сущность в одной таблице решена через явный флаг —
  /// см. ADR-146 §2.1 для альтернатив.
  isDemo      Boolean  @default(false) @map("is_demo")
  /// KS-4674 / ADR-146. Для админских записей: черновик (false) /
  /// опубликован (true). Только `is_demo=true AND is_published=true`
  /// видны в публичном `GET /opening-trainer/demo`. Для
  /// пользовательских (`is_demo=false`) поле не используется.
  isPublished Boolean  @default(false) @map("is_published")
  title       String
  /// Описание (опц.) — отображается на карточке репертуара.
  description String?
  /// Исходный PGN, который загрузил пользователь. Хранится «как есть»
  /// для экспорта и повторной сборки tree при изменении парсера.
  pgn         String   @db.Text
  /// Структурированное дерево (FEN-keyed). Shape: `RepertoireTree` из
  /// `@kingside/shared/types/opening-trainer.ts`. Парсится на бэке
  /// `pgn-to-tree.service.ts` (KS-3271).
  tree        Json
  /// Денормализация `tree.meta.*` — для быстрого вывода в лобби-списке
  /// без чтения JSONB-поля.
  nodeCount   Int      @default(0) @map("node_count")
  edgeCount   Int      @default(0) @map("edge_count")
  maxDepth    Int      @default(0) @map("max_depth")
  /// KS-3302: сторона за которую пользователь тренирует этот репертуар.
  /// Один репертуар = одна сторона (репертуар за белых vs за чёрных —
  /// разные сущности). Селектор стороны убран из startSession UI —
  /// берётся отсюда. Default 'white' для backward-compat (KS-3286 / M2
  /// репертуары без явного side восстанавливаются в 'white').
  side        String   @default("white")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  /// KS-3270: soft-delete. NULL = активен, не-NULL = удалён, 30-дн окно
  /// до hard-delete (отдельным cleanup job'ом, M2).
  deletedAt   DateTime? @map("deleted_at")

  /// KS-4674 / ADR-146. Relation теперь опциональна (см. `userId`).
  /// FK `ON DELETE CASCADE` оставлен по уточнению ADR-146 §3 п.2:
  /// удалил пользователя → удалили его репертуары. Для админских
  /// (`userId=NULL`) FK не сработает — что и нужно.
  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    OpeningTrainerSession[]
  // KS-3287 (M2): per-path прогресс линий этого репертуара.
  lineProgress OpeningLineProgress[]
  // KS-3325 (ADR-078): источники PGN репертуара (1..maxSourcesPerRepertoire).
  sources     OpeningRepertoireSource[]

  /// Лобби-выборка: `WHERE user_id=$1 AND deleted_at IS NULL ORDER BY created_at DESC`.
  @@index([userId, createdAt(sort: Desc)])
  /// Cleanup job'у нужен индекс по deleted_at для hard-delete (M2).
  @@index([deletedAt])
  /// KS-4674: вспомогательный индекс по slug — partial UNIQUE для
  /// `is_demo=true` создаётся отдельной raw SQL миграцией (Prisma не
  /// поддерживает partial unique декларативно).
  @@index([slug])
  /// KS-4674 / ADR-146 §2.5. Публичная выборка `/opening-trainer/demo`:
  /// `WHERE is_demo=true AND is_published=true ORDER BY created_at DESC`.
  @@index([isDemo, isPublished, createdAt(sort: Desc)])
  @@map("opening_repertoires")
}

/**
 * KS-3325 (ADR-078 §2.1). Источник PGN репертуара. Один репертуар
 * может содержать несколько источников — для каждого хранится свой
 * сырой PGN, опциональное UI-имя, тип источника и опц. ссылка на
 * Analysis (для workshop-import). Дерево репертуара пересобирается
 * builder'ом из всех sources с union edge'ов по `sourceIds`.
 *
 * ON DELETE CASCADE — при удалении репертуара чистим источники.
 */
model OpeningRepertoireSource {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repertoireId     String   @map("repertoire_id") @db.Uuid
  /// UI-имя источника. NULL → фронт показывает fallback (`[Event]` из
  /// PGN-header'а или `PGN N`).
  name             String?
  pgn              String   @db.Text
  /// `'pgn-upload' | 'workshop-analysis' | 'legacy-import' |
  /// 'archive-position'`. CHECK на уровне миграции (Prisma enum не
  /// используется — value-set может расширяться без migration в shared
  /// types).
  /// KS-3467 (ADR-090): добавлено `'archive-position'` для репертуаров,
  /// собранных из мастер-партий 2400+ по позиции (FEN).
  sourceKind       String   @map("source_kind")
  /// Для `sourceKind='workshop-analysis'` — UUID анализа из мастерской.
  sourceAnalysisId String?  @map("source_analysis_id") @db.Uuid
  /// KS-3467 (ADR-090 §8). Для `sourceKind='archive-position'` — id
  /// исходной партии из `archive_games` (для трассировки «открыть
  /// исходную партию»). NULL для остальных sourceKind. Без FK —
  /// archive_games могут переидексироваться.
  archiveGameId    String?  @map("archive_game_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  repertoire       OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  /// Часто загружаемая связь: все source'ы одного репертуара (для
  /// detail-page) — `WHERE repertoire_id=$1 ORDER BY created_at`.
  @@index([repertoireId])
  @@index([repertoireId, createdAt])
  @@map("opening_repertoire_sources")
}

/**
 * KS-3270 (ADR-077 §2.6). Сессия тренировки — long-lived (минуты-часы),
 * переживает refresh браузера и возврат через дни. `currentFen` +
 * `currentPath` позволяют продолжить с той же позиции.
 *
 * `playedLines: Json` = `{[fen: string]: string[]}` — per-position
 * массив `childFen`, уже сыгранных ботом. См. ADR §2.3 (random-without-
 * repeat).
 *
 * `status`:
 *   - `'active'`   — сессия идёт, finishedAt=NULL
 *   - `'finished'` — пользователь нажал finish или прошёл все линии
 *   - `'expired'`  — auto-close через 24 ч неактивности
 *
 * `mode` whitelist на backend (KS-3272): 'learn' | 'review' | 'mistakes' | 'free'.
 * `repeatMode`: 'cycle' (обнуляем playedLines после прохода) | 'complete'
 * (финишируем сессию).
 *
 * `mode = 'free'` пишет attempts, но НЕ обновляет статистику линий (M2).
 */
model OpeningTrainerSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  repertoireId    String   @map("repertoire_id") @db.Uuid
  /// 'white' | 'black' — какой стороной играет пользователь.
  side            String
  /// 'learn' | 'review' | 'mistakes' | 'free'. Whitelist на backend.
  mode            String
  /// 'cycle' | 'complete'. Default 'complete'.
  repeatMode      String   @default("complete") @map("repeat_mode")
  /// 'active' | 'finished' | 'expired'. Whitelist на backend.
  status          String   @default("active")
  /// `{[fen: string]: string[]}` — какие childFen бот уже сыграл per-position.
  /// Растёт по мере прохождения; squash periodically не нужен (см. ADR §6.8).
  playedLines     Json     @default("{}") @map("played_lines")
  /// Текущая FEN позиция (на чей ход — определяется парсингом FEN'а).
  currentFen      String   @map("current_fen")
  /// `string[]` — UCI-путь от корня до `currentFen` для line-progress
  /// агрегатов на финале (M2) и для отображения «последнего хода» в UI.
  currentPath     Json     @default("[]") @map("current_path")
  score           Int      @default(0)
  movesPlayed     Int      @default(0) @map("moves_played")
  correctMoves    Int      @default(0) @map("correct_moves")
  wrongMoves      Int      @default(0) @map("wrong_moves")
  hintsUsed       Int      @default(0) @map("hints_used")
  /// KS-3272: текущая серия подряд правильных ходов. Сбрасывается на 0
  /// при wrong-ходе. Используется в `scoring.ts` для streak-multiplier
  /// (ADR-077 §2.7: ×1.2 после 5 подряд).
  currentStreak   Int      @default(0) @map("current_streak")
  /// Максимальный streak в сессии (для финал-экрана).
  streakMax       Int      @default(0) @map("streak_max")
  /// KS-3272: FEN-позиция, для которой только что вызывался `/hint`.
  /// Следующий /move из этой позиции считается «после подсказки» —
  /// scoreDelta уменьшается до +5 вместо +10 (ADR-077 §2.7). После
  /// любого /move сбрасывается в NULL.
  pendingHintFen  String?  @map("pending_hint_fen")
  /// KS-3277: edges, пройденные В ТЕКУЩЕЙ СЕССИИ без единой ошибки в
  /// рамках линии (от line-restart до line-complete). Формат тот же,
  /// что у playedLines: `{[fen]: childFen[]}`. Когда вся структура
  /// `cleanPlayedLines` покрывает дерево репертуара → сессия завершается
  /// статусом `tree-complete`. Edges с ошибочными ходами в линии НЕ
  /// добавляются — линия попадает в очередь повторения.
  cleanPlayedLines     Json @default("{}") @map("clean_played_lines")
  /// KS-3277: флаг «в текущей линии была хотя бы одна ошибка». Сбрасывается
  /// в `false` при line-restart / tree-complete. Используется чтобы решить —
  /// помечать ли линию clean при достижении line-complete.
  currentLineHadWrong  Boolean @default(false) @map("current_line_had_wrong")
  /// KS-3277: индекс в `currentPath`, с которого началась текущая линия
  /// (после последнего line-restart). Edges в `currentPath[lineStartIndex..]`
  /// — кандидаты для добавления в cleanPlayedLines при clean line-complete.
  lineStartIndex       Int @default(0) @map("line_start_index")
  /// KS-3290 (M2 B4): UCI-путь review-линии для `mode='review'`. При
  /// старте сессии заполняется из `OpeningLineProgress.pathUci` —
  /// идентифицирует ИМЕННО ТУ линию, к которой применяется SM-2
  /// `applyReview(quality=1|5)` на wrong / clean-line-complete.
  /// `null` для не-review сессий и legacy-записей.
  reviewLinePathUci    Json? @map("review_line_path_uci")
  startedAt       DateTime @default(now()) @map("started_at")
  lastActivityAt  DateTime @default(now()) @map("last_activity_at")
  finishedAt      DateTime? @map("finished_at")

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  repertoire OpeningRepertoire       @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  attempts   OpeningTrainerAttempt[]

  /// Лобби-вкладка «мои сессии», resume-список активных.
  @@index([userId, repertoireId, finishedAt])
  /// Аналитика per-репертуар, auto-expire job'у нужен (status, lastActivityAt).
  @@index([repertoireId, status])
  @@index([status, lastActivityAt])
  @@map("opening_trainer_sessions")
}

/**
 * KS-3270 (ADR-077 §2.6). Одна попытка пользователя в рамках сессии.
 * Логируется и для аналитики (tree-view ошибок, M2) и для агрегации
 * в `OpeningLineProgress` (M2). В M1 — раз-логирование без агрегатов
 * за пределами session-счётчиков.
 *
 * `expectedMoves` хранится как `Json` (массив UCI-строк) — не Postgres
 * `Text[]`, для совместимости с Prisma-паттерном остального проекта
 * (см. `TacticDrillAttempt.answerGiven`).
 */
model OpeningTrainerAttempt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  /// FEN позиции, в которой пользователь делал ход.
  positionFen     String   @map("position_fen")
  /// `string[]` — UCI-варианты, которые считались правильными.
  expectedMoves   Json     @map("expected_moves")
  /// UCI пользовательского хода (что фактически прислали).
  userMove        String   @map("user_move")
  correct         Boolean
  /// `true` если пользователь видел подсказку на этой позиции (KS-3272
  /// hint endpoint). Влияет на scoreDelta: +5 вместо +10.
  hintUsed        Boolean  @default(false) @map("hint_used")
  scoreDelta      Int      @map("score_delta")
  /// Миллисекунды от показа позиции до отправки хода.
  responseTimeMs  Int      @map("response_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  session OpeningTrainerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("opening_trainer_attempts")
}

/**
 * KS-3287 (ADR-077 §2.5, M2). Per-path прогресс пользователя по линии
 * репертуара. `pathHash` = sha1(join('|', pathUci)) — короткий уникальный
 * ключ (UCI-пути могут быть длинными, ≤ 80 полуходов).
 *
 * Мастеринг: `consecutiveCorrect >= OPENING_LINE_MASTERY_THRESHOLD` (3)
 * → `masteredAt = now`, инициализация SM-2 (`Sm2Service` через адаптер,
 * KS-3288 B2). После mastered SM-2 управляет `sm2DueAt`; review-mode
 * (KS-3290 B4) выбирает линии с `sm2DueAt <= now`.
 *
 * `orphaned=true` — линия из старого PGN, которой больше нет в дереве
 * после `PATCH /repertoires/:id`. Не учитывается в SRS-выборках, не
 * рендерится в tree-view (KS-3294 B8 orphan-pruning).
 *
 * Unique (userId, repertoireId, pathHash) — одна запись на pat'h
 * пользователя. Concurrent upsert через PostgreSQL ON CONFLICT
 * (`prisma.openingLineProgress.upsert`).
 *
 * Индексы:
 *   - (userId, repertoireId) — выборка прогресса репертуара (`/progress`).
 *   - (userId, sm2DueAt) — SRS-очередь «к повтору сегодня» (`/reviews/due`).
 */
model OpeningLineProgress {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  repertoireId String   @map("repertoire_id") @db.Uuid

  /// sha1(join('|', pathUci)). Короткий уникальный ключ.
  pathHash     String   @map("path_hash")
  /// UCI-путь от корня до точки замера. JSONB `string[]`.
  pathUci      Json     @map("path_uci")
  /// Длина пути в полуходах (= pathUci.length). Денормализация для
  /// быстрых WHERE-фильтров без JSONB-парсинга.
  pathLength   Int      @map("path_length")

  correctCount       Int @default(0) @map("correct_count")
  wrongCount         Int @default(0) @map("wrong_count")
  consecutiveCorrect Int @default(0) @map("consecutive_correct")

  lastPlayedAt DateTime  @map("last_played_at")
  /// `null` пока не достигнут мастеринг. NON-null = `now()` момента
  /// перехода в mastered. SM-2-поля заполняются ОДНОВРЕМЕННО с этим.
  masteredAt   DateTime? @map("mastered_at")

  /// SM-2 ease-factor (от 1.3 до ~2.5+). NULL до mastered.
  sm2Easiness  Float?    @map("sm2_easiness")
  /// SM-2 interval в днях.
  sm2Interval  Int?      @map("sm2_interval")
  /// SM-2 due-timestamp (= masteredAt + sm2Interval).
  sm2DueAt     DateTime? @map("sm2_due_at")
  /// SM-2 repetition number (0 при первом review, инкремент на correct).
  sm2Reps      Int?      @map("sm2_reps")

  /// KS-3286 / KS-3294 (B8). Линия больше не существует в дереве —
  /// `PATCH /repertoires/:id` с новым PGN не покрыл этот pathHash.
  /// SRS-выборки фильтруют по `orphaned=false`. Если линия возвращается
  /// (новый PGN снова её содержит) — поле сбрасывается в false.
  orphaned     Boolean   @default(false)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  repertoire OpeningRepertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@unique([userId, repertoireId, pathHash])
  @@index([userId, repertoireId])
  @@index([userId, sm2DueAt])
  @@map("opening_line_progress")
}

/// KS-3730 / ADR-110: live-трансляция анализа партии.
/// Эфемерная сущность: автор открывает анализ, зрители подключаются
/// по публичной ссылке `kingside.site/live/<slug>` и видят ходы автора
/// в реальном времени. После закрытия (вручную или по таймауту 30 мин
/// неактивности) запись остаётся для аудита (status=closed), а Redis
/// state с историей ходов протухает за 24 часа.
///
/// Метаданные хранятся здесь; текущая позиция и история ходов — в
/// Redis (`live_analysis:<id>:state` hash, `live_analysis:<id>:moves`
/// list). См. ADR-110 §2.1, §2.5.
model LiveAnalysis {
  id             String             @id @default(uuid()) @db.Uuid
  /// nanoid(10), URL-safe alphabet. Защищён от коллизий UNIQUE-индексом.
  slug           String             @unique
  ownerId        String             @map("owner_id") @db.Uuid
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String?
  /// null → стандартная начальная позиция.
  startingFen    String?            @map("starting_fen")
  status         LiveAnalysisStatus @default(active)
  createdAt      DateTime           @default(now()) @map("created_at")
  closedAt       DateTime?          @map("closed_at")
  /// Обновляется на каждый ход автора (с дросселированием раз в 10с
  /// per-slug, см. ADR-110 §2.9.7). Используется cleanup-job'ом для
  /// автозакрытия трансляций с lastActivityAt < NOW() - 30min.
  lastActivityAt DateTime           @default(now()) @map("last_activity_at")
  /// Пиковое число одновременных зрителей за время трансляции.
  /// Аналитика; обновляется атомарно при росте viewers-counter.
  viewerPeak     Int                @default(0) @map("viewer_peak")
  /// KS-3757 / ADR-112: ссылка на исходный `Analysis`, чьё содержимое
  /// автор транслирует. Nullable, потому что трансляция может стартовать
  /// без привязки (исторические записи ADR-110). `onDelete: SetNull` —
  /// удаление анализа сохраняет запись трансляции (аудит), но обнуляет
  /// binding. Уникальность «один автор × один анализ = один active» —
  /// через partial UNIQUE индекс в миграции `WHERE status='active' AND
  /// analysis_id IS NOT NULL`; в schema не выражается, поэтому здесь
  /// нет `@@unique`.
  analysisId     String?            @map("analysis_id") @db.Uuid
  analysis       Analysis?          @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  /// KS-3783 / ADR-113 §2: лекции, к которым привязана трансляция
  /// (FK с onDelete: SetNull со стороны Lecture).
  lectures       Lecture[]

  /// «Мои активные трансляции» в профиле автора.
  @@index([ownerId, status])
  /// Cleanup-job отбирает по этому индексу:
  /// WHERE status='active' AND last_activity_at < NOW() - INTERVAL '30 min'.
  @@index([status, lastActivityAt])
  @@map("live_analyses")
}

enum LiveAnalysisStatus {
  active
  closed

  @@map("live_analysis_status")
}

/// KS-3783 / ADR-113 §2: Lecture — лекция тренера.
///
/// Базовая сущность страницы тренера: будущая лекция (`scheduled`),
/// идущая в данный момент (`live` — обычно привязана к `LiveAnalysis`
/// через `liveAnalysisId`), завершённая (`recorded`) или отменённая
/// (`cancelled`). `courseId` намеренно отсутствует — связь с курсом
/// откладывается на более поздний эпик (согласовано с пользователем).
///
/// Partial UNIQUE индекс `lecture_live_analysis_id_active_unique` на
/// `liveAnalysisId WHERE status='live'` (одна активная лекция на одну
/// live-сессию) выражен только в raw SQL миграции — в `schema.prisma`
/// `@@unique` не использовать, иначе full-unique запретит «recorded»
/// записи на ту же `liveAnalysisId`.
model Lecture {
  id             String             @id @default(uuid()) @db.Uuid
  ownerId        String             @map("owner_id") @db.Uuid
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  scheduledAt    DateTime?          @map("scheduled_at")
  startedAt      DateTime?          @map("started_at")
  endedAt        DateTime?          @map("ended_at")
  durationMs     Int?               @map("duration_ms")
  status         LectureStatus      @default(scheduled)
  visibility     LectureVisibility  @default(public)
  /// KS-3783 / ADR-113: привязка к активной live-трансляции анализа.
  /// При удалении / SetNull у самой `LiveAnalysis` ссылка обнуляется,
  /// запись лекции сохраняется. Уникальность «один live = одна live-
  /// лекция» — через partial UNIQUE в миграции.
  liveAnalysisId String?            @map("live_analysis_id") @db.Uuid
  liveAnalysis   LiveAnalysis?      @relation(fields: [liveAnalysisId], references: [id], onDelete: SetNull)
  /// KS-3783 / ADR-113 §4 эпик 2. «Текущая» запись лекции (один
  /// `LectureRecording`). FK с `onDelete: SetNull` — удаление записи
  /// не должно сносить саму лекцию, просто обнуляет ссылку.
  /// Сам `LectureRecording.lectureId` имеет обратный FK на эту же
  /// лекцию с `onDelete: Cascade` (см. модель LectureRecording),
  /// поэтому связь именована — иначе Prisma не различит две стороны.
  recordingId    String?            @map("recording_id") @db.Uuid
  recording      LectureRecording?  @relation("LectureCurrentRecording", fields: [recordingId], references: [id], onDelete: SetNull)
  /// Обратный конец `LectureRecording.lecture` (см. relation
  /// "LectureRecordings"). На практике сейчас одна запись на лекцию
  /// (UNIQUE по `lectureId`), но прямой тип на стороне Prisma —
  /// массив, иначе схема не валидна.
  recordings     LectureRecording[] @relation("LectureRecordings")
  /// KS-3783 / ADR-113 §4 эпик 4: задел под медиаконтент (внешняя ссылка
  /// и тип источника — youtube / vk / mp4 / …).
  mediaUrl       String?            @map("media_url")
  mediaKind      String?            @map("media_kind")
  /// KS-3829 / ADR-116 §4. Аудио-метаданные лекции (одна запись на лекцию,
  /// UNIQUE по lectureId) и журнал чанков клиентской записи. Обратные
  /// концы FK с onDelete: Cascade — описаны в моделях LectureAudio /
  /// LectureAudioChunk.
  audio          LectureAudio?
  audioChunks    LectureAudioChunk[]
  /// KS-3898 / ADR-117 §2. Набор инструментов, отключённых тренером
  /// для учеников live-сессии. Пустой массив = ничего не отключено
  /// (ученикам доступен полный набор). Допустимые значения см.
  /// `LectureDisabledTool` в `packages/shared/src/types/api-contracts.ts`;
  /// валидация — на стороне DTO (A02 / KS-3899). Изменения публикуются
  /// событием `live-analysis:lecture-tools` (KS-3896 D01).
  disabledTools  String[]           @default([]) @map("disabled_tools")
  /// KS-4039. Скрывать ли блок «Метрики» (позиционные подкомпоненты
  /// Stockfish, KS-4033/4034/4036/4038) у зрителей-учеников в режиме
  /// лекции. Default false — блок виден всем. Тренер всегда видит
  /// блок независимо от значения.
  hideMetricsTab Boolean            @default(false) @map("hide_metrics_tab")
  /// KS-3930 / ADR-118 §3.2. Allowlist для `visibility='restricted'`.
  /// Каждая запись — один разрешённый субъект (MVP: только `subjectType='user'`,
  /// задел под `'course'`). При `visibility != 'restricted'` массив
  /// игнорируется резолвером, но не удаляется (allowlist сохраняется при
  /// переключении видимости — см. KS-3933 A04).
  accessGrants   LectureAccessGrant[]
  /// KS-4008 / ADR-121 Phase 1. Чат лекции: лента сообщений + per-user
  /// мьюты на текущую лекцию. onDelete: Cascade у обеих моделей —
  /// удаление лекции чистит чат полностью (мы не храним переписку
  /// в отрыве от лекции; для replay её консервирует finalizer в
  /// `LectureRecording.events`, см. Phase 2).
  chatMessages   LectureChatMessage[]
  chatMutes      LectureChatMute[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  /// Фильтр на странице тренера: «мои <status>»-вкладки.
  @@index([ownerId, status])
  /// Список ближайших / будущих лекций (WHERE status='scheduled'
  /// ORDER BY scheduled_at ASC).
  @@index([status, scheduledAt])
  @@map("lectures")
}

/// KS-3790 / ADR-113 §2.3.3, §4 крупная задача 2. Запись лекции —
/// упорядоченный массив событий (move/state-patch/move/...) с временной
/// меткой `t: number` относительно старта записи. Создаётся
/// finalizer'ом при закрытии live-сессии.
///
/// Связь с `Lecture`: два FK, оба именованы.
///   - `LectureRecording.lecture` (FK lectureId → lectures.id,
///     ON DELETE CASCADE) — основная owner-связь. UNIQUE по
///     `lectureId` гарантирует «одна запись на лекцию».
///   - `Lecture.recording` (FK recordingId → lecture_recordings.id,
///     ON DELETE SET NULL) — указатель на «текущую» запись лекции.
///     Семантически избыточно при 1:1, но удобно для прямого
///     access'а `prisma.lecture.include({recording})`.
model LectureRecording {
  id           String   @id @default(uuid()) @db.Uuid
  lectureId    String   @unique @map("lecture_id") @db.Uuid
  lecture      Lecture  @relation("LectureRecordings", fields: [lectureId], references: [id], onDelete: Cascade)
  /// Обратный конец `Lecture.recording` (relation "LectureCurrentRecording").
  asCurrentFor Lecture[] @relation("LectureCurrentRecording")

  /// Стартовая позиция (от автора). `null` если автор начал с initial
  /// position — то же поведение, что у `LiveAnalysis.startingFen`.
  startingFen  String?  @map("starting_fen")
  /// Ориентация доски при записи: `white` | `black`. Строка а не enum,
  /// потому что у `LectureRecording` нет других значений и расширений
  /// в обозримом будущем не планируется (см. ADR-113).
  orientation  String?
  /// Упорядоченный массив `RecordedEvent[]`. Каждое событие имеет:
  ///   { t: number, type: 'move'|'state-patch'|..., payload: ... }
  /// `t` — миллисекунды от начала записи.
  events       Json
  /// Общая длительность записи (мс), равна `t` последнего события или
  /// больше — если автор смотрел на доску без действий после.
  durationMs   Int      @map("duration_ms")
  /// Денормализация `events.length` для быстрых выборок без парсинга JSON.
  eventCount   Int      @map("event_count")
  /// Размер сериализованного JSON в байтах (длина строки). Используется
  /// для аналитики и для отсечения превышающих лимит 50 MB.
  byteSize     Int      @map("byte_size")
  /// true, если recorder дошёл до лимита 50 MB и хвост событий был
  /// отброшен. Финализатор выставляет флаг, фронт показывает
  /// предупреждение «запись усечена».
  truncated    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("lecture_recordings")
}

/// KS-3829 / ADR-116 §4, §7.3. Аудио-метаданные лекции. Одна запись на
/// лекцию (UNIQUE по lectureId). Клиент пишет MediaRecorder'ом и заливает
/// чанками (см. LectureAudioChunk); cron-finalizer склеивает чанки через
/// `ffmpeg -c copy -f ogg` в финальный файл и записывает сюда
/// storageKey/durationMs/bitrateKbps/...
///
/// `recorderStartedAtClient` — момент `MediaRecorder.start()` на клиенте
/// (DateTime). Нужен для синхронизации аудио с recorded-событиями
/// LectureRecording (audio.t = recording.t + offsetMs).
///
/// Удалённые поля (по сравнению с задумкой ADR-115): `audioStartedAt`,
/// `egressId` — артефакты прежней серверной (LiveKit) записи; в схеме
/// никогда не материализовались (модель добавляется впервые этой
/// миграцией).
model LectureAudio {
  id                      String   @id @default(uuid()) @db.Uuid
  lectureId               String   @unique @map("lecture_id") @db.Uuid
  lecture                 Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  storageKey              String   @map("storage_key")
  codec                   String   @default("opus")
  container               String   @default("ogg")
  bitrateKbps             Int?     @map("bitrate_kbps")
  channels                Int      @default(1)
  durationMs              Int?     @map("duration_ms")
  /// Смещение начала аудио относительно начала LectureRecording (мс).
  /// Может быть отрицательным, если recorder стартовал раньше первой
  /// записанной события доски.
  offsetMs                Int?     @map("offset_ms")
  recorderStartedAtClient DateTime @map("recorder_started_at_client")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([lectureId])
  @@map("lecture_audio")
}

/// KS-3829 / ADR-116 §7.3. Журнал чанков клиентской аудио-записи.
/// Используется cron-восстановителем (KS-A05') для сборки финального
/// файла и обеспечения идемпотентности подтверждений загрузки чанка
/// (UNIQUE по (lectureId, seq) — повторный PUT того же seq не создаёт
/// дубликата).
model LectureAudioChunk {
  id              String   @id @default(uuid()) @db.Uuid
  lectureId       String   @map("lecture_id") @db.Uuid
  lecture         Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  seq             Int
  storageKey      String   @map("storage_key")
  etag            String
  sizeBytes       Int      @map("size_bytes")
  clientCreatedAt DateTime @map("client_created_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([lectureId, seq])
  @@index([lectureId])
  @@map("lecture_audio_chunks")
}

enum LectureStatus {
  scheduled
  live
  recorded
  cancelled

  @@map("lecture_status")
}

enum LectureVisibility {
  public
  unlisted
  /// KS-3930 / ADR-118 §2.1. Третий уровень видимости — доступ только
  /// у владельца и явно добавленных в allowlist (см. `LectureAccessGrant`).
  /// Анонимный зритель получает `401 auth_required`, авторизованный
  /// без grant'а — `403 lecture_access_revoked`. Allowlist хранится
  /// в `LectureAccessGrant` и НЕ очищается при переключении на
  /// `public`/`unlisted` (KS-3933 A04).
  restricted

  @@map("lecture_visibility")
}

/// KS-3930 / ADR-118 §2.2. Дискриминатор полиморфного subject_id в
/// `LectureAccessGrant`. MVP использует только `user`. `course` —
/// задел: при попытке создать grant с `subjectType='course'` API
/// возвращает 400 до появления модели Course/Enrollment.
enum LectureAccessSubject {
  user
  course

  @@map("lecture_access_subject")
}

/// KS-3930 / ADR-118 §2.2, §3.2. Allowlist-записи для лекций с
/// `visibility='restricted'`. Полиморфный связной субъект:
/// `subjectType` + `subjectId`. FK на User по `subjectId` не делаем
/// (поле должно работать и для `course`), целостность держим
/// обработчиком удаления User (см. KS-3935 A06: cleanup в
/// UsersService.delete по `subjectType='user' AND subjectId=:userId`).
model LectureAccessGrant {
  id          String               @id @default(uuid()) @db.Uuid
  lectureId   String               @map("lecture_id") @db.Uuid
  lecture     Lecture              @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  /// 'user' (MVP) | 'course' (задел, до появления Course).
  subjectType LectureAccessSubject @map("subject_type")
  /// Для 'user' — User.id, для 'course' — Course.id. Не FK.
  subjectId   String               @map("subject_id") @db.Uuid

  /// Кто добавил grant (обычно = Lecture.ownerId). Для аудита.
  grantedById String               @map("granted_by_id") @db.Uuid
  grantedBy   User                 @relation("LectureAccessGrants", fields: [grantedById], references: [id], onDelete: Cascade)
  grantedAt   DateTime             @default(now()) @map("granted_at")

  /// Защита от дублей при повторном добавлении одного субъекта.
  @@unique([lectureId, subjectType, subjectId], map: "lecture_access_unique")
  /// Обратный лукап: какие лекции доступны конкретному субъекту.
  /// Используется в `GET /my/lectures` (KS-3937 B02).
  @@index([subjectType, subjectId], map: "lecture_access_subject_lookup")
  /// Список allowlist'а одной лекции (используется в
  /// `GET /lectures/:id/access`, KS-3936 B01).
  @@index([lectureId], map: "lecture_access_lecture_lookup")
  @@map("lecture_access_grants")
}

/// KS-4008 / ADR-121 Phase 1 §7.3. Сообщение чата лекции.
/// Чат живёт в WS namespace `/live-analysis` (см. LiveAnalysisGateway).
/// Соседняя `ChatMessage` (привязана к `Game`) — другая сущность, не
/// трогаем (ADR-121 §7.5).
///
/// Soft-delete: `deletedAt + deletedById` (модератор), текст в БД
/// сохраняется в `text` (для аудита), на фронт раздаётся подмена
/// «[удалено]» (логика gateway, не БД).
///
/// `isTrainerMessage` — денормализация (`authorId === Lecture.ownerId`)
/// для фильтрации без join'ов на «только тренер» в Phase 2.
model LectureChatMessage {
  id                String                 @id @default(uuid()) @db.Uuid
  lectureId         String                 @map("lecture_id") @db.Uuid
  lecture           Lecture                @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  /// `null` — для анонимов (Phase 1: запрещено, но поле nullable как
  /// задел) и после `User.delete` (FK SetNull). UI рендерит как
  /// «Удалённый пользователь».
  authorId          String?                @map("author_id") @db.Uuid
  author            User?                  @relation("LectureChatAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Текст после trim, в диапазоне 1..500 unicode-codepoints.
  /// VARCHAR(500) на PG достаточно: даже emoji UTF-8 ≤ 4 байта × 500 = 2 KB.
  text              String                 @db.VarChar(500)
  /// `user` — обычное сообщение участника; `system` — служебное
  /// (закрепление, mute и т.п. Phase 2). MVP пишет только `user`.
  kind              LectureChatMessageKind @default(user)
  /// Денормализация: true ⇔ `authorId === Lecture.ownerId` в момент
  /// записи. Используется фильтрами «только от тренера» и стилизацией
  /// в ленте. Считается в gateway при persist, не в триггере БД.
  isTrainerMessage  Boolean                @default(false) @map("is_trainer_message")
  /// MVP Pin (Phase 1 уже отдаёт `pinnedId` в snapshot; кто и когда
  /// поставит — Phase 2). Уникальность «одно pinned на лекцию» —
  /// контракт сервиса, не constraint БД.
  pinned            Boolean                @default(false)
  /// Soft-delete: ставится тренером через `chat:delete`. Запись
  /// остаётся в БД; gateway раздаёт подмену «[удалено]».
  deletedAt         DateTime?              @map("deleted_at")
  deletedById       String?                @map("deleted_by_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at")

  /// Пагинация и snapshot: «последние N сообщений лекции в порядке
  /// createdAt». Используется `findMany({where:{lectureId}, orderBy:
  /// {createdAt:'desc'}, take:100})`.
  @@index([lectureId, createdAt])
  @@map("lecture_chat_messages")
}

enum LectureChatMessageKind {
  user
  system

  @@map("lecture_chat_message_kind")
}

/// KS-4008 / ADR-121 Phase 1 §5.3. Мьют ученика в чате текущей лекции.
/// Тренер выписывает через `chat:mute`. MVP: один мьют действует до
/// конца лекции (нет TTL); снять — Phase 2.
model LectureChatMute {
  id           String   @id @default(uuid()) @db.Uuid
  lectureId    String   @map("lecture_id") @db.Uuid
  lecture      Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation("LectureChatMutedUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Кто наложил мьют. Owner-only по контракту; FK Cascade — на случай
  /// удаления тренера сносится и его модерационная история по чату.
  mutedById    String   @map("muted_by_id") @db.Uuid
  mutedBy      User     @relation("LectureChatMutedBy", fields: [mutedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  /// Защита от дублей и быстрый lookup «muted ли userX в lectureY».
  @@unique([lectureId, userId])
  @@map("lecture_chat_mutes")
}


/// KS-4026 / ADR-122 §4. Кеш позиционных метрик Stockfish по полуходам
/// анализа. Одна запись на анализ (UNIQUE analysisId). UPSERT по
/// analysisId: при смене `sfVersion` (см. POSITIONAL_TRACE_VERSION в
/// shared) старая запись затирается новой без накопления версий.
///
/// Переезд с `GamePositionalTrace` (KS-4023): в реальном потоке
/// `openAnalysisFromPgn` создаёт новый Analysis под архивную партию,
/// `gameId` почти всегда отсутствует — поэтому ключ хранения теперь
/// `analysisId`.
///
/// `plies` — JSONB-массив `PositionalTracePly[]` (см. shared).
/// Размер тела ≤ 256 КБ — лимит на стороне валидатора NestJS (см.
/// PositionalTraceUpsertDto), на стороне БД ограничений нет: JSONB
/// + TOAST автоматически жмёт большие тела.
///
/// Cascade-delete от Analysis: запись бессмысленна без своего анализа.
model AnalysisPositionalTrace {
  id          String   @id @default(uuid()) @db.Uuid
  analysisId  String   @unique @map("analysis_id") @db.Uuid
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  /// Версия формата/движка SF-trace (ADR-107). При смене константы
  /// в shared старая запись становится «протухшей»: GET вернёт 404
  /// при несовпадении v, клиент пересчитает.
  sfVersion   String   @map("sf_version") @db.VarChar(64)

  /// PositionalTracePly[]: { ply, subterms: PositionalSubterm[], phase? }.
  plies       Json     @map("plies")

  /// Сколько занял расчёт у клиента (мс). Опционально, для аналитики
  /// и нагрузочных профилей.
  durationMs  Int?     @map("duration_ms")

  /// Кто запустил расчёт. SetNull при удалении пользователя — запись
  /// сохраняется (она привязана к анализу, не к пользователю).
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation("PositionalTraceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("analysis_positional_traces")
}

/// KS-4339 / ADR-135 §2.1. Новый банк tactic-пазлов на Maia-difficulty.
/// Полностью изолирован от `puzzles` (lichess + legacy generated PVE).
/// Триггер пазла — не зевок в партии, а позиция с единственным сильным
/// ходом, который трудно увидеть человеку уровня `maiaElo`. См.
/// `packages/shared/src/utils/tactic-puzzle-gen.ts` для алгоритма отбора.
model TacticPuzzle {
  id            String   @id @default(uuid()) @db.Uuid
  /// Стартовая FEN пазла. side-to-move в FEN = solver. `@unique` —
  /// один пазл на одну позицию, дубликаты при перегенерации игнорятся.
  fen           String   @unique
  /// UCI единственного сильного хода (решение пазла).
  bestMoveUci   String   @map("best_move_uci")
  /// side-to-move в `fen`. Денормализованный кэш — фронту удобно
  /// фильтровать пазлы по стороне, не парся FEN.
  solverSide    String   @map("solver_side")

  // Метрики качества (см. shared `TacticPuzzleCandidate`).
  /// Expected score лучшего хода на верифицирующем проходе.
  bestE         Float    @map("best_e")
  /// Expected score второго по силе хода на верифицирующем проходе.
  secondE       Float    @map("second_e")
  /// `bestE − secondE`. Дублируется как колонка для индекса по выборке.
  gap           Float
  /// `1 − Σ policy[strongSet]` по Maia на стартовой позиции.
  difficulty    Float
  /// WDL лучшего хода POV solver (per-mille, сумма ≈ 1000).
  wdlW          Int      @map("wdl_w")
  wdlD          Int      @map("wdl_d")
  wdlL          Int      @map("wdl_l")

  // KS-4370 / KS-4367. Поле `objective` удалено: семантика «реализуй
  // перевес / удержи равенство» оказалась ad-hoc эвристикой, не
  // отражённой в UI (см. пересмотр ADR-135 §2.3, коммит f8fa746).

  /// Drill-теги (pin/fork/skewer/...) через пробел. Без
  /// `reactive`/`preventive` — этих жанров в новом концепте нет.
  themes        String   @default("")

  // KS-4379 / KS-4375. Поля `rating`, `ratingDev`, `popularity`,
  // `nbPlays` удалены: рейтинг пазла как сущность убран (пересмотр
  // ADR-135 §2.1/§2.4, коммит d12cf9e). Подбор идёт по mistakes →
  // random, Glicko-апдейт пользователя — против фиксированного
  // Maia-3 (`OPPONENT_RATING=2400` в сервисе).

  // Источник партии.
  sourceGameId   String? @map("source_game_id") @db.Uuid
  sourceMoveNum  Int?    @map("source_move_num")
  sourceWhiteElo Int?    @map("source_white_elo")
  sourceBlackElo Int?    @map("source_black_elo")
  /// Seven Tag Roster + ELO. JSON по образцу `puzzles.source_metadata.headers`.
  sourceHeaders  Json?   @map("source_headers") @db.JsonB

  // Параметры алгоритма (для воспроизводимости и пересчёта).
  /// Версия алгоритма: `'maia-difficulty-v1'` для первой выкатки.
  /// Меняется при сдвиге порогов — позволяет фильтровать «старые»
  /// пазлы и при необходимости перегенерировать только их.
  algorithmVersion String @default("maia-difficulty-v1") @map("algorithm_version")
  maiaElo          Int    @map("maia_elo")
  sfMainNodes      Int    @map("sf_main_nodes")
  sfVerifyNodes    Int    @map("sf_verify_nodes")
  sfMultiPv        Int    @map("sf_multi_pv")

  createdAt        DateTime @default(now()) @map("created_at")

  attempts         TacticPuzzleAttempt[]
  mistakes         TacticUserMistake[]

  // KS-4379 / KS-4375. Индекс `(rating)` удалён вместе с колонкой.
  @@index([themes])
  @@index([difficulty])
  @@index([gap])
  // KS-4370 / KS-4367. Композитный индекс `(objective, rating)` удалён
  // вместе с колонкой.
  @@index([algorithmVersion])
  /// KS-4604. Каталог `/tactic-puzzles/browse` сортирует «свежие сверху»
  /// (KS-4603 — диагностика того, почему пользователь не видел новые
  /// задачи: UUID-сортировка размазывала их по всему пулу). Композит
  /// `(createdAt DESC, id DESC)` поддерживает основной keyset-курсор
  /// каталога — index range scan O(log N) даже при росте корпуса до
  /// сотен тысяч пазлов.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("tactic_puzzles")
}

/// KS-4339 / ADR-135 §2.1. Попытка пользователя по `tactic_puzzle`.
/// Длина решения переменная — клиент во время игры на каждом полуходе
/// пересчитывает сложность (см. `analyzePlyForTacticPuzzle` в shared).
/// Precision-метрики переехали сюда: двухтабличная схема
/// `PuzzleAttempt + PrecisionAttempt` была вынужденной из-за смеси
/// forced-line и PVE; здесь PVE — норма, отдельной таблицы не нужно.
model TacticPuzzleAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  puzzleId            String   @map("puzzle_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  solved              Boolean
  timeMs              Int      @map("time_ms")

  // Игровой рейтинг пользователя по разделу «Точность» (см. UserTacticRating).
  ratingBefore        Int      @map("rating_before")
  ratingAfter         Int      @map("rating_after")
  // KS-4379 / KS-4375. `puzzleRatingBefore` / `puzzleRatingAfter`
  // удалены вместе с рейтингом пазла.

  /// Длина решённой линии (число полуходов пользователя). Не известна
  /// заранее — определяется во время игры. Клиент на каждом полуходе
  /// проверяет сложность позиции по shared-модулю; пазл продолжается,
  /// пока |strongSet|=1 + difficulty > порога + gap ≥ порога.
  lineHalfMoves       Int      @map("line_half_moves")
  /// Все ходы пользователя через пробел (UCI). Длина переменная.
  userMoves           String?  @map("user_moves")
  /// Причина остановки пазла:
  ///   `'user-finished'` — пользователь сам нажал «завершить задачу»
  ///                       (доступно когда difficulty упала ниже порога);
  ///   `'user-skipped'`  — пользователь нажал «пропустить ход»
  ///                       (доступно когда difficulty упала ниже порога);
  ///   `'mate'`          — мат / пат на доске;
  ///   `'mistake'`       — пользователь сыграл не bestMove;
  ///   `'aborted'`       — закрыл страницу / явно прервал.
  stopReason          String   @map("stop_reason")

  // Precision-метрики (ADR-056 / ADR-065).
  wdlStart            Float?   @map("wdl_start")
  wdlEnd              Float?   @map("wdl_end")
  movesAccuracy       Float?   @map("moves_accuracy")
  /// 1..5 stars (KS-3744 / ADR-065).
  precisionGrade      Int?     @map("precision_grade")

  createdAt           DateTime @default(now()) @map("created_at")

  puzzle              TacticPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([puzzleId])
  @@index([userId, createdAt])
  @@index([userId, puzzleId, solved])
  @@map("tactic_puzzle_attempts")
}

/// KS-4339 / ADR-135 §2.1. Журнал ошибок для повтора («моя работа над
/// ошибками» в разделе /tactic-puzzles). По образцу `user_mistakes`,
/// но с FK Cascade — концепт «попытаться ещё раз» теряет смысл без
/// самого пазла.
model TacticUserMistake {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  puzzleId  String   @map("puzzle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  resolved  Boolean  @default(false)

  puzzle    TacticPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, puzzleId])
  @@index([userId, resolved])
  @@map("tactic_user_mistakes")
}

/// KS-4339 / ADR-135 §2.1. Рейтинг пользователя по разделу
/// «Точность» — изолированная Glicko-1 кривая. Структура полностью
/// копирует `UserPrecisionRating`: PK = `userId`, FK Cascade, поля
/// `rating/deviation/volatility/attempts/lastAttemptAt/updatedAt`.
///
/// Решение «отдельная таблица, не поле в users»:
///   * пять Glicko-полей на каждого пользователя — это раздувание
///     `users` ради подмножества активных в разделе пользователей
///     (большинство будет иметь NULL/дефолты);
///   * прецедент `UserPrecisionRating` (1:1 с User, onDelete Cascade)
///     уже работает для precision-attempts — следуем тому же паттерну
///     ради единообразия;
///   * `users` уже несёт `ratingPuzzle` (lichess) и `precisionRating`
///     (PVE); добавлять третий банк-специфичный рейтинг в users —
///     путать концепты;
///   * исторические снимки (TacticRatingSnapshot по образцу
///     `PuzzleRatingSnapshot`) при появлении логично FK на это таблице,
///     не на User напрямую.
model UserTacticRating {
  userId        String    @id @map("user_id") @db.Uuid
  rating        Float     @default(1500)
  /// Glicko RD. Большой RD (350) → высокая неопределённость, рейтинг
  /// двигается быстрее. После многих попыток сужается до ~50-100.
  deviation     Float     @default(350)
  /// Glicko-2 параметр (для будущего; в MVP используется Glicko-1
  /// continuous как у `UserPrecisionRating`).
  volatility    Float     @default(0.06)
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tactic_ratings")
}

/// KS-4354 / ADR-136 §3.6. Дневной снимок рейтинга пользователя в
/// разделе «Точность». Источник графика динамики рейтинга на
/// /tactic-puzzles/stats. Точка пишется ежедневным шедулером (одна
/// запись на пользователя в сутки — UNIQUE(userId, date)).
///
/// По образцу `puzzle_rating_snapshots` (ADR-082), отличия:
///   * `rating: Float` (а не Int) — UserTacticRating.rating тоже Float;
///   * FK на User с `onDelete: Cascade` — удаление пользователя
///     синхронно сносит его рейтинг-историю по «Точности».
model TacticRatingSnapshot {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  rating   Float
  date     DateTime @db.Date
  attempts Int      @default(0)
  solved   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("tactic_rating_snapshots")
}

/// KS-4406 / ADR-137 rev2. Авторы блога kingside.site/blog. Для MVP —
/// один сидовый автор `handle='kingside'`, при необходимости расширяется.
/// FK с `blog_posts.author_id` идёт через `onDelete: Restrict` — пост
/// без автора отображать нельзя, удаление автора должно явно
/// переподвешивать его статьи (или быть невозможным до миграции).
model BlogAuthor {
  id        String   @id @default(uuid()) @db.Uuid
  handle    String   @unique
  nameRu    String   @map("name_ru")
  nameEn    String   @map("name_en")
  avatarUrl String?  @map("avatar_url")
  bioRu     String?  @map("bio_ru")
  bioEn     String?  @map("bio_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt       @map("updated_at") @db.Timestamptz(3)

  posts BlogPost[]

  @@map("blog_authors")
}

/// KS-4406 / ADR-137 rev2. Публикация блога. Источник правды — БД,
/// а не markdown-файлы во фронте (rev2 пересмотр; см. коммит архитектора
/// 96d5480 и task KS-4406). Поля:
///   * `body_md` — исходный Markdown (редактируется через admin-эндпоинт);
///   * `body_html` — кэш HTML после рендера unified+rehype-sanitize, для
///     быстрой отдачи /blog/<slug> без рендера на лету;
///   * `tags` — массив тегов, индекс GIN для поиска;
///   * `related_route` — опц. ссылка на связанный раздел (например
///     `/lectures/<id>`), отрисовывается как «По теме» под постом;
///   * `status='draft'|'published'` — публикации только публичные;
///   * `published_at` — момент первой публикации (используется для
///     sitemap-lastmod и сортировки списка).
model BlogPost {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String
  /// `'ru'` | `'en'`. UNIQUE(`slug`, `locale`) даёт один пост на язык.
  locale          String
  title           String
  description     String
  bodyMd          String    @map("body_md")
  bodyHtml        String    @map("body_html")
  coverUrl        String?   @map("cover_url")
  coverAlt        String?   @map("cover_alt")
  tags            String[]
  relatedRoute    String?   @map("related_route")
  readingTimeMin  Int       @map("reading_time_min")
  /// `'draft'` | `'published'`. На публичные эндпоинты пускаются только
  /// `'published'`.
  status          String
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)
  authorId        String    @map("author_id") @db.Uuid
  /// KS-4467 / ADR-140 §2.1. Денормализованные счётчики — для быстрой
  /// отдачи карточек ленты и страницы статьи без агрегатов. Источник
  /// правды — детальные таблицы `blog_post_likes` / `blog_post_comments`
  /// и Redis-дедупа просмотров (см. §2.2). Счётчики синхронизируются в
  /// той же транзакции, что и запись детали; просмотры — атомарный
  /// `UPDATE views_count = views_count + 1` после успешного дедупа.
  /// T7-cron раз в сутки пересчитывает `likes_count`/`comments_count`
  /// из COUNT(*), выправляя возможный дрейф после сбоев.
  viewsCount      Int       @default(0) @map("views_count")
  likesCount      Int       @default(0) @map("likes_count")
  commentsCount   Int       @default(0) @map("comments_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt       @map("updated_at") @db.Timestamptz(3)
  /// KS-4740. Метка «broadcast-notification уже разослано подписчикам
  /// колокольчика на этот пост». Используется для идемпотентности:
  /// повторная публикация (edit→re-publish) или второй updatePost со
  /// `status='published'` не плодит дубли в Notification. Сбрасывается
  /// только вручную (если потребуется заново оповестить).
  publishedNotificationSentAt DateTime? @map("published_notification_sent_at") @db.Timestamptz(3)

  author   BlogAuthor        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  likes    BlogPostLike[]
  comments BlogPostComment[]

  @@unique([slug, locale])
  /// Сортировка ленты /blog: WHERE status='published' ORDER BY published_at DESC.
  @@index([status, publishedAt(sort: Desc)])
  @@index([slug])
  /// GIN-индекс для поиска по тегам — `WHERE tags @> ARRAY[...]`.
  @@index([tags], type: Gin)
  @@map("blog_posts")
}

/// KS-4467 / ADR-140 §2.1. Лайк статьи блога. Один пользователь — один
/// лайк на одну `BlogPost`-запись (по `post_id`). Лайки независимы между
/// локалями: `post_id` указывает на конкретную локализованную статью
/// (RU или EN); при переключении локали пользователь увидит её без
/// своего лайка. Это сохраняет симметрию со счётчиками просмотров и
/// комментариев — все три привязаны к (slug, locale).
///
/// `@@id([postId, userId])` — естественный составной ключ, исключает
/// дубль на уровне БД и используется при идемпотентной вставке
/// `INSERT ... ON CONFLICT DO NOTHING` (T4).
///
/// Индекс `@@index([userId])` — под будущий list «лайкнутые мной»:
/// `SELECT post_id FROM blog_post_likes WHERE user_id = $1 ORDER BY created_at DESC`.
model BlogPostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("blog_post_likes")
}

/// KS-4467 / ADR-140 §2.1. Комментарий к статье блога. MVP — плоская
/// лента (без вложенных ответов). Привязка к конкретной (slug, locale):
/// комментаторы пишут в той локали, которую читают.
///
/// Soft-delete через `deleted_at`: запись остаётся, чтобы не сбивать
/// курсорную пагинацию и порядок ленты; текст в API заменяется
/// плейсхолдером. Жёсткий `DELETE` не используется.
///
/// `onDelete` для `post` — Cascade (если статью сносят, комментарии
/// теряют смысл); для `user` — Restrict (нельзя удалить пользователя с
/// комментариями без явной обработки, см. ADR-140 §2.1).
///
/// Длина `body` валидируется на уровне сервиса (минимум 1, максимум
/// 2000 символов в MVP) — БД хранит произвольный TEXT, чтобы не
/// привязываться к лимиту на схему миграцией.
///
/// Индекс `@@index([postId, createdAt(Desc), id(Desc)])` — под cursor-
/// пагинацию `(createdAt, id)` без tie-breaker'а: id выступает
/// стабильным разрешением одинаковых createdAt (UUID v4 уникальны).
model BlogPostComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt       @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId])
  @@map("blog_post_comments")
}

/// KS-4453 / ADR-139. Сервисный аккаунт агента (системного, не
/// человеческого) для machine-to-machine API-доступа. Используется
/// гардом `ServiceAccountGuard` (T2): клиент шлёт `Authorization:
/// Bearer <plainToken>`, гард считает sha256, ищет запись по
/// `tokenHash`, проверяет `revokedAt IS NULL` и подходящий scope.
///
/// `tokenHash` — sha256 от plain-токена (никогда не храним plain в БД).
/// Уникальность не объявлена: уникален `handle`, токен можно ротировать
/// (старый аккаунт переписывает `tokenHash`); шанс sha256-коллизии
/// между двумя живыми токенами игнорируем. Индекс по `tokenHash` для
/// O(log n)-lookup на каждом запросе.
model AgentServiceAccount {
  id          String    @id @default(uuid()) @db.Uuid
  /// Стабильный идентификатор аккаунта: 'agent-backend',
  /// 'agent-content', 'agent-qa' и т. п. UNIQUE — один handle =
  /// один аккаунт; ротация токена не меняет handle.
  handle      String    @unique
  /// Человекочитаемое назначение для админ-UI / аудита.
  description String?
  /// sha256(hex) от plain-токена. Plain виден ровно один раз — при
  /// выдаче через админ-CLI (T4).
  tokenHash   String    @map("token_hash")
  /// Список scope-строк формата `<resource>:<action>` или
  /// `<resource>:*`. Дефолт — пустой массив (нет прав).
  scopes      String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Обновляется гардом при каждом успешном запросе (best-effort
  /// fire-and-forget, не блокирует основной запрос).
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Отзыв доступа. Не-null → гард сразу 401, без проверки scope.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([tokenHash])
  @@map("agent_service_accounts")
}

/// KS-4880 / ADR-160 §3, KS-4927 / ADR-163 §3. Тренировка (именованный
/// план занятий). У пользователя до 5 тренировок (лимит в сервисе);
/// дни/время вынесены в StudyScheduleSlot (1..7 на тренировку).
/// Таймзона одна на тренировку, слоты наследуют.
model StudySchedule {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// KS-4927 / ADR-163 §2: имя тренировки (до 60 символов).
  name           String   @default("Занятие")
  timezone       String
  sessionMinutes Int      @default(30) @map("session_minutes")
  /// Долгосрочный фокус плана: tactics|openings|endgames|balanced.
  focus          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]
  slots    StudyScheduleSlot[]

  @@index([userId])
  @@index([active])
  @@map("study_schedules")
}

/// KS-4927 / ADR-163 §3. Временной диапазон тренировки: дни недели
/// (0=вс…6=сб) + локальное время (HH:mm). `sessionMinutes` — оверрайд
/// длительности занятия (null → наследует тренировку).
model StudyScheduleSlot {
  id             String   @id @default(uuid()) @db.Uuid
  scheduleId     String   @map("schedule_id") @db.Uuid
  daysOfWeek     Int[]    @map("days_of_week")
  timeLocal      String   @map("time_local")
  sessionMinutes Int?     @map("session_minutes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  schedule StudySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("study_schedule_slots")
}

/// KS-4880 / ADR-160 §3. Сгенерированное занятие. `profileSnapshot` —
/// входы генератора на момент сборки (отладка + «почему мне это
/// назначили»). Статусы: planned|notified|in_progress|completed|expired.
model StudySession {
  id              String    @id @default(uuid()) @db.Uuid
  scheduleId      String    @map("schedule_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  scheduledAt     DateTime  @map("scheduled_at") @db.Timestamptz(3)
  status          String    @default("planned")
  profileSnapshot Json?     @map("profile_snapshot")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// KS-4910 / ADR-162 §2.1: урок занятия в скрытом персональном курсе.
  /// Без FK — урок чистится ротацией (30 дней), сессия остаётся историей.
  lessonId        String?   @map("lesson_id") @db.Uuid
  /// KS-4910 / ADR-162 §5: score завершённого урока 0-100 — вход
  /// адаптации следующего занятия.
  score           Int?

  schedule      StudySchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks         StudyTask[]
  notifications StudyNotification[]

  /// Диспетчер: scheduled_at <= now AND status='planned' (ADR-160 §4).
  @@index([status, scheduledAt])
  @@index([userId, scheduledAt(sort: Desc)])
  /// KS-4881: идемпотентность генератора — один слот = одно занятие.
  @@unique([scheduleId, scheduledAt])
  @@map("study_sessions")
}

/// KS-4880 / ADR-160 §3. Задание внутри занятия. `params` — JSONB,
/// состав различается по типам (тема, рейтинг-окно, lessonId, count,
/// timeControl…), отдельные таблицы на тип избыточны.
/// type: puzzle_theme|sm2_review|lesson|mistakes|precision|drill|
/// rated_game|game_review|puzzle_rush|external_games.
/// status: pending|partial|done|skipped.
model StudyTask {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  position    Int
  type        String
  params      Json?
  targetCount Int       @default(1) @map("target_count")
  doneCount   Int       @default(0) @map("done_count")
  status      String    @default("pending")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  /// KS-4910 / ADR-162 §2.1: main (урок занятия) | homework (§5).
  role        String    @default("main")

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, position])
  @@map("study_tasks")
}

/// KS-4880 / ADR-160 §3-4. Канал доставки уведомлений о занятиях.
/// type: telegram|email|onsite. `address` — chat_id для telegram,
/// email для почты, NULL для onsite. `verifiedAt IS NULL` — канал не
/// подтверждён (telegram подтверждается /start-токеном, см. deep-link
/// t.me/<bot>?start=<token>). onsite verified сразу при создании.
model NotificationChannel {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  address    String?
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyNotifications StudyNotification[]

  /// Один канал каждого типа на пользователя (v1: без мульти-адресов).
  @@unique([userId, type])
  @@map("notification_channels")
}

/// KS-4880 / ADR-160 §3-4. Журнал отправки уведомления о занятии в
/// конкретный канал. status: sent|failed; `error` — текст ошибки
/// канала для ретраев диспетчера (максимум 3, затем onsite-fallback).
model StudyNotification {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  status    String
  error     String?
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  session StudySession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("study_notifications")
}

/// KS-4880 / ADR-160 §3, §5.2. Ежедневный снимок внешней активности
/// (lichess/chess.com) для пользователей с активным расписанием.
/// `ratings` — JSONB по категориям. Уникальность user+provider+date —
/// повторный прогон крона перезаписывает, не дублирует.
model ExternalActivitySnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String
  date        DateTime @db.Date
  gamesPlayed Int      @default(0) @map("games_played")
  ratings     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, date])
  @@map("external_activity_snapshots")
}

/// KS-4941 / ADR-164 rev3 §2.3. Серверный преразбор позиции: очередь
/// и готовые тексты «разбора с вариантами». Разбор делает модель
/// webhook (агент с инструментами Maia/Stockfish в своём окружении),
/// сервер хранит результат и раздаёт его всем через
/// GET /analyses/position/review. Одна запись = одна (позиция, язык).
/// `probeTrace` — лог прогонов из ответа модели (аудит правила
/// «ни одного хода в тексте без прогона») + флаги легальности линий.
model AiPositionReview {
  id               String    @id @default(uuid()) @db.Uuid
  /// Поля 1-4 FEN (расстановка, ход, рокировки, en passant).
  fenNormalized    String    @map("fen_normalized")
  /// Полный FEN, как пришёл из источника (для запуска движков).
  fen              String
  language         String
  /// daily_puzzle | manual
  source           String
  /// queued | processing | done | failed
  status           String    @default("queued")
  comment          String?   @db.Text
  /// { highlights: [...], arrows: [...] } — шейп ADR-108.
  highlightsArrows Json?     @map("highlights_arrows")
  /// Лог прогонов модели + серверные пометки легальности линий.
  probeTrace       Json?     @map("probe_trace")
  webhookCalls     Int       @default(0) @map("webhook_calls")
  /// Причина failed (диагностика).
  error            String?
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([fenNormalized, language])
  @@index([status, createdAt])
  @@map("ai_position_reviews")
}
