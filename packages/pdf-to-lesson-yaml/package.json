{
  "name": "@kingside/pdf-to-lesson-yaml",
  "version": "0.0.1",
  "private": true,
  "description": "CLI и API для конвертации PDF-учебников в черновые YAML-файлы lesson-формата (KS-2015). KS-2045: Этап 1 — Chess-Merida text+diag extractor (PyMuPDF + @kingside/board-image-to-fen, без распознавания PGN — это Этап 2).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pdf-to-lesson-yaml": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/python",
    "schema",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@kingside/board-image-to-fen": "*",
    "@kingside/lesson-import": "*",
    "@kingside/lesson-schema": "*",
    "chess.js": "^1.4.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.5",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
