{
  "name": "@kingside/maia-core",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js",
      "default": "./dist/browser.mjs"
    },
    "./node-provider": {
      "types": "./dist/node-provider.d.ts",
      "import": "./dist/node-provider.js",
      "require": "./dist/node-provider.js",
      "default": "./dist/node-provider.js"
    }
  },
  "scripts": {
    "build": "tsc && esbuild src/browser.ts --bundle --format=esm --platform=browser --external:chess.js --external:@kingside/shared --outfile=dist/browser.mjs",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@kingside/shared": "*",
    "chess.js": "^1.4.0"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.20.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "onnxruntime-web": "^1.20.0",
    "vitest": "^4.0.18"
  }
}
