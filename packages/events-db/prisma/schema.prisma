// KS-4691 / ADR-147 §2.3. Prisma-схема пакета `events-db`. Источник —
// та же физическая БД `kingside-db`, что для основного приложения, но
// **отдельная схема `events`** (см. KS-4690 / scripts/sql/events-schema-init.sql).
// Отдельный PrismaClient нужен по двум причинам:
//   1. Логическая изоляция: модель append-only лога не должна
//      «протекать» в основной DataModel `apps/api`. Отдельный клиент
//      = отдельный набор типов и `package.json` зависимостей.
//   2. Отдельный пользователь подключения (`events_writer`,
//      KS-4690 §3) с минимальными правами (`USAGE` на schema events,
//      `INSERT|SELECT` через default privileges). Тот же URL, но
//      другие credentials.
//
// DATABASE_URL формата `postgresql://events_writer:<pass>@host:5432/
// kingside?schema=events&sslmode=require`. Локально — то же без SSL,
// см. README.md этого пакета.

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("EVENTS_DATABASE_URL")
  schemas  = ["events"]
}

/// KS-4691 / ADR-147 §2.3. Append-only лог действий actor'ов (user или
/// guest). На уровне Postgres создаётся как:
///
///   CREATE TABLE events.actor_events (...) PARTITION BY RANGE (created_at)
///
/// и управляется `pg_partman` (weekly partitions, retention 90 дней,
/// см. миграцию `20260627170000_init`). Композитный PK `(id, createdAt)`
/// обязателен: pg_partman требует partition-key в PK для native
/// partitioning. На декларативном уровне это `@@id([id, createdAt])`.
///
/// Композитный индекс `(actor_id, type, created_at desc)` —
/// «рабочий» индекс правил HintsEngine (ADR-147 §2.3); живёт на
/// template-таблице pg_partman и автоматически наследуется каждой
/// новой партицией.
///
/// `actor_type` намеренно НЕ входит в индекс — селективность даёт сам
/// `actor_id` (UUID), а при guest→user merge (§1.1) и `actor_id` и
/// `actor_type` обновляются одной транзакцией.
///
/// `payload` хранит небольшой JSON по §2.1 — без GIN-индекса (нет
/// правил, которые фильтруют по полю payload). Поле объявлено как
/// `Json` (не `JsonB`-специфический тип Prisma — она маппит `Json` в
/// `jsonb` для PostgreSQL по умолчанию).
model ActorEvent {
  id        BigInt   @default(autoincrement())
  /// user_id для actor_type='user', guest_id для actor_type='guest'.
  actorId   String   @map("actor_id") @db.Uuid
  /// 'user' | 'guest'. varchar(8) — узко, чтобы не съедать индекс.
  actorType String   @map("actor_type") @db.VarChar(8)
  type      String   @db.VarChar(64)
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([id, createdAt])
  @@index([actorId, type, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("actor_events")
  @@schema("events")
}

/// KS-4699 / ADR-147 §3.1. Декларативное правило показа контекстной
/// подсказки. Содержит i18n-тексты, anchor/placement, DSL `rule`,
/// targetActorTypes (user/guest filter), глобальные per-hint лимиты.
///
/// Soft-delete через `deletedAt` — админ-CRUD (T12) использует.
model Hint {
  id               String   @id @default(uuid()) @db.Uuid
  /// Стабильный человекочитаемый ключ для аналитики/метрик.
  /// Например `analyze-your-game`, `guest-register-prompt`.
  key              String   @unique @db.VarChar(64)
  /// `{ ru: {title, body, ctaLabel}, en: {...} }`. См. ADR §3.1.
  i18n             Json     @db.JsonB
  /// `{href?, event?}` либо null — клиентский CTA. Совпадает с
  /// `HintShowPayload.ctaHref/ctaEvent` (T7).
  cta              Json?    @db.JsonB
  /// Значение `data-hint-anchor` из shared enum HINT_ANCHORS (T7).
  anchor           String   @db.VarChar(64)
  /// 'top'|'bottom'|...'bottom-sheet'. См. HintPlacement (T7).
  placement        String   @db.VarChar(16)
  /// DSL §3.2 — `{all|any|not|page|count|exists|timeSince|actorType}`.
  rule             Json     @db.JsonB
  priority         Int      @default(0)
  enabled          Boolean  @default(true)
  /// Список event_type для smart-dismiss (§5.1). При наступлении
  /// одного из них в `smart_dismiss_window_hours` после показа —
  /// actedAt автоматом.
  acceptedBy       String[] @map("accepted_by") @db.VarChar(64)
  /// `['user']`, `['guest']`, `['user','guest']`. Фильтр до DSL.
  targetActorTypes String[] @map("target_actor_types") @db.VarChar(8) @default(["user", "guest"])
  cooldownSec      Int      @default(86400) @map("cooldown_sec")
  ttlSec           Int      @default(0) @map("ttl_sec")
  maxShows         Int      @default(3) @map("max_shows")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  /// KS-4699: soft-delete. `IS NULL` — активная запись, иначе
  /// исключается из выборки HintsService.
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  states           ActorHintState[]

  @@index([enabled, deletedAt])
  @@map("hints")
  @@schema("events")
}

/// KS-4699 / ADR-147 §3.1. Состояние подсказки для конкретного actor'а
/// (user или guest). Композитный PK `(actor_id, hint_id)` —
/// одна запись на пару actor+hint. При guest→user merge `actor_id` и
/// `actor_type` обновляются `analytics-data.service.mergeGuestToUser`
/// (см. T4 hook).
model ActorHintState {
  actorId         String    @map("actor_id") @db.Uuid
  actorType       String    @map("actor_type") @db.VarChar(8)
  hintId          String    @map("hint_id") @db.Uuid
  shownCount      Int       @default(0) @map("shown_count")
  lastShownAt     DateTime? @map("last_shown_at") @db.Timestamptz()
  /// KS-4788 / ADR-151. Client-confirmed render (POST /hints/:id/shown
  /// или /ignored). Сравнивается с `lastShownAt` в HintsService.replayPending:
  /// `shownAckAt IS NULL OR shownAckAt < lastShownAt` → есть пропущенный emit.
  shownAckAt      DateTime? @map("shown_ack_at") @db.Timestamptz()
  dismissedAt     DateTime? @map("dismissed_at") @db.Timestamptz()
  actedAt         DateTime? @map("acted_at") @db.Timestamptz()
  suppressedUntil DateTime? @map("suppressed_until") @db.Timestamptz()
  /// KS-4825 / ADR-154 §2.2. Снимок готового `HintShowPayload` после
  /// серверной подстановки `{{var}}` в момент primary emit. Используется
  /// `HintsService.replayPending` (ADR-151) — клиент на reconnect
  /// получает ТОТ ЖЕ payload, что упустил, а не пересборку
  /// `toShowPayload` (там нет триггера). NULL для строк, созданных
  /// до миграции — fallback на `toShowPayload(hint, locale)` в коде.
  lastShownPayload Json?    @map("last_shown_payload") @db.JsonB

  hint            Hint      @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@id([actorId, hintId])
  @@index([actorId, suppressedUntil])
  @@map("actor_hint_states")
  @@schema("events")
}
