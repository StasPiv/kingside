generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("ARCHIVE_DATABASE_URL")
}

model ArchiveSource {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  name           String
  kind           String
  url            String?
  enabled        Boolean   @default(true)
  schedule       String?
  cursor         String?
  lastRunAt      DateTime? @map("last_run_at")
  lastSuccessAt  DateTime? @map("last_success_at")
  lastError      String?   @map("last_error") @db.Text
  totalGames     Int       @default(0) @map("total_games")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  imports ArchiveImport[]
  games   ArchiveGame[]

  @@map("archive_sources")
}

model ArchiveImport {
  id             String    @id @default(uuid()) @db.Uuid
  sourceId       String    @map("source_id") @db.Uuid
  status         String    @default("pending") // pending, running, success, failed
  fileName       String?   @map("file_name")
  cursorBefore   String?   @map("cursor_before")
  cursorAfter    String?   @map("cursor_after")
  gamesParsed    Int       @default(0) @map("games_parsed")
  gamesAdded     Int       @default(0) @map("games_added")
  gamesSkipped   Int       @default(0) @map("games_skipped")
  error          String?   @db.Text
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  source ArchiveSource @relation(fields: [sourceId], references: [id])
  games  ArchiveGame[]

  @@index([sourceId])
  @@index([status])
  @@map("archive_imports")
}

model ArchiveGame {
  id           String    @id @default(uuid()) @db.Uuid
  sourceId     String    @map("source_id") @db.Uuid
  importId     String?   @map("import_id") @db.Uuid
  contentHash  Bytes     @unique @map("content_hash")
  event        String?
  site         String?
  round        String?
  date         String?
  playedAt     DateTime? @map("played_at")
  whiteName    String?   @map("white_name")
  blackName    String?   @map("black_name")
  whiteElo     Int?      @map("white_elo")
  blackElo     Int?      @map("black_elo")
  whiteTitle   String?   @map("white_title")
  blackTitle   String?   @map("black_title")
  result       String?
  eco          String?
  opening      String?
  plyCount     Int?      @map("ply_count")
  pgn          String    @db.Text
  finalFen     String?   @map("final_fen")
  timeControl  String?   @map("time_control")
  /// KS-2118: упрощённая категория для индекса/фильтра — `bullet|blitz|rapid|classical|unknown`.
  /// CHECK-ограничение и B-tree индекс заводятся миграцией
  /// `20260429000000_archive_games_time_control_category`.
  timeControlCategory String? @map("time_control_category")
  category     String    @default("unknown")
  isClassical  Boolean   @default(false) @map("is_classical")
  createdAt    DateTime  @default(now()) @map("created_at")

  source ArchiveSource  @relation(fields: [sourceId], references: [id])
  import ArchiveImport? @relation(fields: [importId], references: [id])

  @@index([eco, playedAt(sort: Desc)])
  @@index([whiteName, blackName])
  @@index([playedAt(sort: Desc)])
  // KS-2120: индекс `archive_games_source_id_played_at_idx` удалён —
  // pg_stat_user_indexes показал idx_scan=0. Все запросы фильтруют только
  // по `played_at` (см. `archive_games_played_at_idx` выше) или используют
  // metadata-фильтры, которые не сочетаются с `source_id`. Вернуть, если
  // появится оперативная задача «партии этого источника за дату».
  @@index([timeControlCategory], name: "archive_games_time_control_category_idx")
  // KS-2138 фаза 4: композитные индексы под `MetadataSqlBuilder.itemsSql`
  // — фильтр по time_control_category + ORDER BY played_at DESC, id DESC.
  // Без них planner делал Parallel Seq Scan на 330K строк / 760 МБ
  // (Execution Time 5.6 сек на cold cache db.t3.micro).
  @@index([timeControlCategory, playedAt(sort: Desc), id(sort: Desc)], name: "archive_games_tcc_played_at_id_idx")
  @@index([playedAt(sort: Desc), id(sort: Desc)], name: "archive_games_played_at_id_idx")
  @@map("archive_games")
}

model PositionStats {
  positionKey Bytes     @map("position_key")
  nextMoveUci String    @map("next_move_uci")
  bucket      String    @default("master")
  whiteWins   Int       @default(0) @map("white_wins")
  draws       Int       @default(0)
  blackWins   Int       @default(0) @map("black_wins")
  total       Int       @default(0)
  avgElo      Int?      @map("avg_elo")
  lastSeenAt  DateTime? @map("last_seen_at")
  ply         Int?

  @@id([positionKey, nextMoveUci, bucket])
  @@index([positionKey, bucket, total(sort: Desc)])
  @@index([ply])
  @@map("position_stats")
}

model ArchiveGamePosition {
  positionKey Bytes     @map("position_key")
  bucket      String
  gameId      String    @map("game_id") @db.Uuid
  ply         Int       @db.SmallInt
  moveUci     String?   @map("move_uci")
  sideToMove  String    @map("side_to_move") @db.Char(1)
  playedAt    DateTime? @map("played_at")
  avgElo      Int?      @map("avg_elo") @db.SmallInt
  result      String?   @db.Char(1)

  @@id([positionKey, bucket, gameId])
  // KS-2120: индекс `archive_game_positions_recent` удалён — 298 МБ,
  // idx_scan=0 (pg_stat_user_indexes). Сортировка `recent` для by-position
  // должна была пойти через PK `(position_key, bucket, game_id)` + heap
  // fetch, но в реальности pg_stat_statements (KS-2138/KS-2139) показал
  // 3079/3163 ms mean → возвращён в KS-2139 миграцией
  // `20260429050000_archive_game_positions_recent_idx` уже как
  // `(position_key, bucket, played_at DESC NULLS LAST, game_id DESC)`.
  //
  // ВАЖНО: Prisma `@@index` не поддерживает явное `NULLS LAST` в DDL —
  // только sort direction. Если добавить декларацию, при следующем
  // `prisma migrate dev` Prisma решит что индекс «отличается» (БД =
  // NULLS LAST, schema = default NULLS FIRST) и попытается дропнуть/
  // пересоздать. Поэтому декларация для `_recent_idx` НЕ добавлена
  // здесь — единственный источник правды — миграция SQL.
  @@index([positionKey, bucket, avgElo(sort: Desc), gameId(sort: Desc)], name: "archive_game_positions_top_elo")
  @@map("archive_game_positions")
}

// ─── Players & Events (KS-2064 / ADR-033 §4.4.1) ─────────────────────
//
// Нормализованные таблицы под FTS поиск имён и турниров. Заполняются
// one-shot backfill'ом и инкрементально после каждого успешного импорта
// TWIC issue. Источник правды для отображаемых форм — `archive_games`
// (поля `white_name`/`black_name`/`event`); таблицы ниже — производные
// агрегаты для FTS, ранжирования по `gamesCount` и автодополнения.
//
// GIN-индексы pg_trgm создаются raw-SQL миграцией (Prisma не выражает
// `gin_trgm_ops` декларативно).

model ArchivePlayer {
  id             String    @id @default(uuid()) @db.Uuid
  /// канонический slug, стабильный: "carlsen-magnus". URL-safe, lowercase.
  slug           String    @unique
  /// канонически отображаемое имя: "Carlsen, Magnus".
  nameCanonical  String    @map("name_canonical")
  /// нормализованная форма для матчинга: "carlsen magnus" (lower, без пунктуации, без диакритики).
  nameNormalized String    @map("name_normalized")
  /// все варианты как строка для GIN trgm. ", "-separated.
  nameAliases    String    @map("name_aliases") @db.Text
  gamesCount     Int       @default(0) @map("games_count")
  peakElo        Int?      @map("peak_elo")
  firstSeenAt    DateTime? @map("first_seen_at")
  lastSeenAt     DateTime? @map("last_seen_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // KS-2120: B-tree индекс `archive_players_name_normalized_idx` удалён —
  // idx_scan=0. FTS-поиск по `name_normalized` идёт через GIN trgm
  // (см. миграцию `20260428000001_archive_players_events_mv`), а точные
  // lookup'ы по name_canonical — через unique-индекс на `slug` (имя →
  // slug → запись). Plain B-tree не используется ни одним запросом.
  // KS-2138 фаза 4: индекс на `name_canonical` ВЕРНУЛИ — JOIN из
  // `MetadataSqlBuilder.itemsSql` (`pw.name_canonical = g.white_name`,
  // `pb.name_canonical = g.black_name`) шёл Hash Join по большой
  // таблице. Это часть cold first-hit penalty в /games.
  @@index([gamesCount(sort: Desc)])
  @@index([nameCanonical], name: "archive_players_name_canonical_idx")
  @@map("archive_players")
}

model ArchiveEvent {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique
  nameCanonical  String    @map("name_canonical")
  nameNormalized String    @map("name_normalized")
  gamesCount     Int       @default(0) @map("games_count")
  /// Самая ранняя дата партий события — берётся из PGN-Date, формат сохраняется.
  firstDate      String?   @map("first_date")
  lastDate       String?   @map("last_date")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([gamesCount(sort: Desc)])
  @@map("archive_events")
}
