FROM node:20-slim

RUN apt-get update && apt-get install -y git curl wget procps unzip lsof \
    libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libxshmfence1 libxkbcommon0 libxfixes3 libxext6 \
    libx11-xcb1 libdrm2 libexpat1 \
    python3 python3-pip python3-opencv python3-numpy python3-pil python3-fitz \
    python3-cairosvg python3-psycopg2 \
    imagemagick djvulibre-bin ffmpeg \
    fonts-noto-core fonts-noto-color-emoji fonts-noto-cjk \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip \
    && curl -s "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_64bit/session-manager-plugin.deb" \
        -o /tmp/session-manager-plugin.deb \
    && dpkg -i /tmp/session-manager-plugin.deb && rm -f /tmp/session-manager-plugin.deb

RUN pip install --break-system-packages --no-cache-dir piper-tts chess \
    && mkdir -p /opt/piper-voices \
    && wget -q -O /opt/piper-voices/ru_RU-irina-medium.onnx \
        https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx \
    && wget -q -O /opt/piper-voices/ru_RU-irina-medium.onnx.json \
        https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx.json

# Stockfish 18 native — debian-bookworm даёт SF15.x, что для шахматных
# проверок недостаточно. AVX2 — оптимально для современных x86-64. sha256
# фиксирован, та же версия используется в apps/tactic-worker/Dockerfile.
ARG SF_VERSION=18
ARG SF_TARBALL=stockfish-ubuntu-x86-64-avx2.tar
ARG SF_SHA256=536c0c2c0cf06450df0bfb5e876ef0d3119950703a8f143627f990c7b5417964
RUN curl -fsSL -o /tmp/sf.tar \
        "https://github.com/official-stockfish/Stockfish/releases/download/sf_${SF_VERSION}/${SF_TARBALL}" \
    && echo "${SF_SHA256}  /tmp/sf.tar" | sha256sum -c - \
    && tar -xf /tmp/sf.tar -C /tmp \
    && install -D -m 0755 /tmp/stockfish/stockfish-ubuntu-x86-64-avx2 /usr/games/stockfish \
    && rm -rf /tmp/sf.tar /tmp/stockfish \
    && stockfish bench 2>&1 | tail -3

# Maia-3 engine для ai-review (KS-4941). Самодостаточный CJS-бандл
# (tools/maia-dist/maia.cjs, собран esbuild на хосте: всё кроме
# onnxruntime-web внутри) + ONNX-модель. Изоляция: движок в образе, не
# монтируется из репо. Врапер `maia` в PATH → используй как
# `maia --fen "<FEN>" [--elo N] [--top K]`.
COPY tools/maia-dist/maia.cjs /opt/maia/maia.cjs
COPY apps/web/public/maia3/maia3_simplified.onnx /opt/maia/model.onnx
RUN cd /opt/maia && npm init -y >/dev/null 2>&1 && npm install --no-audit --no-fund onnxruntime-web \
    && printf '#!/bin/bash\nexec node /opt/maia/maia.cjs "$@"\n' > /usr/local/bin/maia \
    && chmod +x /usr/local/bin/maia \
    && maia --fen "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1" --top 1

RUN npm install -g @anthropic-ai/claude-code@latest

RUN useradd -m -s /bin/bash agent

USER agent
WORKDIR /project

ENTRYPOINT ["claude"]
