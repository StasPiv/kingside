FROM node:20-slim

RUN apt-get update && apt-get install -y git curl procps unzip lsof \
    libglib2.0-0 libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libxshmfence1 libxkbcommon0 libxfixes3 libxext6 \
    libx11-xcb1 libdrm2 libexpat1 \
    python3 python3-pip python3-opencv python3-numpy python3-pil python3-fitz \
    imagemagick stockfish \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/* \
    && curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscliv2.zip \
    && curl -s "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/ubuntu_64bit/session-manager-plugin.deb" \
        -o /tmp/session-manager-plugin.deb \
    && dpkg -i /tmp/session-manager-plugin.deb && rm -f /tmp/session-manager-plugin.deb

RUN npm install -g @anthropic-ai/claude-code

RUN useradd -m -s /bin/bash agent

USER agent
WORKDIR /project

ENTRYPOINT ["claude"]
