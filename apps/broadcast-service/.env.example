# broadcast-service env-переменные (ADR-021 §3, ADR-022 §3 — список после
# слияния broadcast-worker).
#
# Скопируй в `.env` и заполни. Defaults рассчитаны на dev-окружение.

# --- БД broadcasts_kingside (отдельная от основной) ---
# required в production. Dev-default согласован с devops dev-окружением
# (KS-1744): локальный postgres user=postgres, password=postgres,
# db=broadcasts_kingside. Создаёт devops через docker-compose / runbook.
BROADCASTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broadcasts_kingside

# --- Redis (общий для sync/gateway) ---
# Код использует REDIS_HOST + REDIS_PORT отдельно (а не REDIS_URL).
# Dev-default 6379 — стандартный redis-port; в проекте старая конвенция
# 6380 уйдёт после унификации с другими сервисами.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HTTP / CORS ---
# Comma-separated список допустимых origin'ов. В production required.
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
# Один из двух (PORT имеет приоритет), оба опциональны — default 3004.
PORT=3004
BROADCAST_SERVICE_PORT=3004

# --- Pinned-broadcasts (контроллер list / lifecycle) ---
BROADCAST_PINNED_MIN_ELO=2600
BROADCAST_PINNED_MIN_GAMES=4
BROADCAST_PINNED_UPCOMING_HOURS=48

# --- Sync-loop (ADR-022) ---
# KS-1700 Part A: после N пропусков в Lichess top-20 broadcast помечается
# isActive=false. 72 × 5 мин = 6 часов.
BROADCAST_STALE_CYCLES=72
# Kill switch sync-loop. В проде по умолчанию true (sync тикает в
# BroadcastSyncService). Выставить `false` — отключить sync без
# пересборки/рестарта образа.
BROADCAST_SYNC_ENABLED=true
