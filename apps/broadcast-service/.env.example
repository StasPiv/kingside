# broadcast-service env-переменные (ADR-021 §3, ADR-022 §3 — список после
# слияния broadcast-worker).
#
# Скопируй в `.env` и заполни. Defaults рассчитаны на dev-окружение.

# --- БД broadcasts_kingside (отдельная от основной) ---
# required в production. Dev-default согласован с devops dev-окружением
# (KS-1744): локальный postgres user=postgres, password=postgres,
# db=broadcasts_kingside. Создаёт devops через docker-compose / runbook.
BROADCASTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broadcasts_kingside

# --- Redis (общий для sync/gateway) ---
# Код использует REDIS_HOST + REDIS_PORT отдельно (а не REDIS_URL).
# Dev-default 6379 — стандартный redis-port; в проекте старая конвенция
# 6380 уйдёт после унификации с другими сервисами.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HTTP / CORS ---
# Comma-separated список допустимых origin'ов. В production required.
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
# Один из двух (PORT имеет приоритет), оба опциональны — default 3004.
PORT=3004
BROADCAST_SERVICE_PORT=3004

# --- Pinned-broadcasts (контроллер list / lifecycle) ---
BROADCAST_PINNED_MIN_ELO=2600
BROADCAST_PINNED_MIN_GAMES=4
BROADCAST_PINNED_UPCOMING_HOURS=48

# --- Sync-loop (ADR-022) ---
# KS-1700 Part A: после N пропусков в Lichess top-20 broadcast помечается
# isActive=false. 72 × 5 мин = 6 часов.
BROADCAST_STALE_CYCLES=72
# Kill switch sync-loop. В проде по умолчанию true (sync тикает в
# BroadcastSyncService). Выставить `false` — отключить sync без
# пересборки/рестарта образа.
BROADCAST_SYNC_ENABLED=true

# --- Lichess API auth (ADR-155 §2.1) ---
# Опционально. Personal API access token технического Lichess-аккаунта.
# Без токена — анонимный лимит ~800 запросов в час, с токеном — ~8000/ч.
# Scopes токена: пусто (используются только публичные broadcast-эндпоинты).
# Ротация раз в год или при подозрении на утечку.
LICHESS_API_TOKEN=

# --- Pending-heal (ADR-155 §2.4) ---
# Восстановление раундов, застрявших в pending: между PGN-опросами
# pinned-цикл проверяет метаданные раундов, чей startsAt в окне
# [-24 ч, +15 мин], и переводит их в ongoing, когда Lichess это подтвердит.
# Kill-switch: false — отключить фазу без пересборки.
BROADCAST_PENDING_HEAL_ENABLED=true
# Верхний потолок числа metadata-проверок за один pinned-цикл.
BROADCAST_MAX_PENDING_CHECKS=10

# --- Полный синк: квота на refreshNonTop20 (ADR-156 §2.1) ---
# Верхний потолок числа metadata-проверок non-top-20 раундов за один
# syncBroadcasts-цикл. Полный обход всех non-top-20 раундов растянут
# через Redis-cursor на несколько циклов. Default 50 → ~75 сек на фазу
# (при 1.5 сек rate-limit на запрос). При ~1200 раундах полный обход
# занимает ~25 циклов = 2 часа.
BROADCAST_MAX_ROUND_METADATA_CHECKS=50

# --- Надёжность стримов (KS-4842) ---
# Сторожевой таймер: если очередной байт не пришёл дольше N сек,
# broadcast-service сам закрывает соединение. Lichess отправляет данные
# по стриму часто, молчание >60 сек — уверенный сигнал зависания.
BROADCAST_STREAM_WATCHDOG_TIMEOUT_SEC=90
# Плановое пересоздание всех активных стримов раз в M минут. Страхует от
# накопленных «зависших» состояний, которые не поймал ни watchdog, ни
# TCP-keepalive.
BROADCAST_STREAM_ROTATION_INTERVAL_MIN=10

# --- Приоритизация стримов по зрителям (KS-4846 / ADR-157) ---
# Физический потолок Lichess на broadcast-подписки для user-аккаунта.
# Раньше был 50 (избыточно, лишний расход на undici + гарантированные
# 429 после 8-го). См. Lichess changelog апрель 2026 (commit fbb6b38).
BROADCAST_MAX_STREAMS=8
# Соотношение зрителей, при котором кандидат вытесняет действующий стрим
# (§2.5). При 1.5× — уверенная разница интереса; при 1.1× — шум трепает.
BROADCAST_STREAM_HYSTERESIS_RATIO=1.5
# Минимум удержания стрима после старта в секундах (§2.6). 10 мин
# защищает от переключений при стартовом шуме зрителей.
BROADCAST_STREAM_HOLD_SECONDS=600
# Учащённый PGN-опрос для «выпавших с зрителями» — раундов ongoing без
# стрима, но с subs >= 1 (§2.7). Тик и cap. 30 сек = на порядок быстрее
# слоу-round-robin (5 мин).
BROADCAST_FAST_POLL_INTERVAL_MS=30000
BROADCAST_MAX_FAST_POLLS=20
