node_modules
# Keep environment variables out of version control
.env

/src/generated/prisma

# KS-3709: запечённые board-recognition модели скачивает deploy-скрипт
# devops в .bake-cache/ перед docker build. Сами .onnx-файлы в git не
# нужны, но каталог должен существовать (для `COPY apps/api/.bake-cache/`
# в Dockerfile) — храним только .keep.
.bake-cache/*
!.bake-cache/.keep

# KS-4773: tsconfig.sandbox.json генерируется scripts/dev-sandbox.js
# на каждый запуск с outDir из env API_DIST_DIR.
tsconfig.sandbox.json
