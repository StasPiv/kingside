{
  "name": "@kingside/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "npm run seed:lessons:lint && eslint src/",
    "seed:lessons": "npx ts-node src/lessons/seed/seed-lessons.ts",
    "seed:lessons:lint": "npx ts-node src/lessons/seed/lint-lessons.ts",
    "seed:sample-puzzles": "npx ts-node src/lessons/seed/seed-sample-puzzles.ts",
    "seed:screenshot": "node dist/scripts/seed-screenshot-account.js",
    "index:tactic-drills": "node dist/scripts/index-tactic-drills.js",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "prisma:generate": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../packages/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../../packages/db/prisma/schema.prisma",
    "import:lesson": "npx ts-node src/lessons/admin/import-yaml-cli.ts",
    "import:puzzles": "npx ts-node src/puzzle/import-puzzles.ts",
    "scan:chess-results": "node dist/broadcast/chess-results/scan-chess-results.js",
    "drill:validate": "npx ts-node src/scripts/validate-drill-positions.ts",
    "drill:validate:bundle": "esbuild src/scripts/validate-drill-positions.ts --bundle --platform=node --target=node20 --format=cjs --outfile=/tmp/kingside-tools/validate-drill.js",
    "backfill:precision-score": "npx ts-node src/scripts/backfill-precision-score.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-ecs": "^3.700.0",
    "@kingside/db": "*",
    "pg": "^8.13.1",
    "@kingside/shared": "*",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/schedule": "^6.1.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@nestjs/websockets": "^11.1.16",
    "@prisma/client": "^6.19.2",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^6.0.0",
    "chess.js": "^1.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.0",
    "js-yaml": "^4.1.0",
    "nestjs-i18n": "^10.6.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "jest": "^30.2.0",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0"
  }
}
