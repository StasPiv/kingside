DATABASE_URL="postgresql://kingside:kingside@localhost:5432/kingside"

REDIS_HOST=localhost
REDIS_PORT=6380

PORT=3001

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DEV_BYPASS_SECRET=

# KS-1962/B-1: whitelist email-ов для admin API (/lessons/admin/*).
# CSV, case-insensitive. Пустая/не задана — все запросы → 403.
LESSON_ADMIN_EMAILS=

# KS-2108: whitelist username-ов админ-страницы feature flags.
KS_ADMIN_USERS=

# KS-2182 (ADR-034-v2 §2, §8.2). Shared-secret для `/api/internal/*`
# endpoint'ов synthetic-bot-service. Должен совпадать с тем же ключом в
# `apps/synthetic-bot-service`. В prod — SSM SecureString, 32 байта
# random. Пустая/не задана — InternalKeyGuard отвергает все запросы.
SYNTHETIC_BOT_INTERNAL_KEY=

# OAuth (опционально)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# Telegram bot (опционально, для login через Telegram)
TELEGRAM_BOT_TOKEN=

# KS-2952 (ADR-061 §6). Shared-secret для GET /_mcp/tools — каталог
# MCP-эндпоинтов для веб-ассистента (`mcp-kingside.mjs` ходит с
# заголовком `X-Mcp-Discovery-Key`). В dev (NODE_ENV != production)
# guard разрешает запрос без ключа; в prod — пустая/не задана →
# каталог не открывается (403). Ротация: переписать secret и обновить
# одновременно в SSM и в `tools/mcp-kingside.mjs` на стороне пользователя.
MCP_DISCOVERY_KEY=

# KS-2952 (ADR-061 §6). База URL API, которая публикуется в каталоге
# `/_mcp/tools` как `apiBaseUrl`. MCP-сервер использует её для построения
# полных URL вызова инструментов. В dev — http://localhost:3001;
# в prod — https://kingside.app. Пустая = MCP-сервер сам подставит.
MCP_API_BASE_URL=

# KS-2884 (ADR-060 §3.7 B11). База URL `apps/broadcast-service`'а для
# создания/синхронизации broadcast-зеркал. api ходит по
# `${BROADCAST_SERVICE_URL}/internal/rounds/:roundId/with-games` с
# заголовком `X-Internal-Auth = $SYNTHETIC_BOT_INTERNAL_KEY`. В dev —
# http://localhost:3002 (или порт broadcast-service'а); в prod —
# https://broadcasts.kingside.site (или internal-DNS). Пустая = клиент
# выбрасывает Error при попытке использовать.
BROADCAST_SERVICE_URL=

# KS-3615 / ADR-102. LLM-комментарии к ходам через тот же webhook что
# AI Assistant (AI_CHAT_WEBHOOK_URL + WEBHOOK_AUTH_TOKEN). Никаких
# дополнительных credentials не требуется.
#
# REVIEW_COMMENT_MODEL — какая модель используется webhook'ом для
#   review-комментариев. Если не задана — наследуется дефолт из
#   ChatAssistantService (claude-sonnet-4-20250514). Для дешевизны
#   можно переключить на haiku-модель, если webhook её поддерживает.
REVIEW_COMMENT_MODEL=
# Rate-limit (Redis, namespace `review:*`). Дефолты совпадают со
# спецификацией KS-3615 §5. Все три параметра можно поднять/опустить
# через ENV без редеплоя кода — сервис читает их в конструкторе.
REVIEW_COMMENT_RATE_LIMIT_PER_MIN=10
REVIEW_COMMENT_RATE_LIMIT_PER_DAY=30
REVIEW_COMMENT_GLOBAL_DAILY_LIMIT=200
# Дополнительные тонкие настройки (обычно дефолтов хватает):
# REVIEW_COMMENT_MAX_TOKENS_PER_FACT=80
# REVIEW_COMMENT_FETCH_TIMEOUT_MS=180000
