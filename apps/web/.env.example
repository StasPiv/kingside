# Frontend (apps/web) env — пример. Скопировать в /project/.env или /project/apps/web/.env
# (vite.config.ts envDir указывает на корень монорепо).

# Main API (NestJS, apps/api). Prod: https://api.kingside.site
VITE_API_URL=http://localhost:3001

# Archive service (apps/archive-service). Prod: https://archive.kingside.site
# ADR-018 §2.7 — endpoints tree / games/by-position вынесены из main API.
VITE_ARCHIVE_URL=http://localhost:3003

# Broadcast service (apps/broadcast-service). Prod: https://broadcasts.kingside.site
# ADR-021 — endpoints /broadcasts/* вынесены из main API в отдельный сервис,
# со своей БД broadcasts_kingside и WebSocket namespace /broadcast.
VITE_BROADCAST_URL=http://localhost:3004

# Game Service (apps/game-service). Prod: https://game.kingside.site
# Используется для WS game/matchmaking/tournament. Если не задан — используется VITE_API_URL.
# VITE_GAME_URL=http://localhost:3002

# Telegram Login Widget
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_BOT_ID=

# Dev bypass (обход логина для Playwright). Оставить пусто в prod.
VITE_DEV_BYPASS_SECRET=secret

# GA4 analytics (prod only)
# VITE_GA4_ID=
