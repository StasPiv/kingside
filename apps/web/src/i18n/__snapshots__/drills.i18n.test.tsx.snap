exports[`drills i18n — render snapshots > en: snapshot drills.explanation + chess.pieces 1`] = `
{
  "chessPieces": {
    "b": "bishop",
    "k": "king",
    "n": "knight",
    "p": "pawn",
    "q": "queen",
    "r": "rook",
  },
  "explanation": {
    "common": {
      "correctAnswer": "Correct answer: {{answer}}",
      "next": "Next",
      "title": "Review",
      "yourAnswer": "Your answer: {{answer}}",
    },
    "countAttackers": {
      "correct_one": "{{count}} piece attacks {{square}}.",
      "correct_other": "{{count}} pieces attack {{square}}.",
      "list": "Attackers: {{pieces}}.",
      "userAnswer": "Your answer: {{userCount}}.",
    },
    "countDefenders": {
      "correct_one": "{{count}} piece defends {{square}}.",
      "correct_other": "{{count}} pieces defend {{square}}.",
      "list": "Defenders: {{pieces}}.",
      "userAnswer": "Your answer: {{userCount}}.",
    },
    "findAllChecks": {
      "correct_one": "{{count}} move gives check: {{moves}}.",
      "correct_other": "{{count}} moves give check: {{moves}}.",
      "missed": "Missed: {{moves}}.",
      "summaryGroup": "Direct: {{direct}}; discovered: {{discovered}}; double: {{double}}.",
      "tagDirect": "{{from}}{{to}} — direct check.",
      "tagDiscovered": "{{from}}{{to}} — discovered check.",
      "tagDouble": "{{from}}{{to}} — double check.",
      "wrong": "{{moves}} — not a check.",
    },
    "findFork": {
      "correct": "{{piece}} via {{move}} forks {{targets}}.",
      "correctWithCheck": "{{piece}} via {{move}} forks the king ({{king}}) and {{targets}}.",
      "wrong": "{{from}}{{to}} doesn't create a fork.",
    },
    "findHangingPiece": {
      "correct": "{{piece}} on {{square}} is hanging: attacked by {{attackers}}, defended by {{defenders}}.",
      "correctUndefended": "{{piece}} on {{square}} is hanging: attacked by {{attackers}}, no defenders.",
      "wrong": "Your move {{from}}{{to}} doesn't capture the hanging piece.",
    },
    "findLoosePiece": {
      "correct": "{{piece}} on {{square}} is not defended by any friendly piece.",
      "wrong": "Piece on {{square}} is defended by: {{defenders}}.",
    },
    "findPin": {
      "correctAbsolute": "{{attacker}} ({{fromSquare}}) creates an absolute pin: {{pinned}} ({{pinnedSquare}}) is pinned to the king.",
      "correctRelative": "{{attacker}} ({{fromSquare}}) pins {{pinned}} ({{pinnedSquare}}) to the more valuable {{anchor}} ({{anchorSquare}}).",
      "wrong": "{{square}} is not pinned.",
    },
    "findUndefendedAttack": {
      "correct": "{{move}}: attacks {{piece}} ({{square}}), no defenders.",
      "correctFreeWin": "{{move}}: wins {{piece}} ({{square}}) without trade.",
      "correctMulti": "{{move}}: creates {{count}} hanging pieces — {{squares}}.",
      "wrong": "{{from}}{{to}} doesn't create a new threat.",
    },
  },
}
`;

exports[`drills i18n — render snapshots > ru: render-snapshot DrillInstructions + DrillTypeCard для всех 7 типов 1`] = `
<div
  data-testid="drills-i18n-fixture"
>
  <h2>
    Тактические упражнения
  </h2>
  <p>
    Выберите упражнение
  </p>
  <p>
    Короткие упражнения на распознавание паттернов. Одна позиция — один вопрос.
  </p>
  <section
    data-drill-id="findHangingPiece"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Возьмите незащищённую фигуру противника
    </div>
    <button
      aria-label="Висящая фигура. Найдите фигуру противника без защитников и заберите её одним ходом."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Висящая фигура
      </span>
      <span
        class="drill-type-card__desc"
      >
        Найдите фигуру противника без защитников и заберите её одним ходом.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findLoosePiece"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Какая фигура без защиты?
    </div>
    <button
      aria-label="Незащищённая фигура. Найдите на доске фигуру без единого защитника."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Незащищённая фигура
      </span>
      <span
        class="drill-type-card__desc"
      >
        Найдите на доске фигуру без единого защитника.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findPin"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Найдите связанную фигуру
    </div>
    <button
      aria-label="Связка. Определите связанную фигуру — ту, за которой стоит фигура большей ценности (или король)."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Связка
      </span>
      <span
        class="drill-type-card__desc"
      >
        Определите связанную фигуру — ту, за которой стоит фигура большей ценности (или король).
      </span>
    </button>
  </section>
  <section
    data-drill-id="findFork"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Какой ход создаёт у соперника новую вилку (одновременную атаку на две ценные фигуры)?
    </div>
    <button
      aria-label="Создать вилку. Найдите ход, после которого ваша фигура одновременно нападает на две ценные фигуры соперника (конь, слон, ладья, ферзь, король). Такая атака называется вилкой."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Создать вилку
      </span>
      <span
        class="drill-type-card__desc"
      >
        Найдите ход, после которого ваша фигура одновременно нападает на две ценные фигуры соперника (конь, слон, ладья, ферзь, король). Такая атака называется вилкой.
      </span>
    </button>
  </section>
  <section
    data-drill-id="countAttackers"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Сколько фигур атакуют выделенную клетку?
    </div>
    <button
      aria-label="Счёт атакующих. Подсчитайте, сколько фигур атакуют выделенную клетку."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Счёт атакующих
      </span>
      <span
        class="drill-type-card__desc"
      >
        Подсчитайте, сколько фигур атакуют выделенную клетку.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findAllChecks"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Сделайте все ходы с шахом
    </div>
    <button
      aria-label="Все шахи. Отметьте все клетки, с которых можно дать шах."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Все шахи
      </span>
      <span
        class="drill-type-card__desc"
      >
        Отметьте все клетки, с которых можно дать шах.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findUndefendedAttack"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Какой ход создаёт у соперника новую висящую фигуру (под боем и без защиты)?
    </div>
    <button
      aria-label="Создать висящую фигуру. Найдите ход, после которого у соперника появится фигура, атакованная вашей и без защитников — и при этом ваша атакующая фигура сама не подставится под удар."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Создать висящую фигуру
      </span>
      <span
        class="drill-type-card__desc"
      >
        Найдите ход, после которого у соперника появится фигура, атакованная вашей и без защитников — и при этом ваша атакующая фигура сама не подставится под удар.
      </span>
    </button>
  </section>
</div>
`;

