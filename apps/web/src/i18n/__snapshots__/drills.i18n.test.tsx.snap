    data-drill-id="findLoosePiece"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Which piece is undefended?
    </div>
    <button
      aria-label="Loose piece. Find a piece on the board with no defenders."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Loose piece
      </span>
      <span
        class="drill-type-card__desc"
      >
        Find a piece on the board with no defenders.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findPin"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Find the pinned piece
    </div>
    <button
      aria-label="Pin. Locate the piece pinned against a more valuable one (or the king)."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Pin
      </span>
      <span
        class="drill-type-card__desc"
      >
        Locate the piece pinned against a more valuable one (or the king).
      </span>
    </button>
  </section>
  <section
    data-drill-id="findFork"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Which piece forks?
    </div>
    <button
      aria-label="Fork. Find the piece that simultaneously attacks two targets."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Fork
      </span>
      <span
        class="drill-type-card__desc"
      >
        Find the piece that simultaneously attacks two targets.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findMateInOneSquare"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Where is mate-in-one delivered?
    </div>
    <button
      aria-label="Mate in one. Identify the square where mate is given in one move."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Mate in one
      </span>
      <span
        class="drill-type-card__desc"
      >
        Identify the square where mate is given in one move.
      </span>
    </button>
  </section>
  <section
    data-drill-id="countAttackers"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      How many pieces attack the highlighted square?
    </div>
    <button
      aria-label="Count attackers. Count how many pieces attack the marked square."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Count attackers
      </span>
      <span
        class="drill-type-card__desc"
      >
        Count how many pieces attack the marked square.
