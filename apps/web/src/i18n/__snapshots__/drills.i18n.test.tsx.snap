exports[`drills i18n — render snapshots > en: render-snapshot DrillInstructions + DrillTypeCard для всех 7 типов 1`] = `
<div
  data-testid="drills-i18n-fixture"
>
  <h2>
    Tactical drills
  </h2>
  <p>
    Pick a drill
  </p>
  <p>
    Short pattern-recognition exercises. One position — one question.
  </p>
  <section
    data-drill-id="findHangingPiece"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Capture the undefended enemy piece
    </div>
    <button
      aria-label="Hanging piece. Find an undefended enemy piece and capture it in one move."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Hanging piece
      </span>
      <span
        class="drill-type-card__desc"
      >
        Find an undefended enemy piece and capture it in one move.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findLoosePiece"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Which piece is undefended?
    </div>
    <button
      aria-label="Loose piece. Find a piece on the board with no defenders."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Loose piece
      </span>
      <span
        class="drill-type-card__desc"
      >
        Find a piece on the board with no defenders.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findPin"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Find the pinned piece
    </div>
    <button
      aria-label="Pin. Locate the piece pinned against a more valuable one (or the king)."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Pin
      </span>
      <span
        class="drill-type-card__desc"
      >
        Locate the piece pinned against a more valuable one (or the king).
      </span>
    </button>
  </section>
  <section
    data-drill-id="findFork"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Which move creates a new fork (simultaneous attack on two valuable pieces) for the opponent?
    </div>
    <button
      aria-label="Create a fork. Find a move after which your piece simultaneously attacks two valuable opponent pieces (knight, bishop, rook, queen, king). Such an attack is called a fork."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Create a fork
      </span>
      <span
        class="drill-type-card__desc"
      >
        Find a move after which your piece simultaneously attacks two valuable opponent pieces (knight, bishop, rook, queen, king). Such an attack is called a fork.
      </span>
    </button>
  </section>
  <section
    data-drill-id="countAttackers"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      How many pieces attack the highlighted square?
    </div>
    <button
      aria-label="Count attackers. Count how many pieces attack the marked square."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Count attackers
      </span>
      <span
        class="drill-type-card__desc"
      >
        Count how many pieces attack the marked square.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findAllChecks"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Make every check
    </div>
    <button
      aria-label="All checks. Mark every square where you can deliver a check."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        All checks
      </span>
      <span
        class="drill-type-card__desc"
      >
        Mark every square where you can deliver a check.
      </span>
    </button>
  </section>
  <section
    data-drill-id="findUndefendedAttack"
  >
    <div
      class="drill-instructions drill-instructions--info"
      data-testid="drill-instructions"
      data-tone="info"
      role="status"
    >
      Which move creates a new hanging piece (attacked and undefended) for the opponent?
    </div>
    <button
      aria-label="Create a hanging piece. Find a move after which the opponent has a piece that is attacked by your piece and has no defenders — and your attacking piece itself stays safe."
      class="drill-type-card"
      data-disabled="false"
      data-testid="drill-type-card"
      type="button"
    >
      <span
        class="drill-type-card__title"
      >
        Create a hanging piece
      </span>
      <span
        class="drill-type-card__desc"
      >
        Find a move after which the opponent has a piece that is attacked by your piece and has no defenders — and your attacking piece itself stays safe.
      </span>
    </button>
  </section>
</div>
`;

