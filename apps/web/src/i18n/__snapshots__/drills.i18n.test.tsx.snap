exports[`drills i18n — render snapshots > en: snapshot UX-копи (buttons/feedback/errors/lobby/side) 1`] = `
{
  "buttons": {
    "backToLobby": "Back to drills",
    "next": "Next drill",
    "showSolution": "Show solution",
    "skip": "Skip",
    "submit": "Submit",
    "tryAgain": "Try again",
  },
  "errors": {
    "loadFailed": "Could not load drill. Please try again.",
    "noDrillsAvailable": "No drills available for this type yet.",
    "submitFailed": "Could not submit answer. Check your connection.",
  },
  "feedback": {
    "correct": "Correct!",
    "incorrect": "Not quite",
    "partiallyCorrect": "Almost — {{matched}} of {{total}} squares",
    "solutionLabel": "Solution",
    "tryAgainHint": "Look at the position once more before the next try.",
  },
  "lobby": {
    "completedBadge": "Solved",
    "lockedHint": "Solve the previous drill type to unlock.",
    "newBadge": "New",
  },
  "side": {
    "blackToMove": "Black to move",
    "whiteToMove": "White to move",
  },
}
`;

