# apps/web/.env.production — production-build overrides для Vite (ADR-159 §7).
#
# Vite при `vite build` (mode=production) автоматически подгружает
# этот файл дополнительно к базовым `.env` и переменным окружения,
# инжектируемым через `scripts/deploy-aws.sh` (PROD_VITE_API_URL,
# PROD_VITE_ARCHIVE_URL, PROD_VITE_BROADCAST_URL и др.). В dev-режиме
# (`vite dev`) файл игнорируется — там действует `.env.local`.

# KS-4858 / ADR-159 §7 п.3: включаем клиентский direct-stream к Lichess
# для всех посетителей. При обрыве стрима клиент автоматически падает
# на WS-канал сервера (уровень 1) или REST-опрос (уровень 2) — см.
# ADR-159 §2.4. Обратный переход к серверным стримам — установить в
# `false` и переразвернуть.
VITE_BROADCAST_DIRECT_STREAM_ENABLED=true
