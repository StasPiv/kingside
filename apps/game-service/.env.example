# Port for Game Service (WebSocket-primary)
GAME_SERVICE_PORT=3002

# Allowed CORS origins (comma-separated).
# Required in production. In dev, if not set, defaults to http://localhost:<any-port>.
# Example for prod:
# CORS_ORIGIN=https://kingside.site,https://www.kingside.site
CORS_ORIGIN=http://localhost:5173

# Redis (used for Socket.IO adapter when running multiple instances)
REDIS_HOST=localhost
REDIS_PORT=6380

# Socket.IO adapter selection: auto | true | false
WS_USE_REDIS_ADAPTER=auto
ECS_TASK_COUNT=1

# Stockfish
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_MAX_INSTANCES=4

# KS-2197 (ADR-034-v2 §6.6). Сколько мс держать одиночку в очереди
# matchmaker'а до отправки `MATCHMAKING_NO_OPPONENTS` и автоматического
# LEAVE. Default 60000 (60 сек). Невалидное/<=0 → fallback на default.
MATCHMAKING_NO_OPPONENTS_TIMEOUT_MS=60000
