{
  "name": "@kingside/archive-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "archive:backfill": "tsx src/backfill.ts",
    "archive:backfill:extend": "tsx src/backfill.ts --mode=extend",
    "archive:rebuild-position-stats": "tsx src/rebuild-position-stats.ts",
    "archive:classify-existing": "tsx src/classify-existing.ts",
    "archive:cleanup-positions": "tsx src/cleanup-positions.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@kingside/archive-db": "*",
    "@kingside/shared": "*",
    "adm-zip": "^0.5.16",
    "chess.js": "^1.0.0-beta.8",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6.0.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
