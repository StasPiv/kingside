DATABASE_URL=postgresql://kingside:kingside@localhost:5432/kingside

PORT=3001

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://your-production-domain.com

# Frontend (apps/web)
VITE_API_URL=http://localhost:3001
