{
  "name": "kingside",
  "private": true,
  "packageManager": "npm@8.5.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "bash scripts/prevent-worktree-install.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "docker compose up -d && turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0"
  }
}
