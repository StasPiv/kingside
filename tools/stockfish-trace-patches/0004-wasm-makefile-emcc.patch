+# KS-3653 / ADR-107 rev 2: WebAssembly target для stockfish-16-trace.
+# Сборка через emsdk (em++), single-thread, classical eval (NNUE отключён
+# через NNUE_EMBEDDING_OFF — incbin .nnue файла не происходит). Для
+# `eval json` (KS-3648) classical-eval достаточен, NNUE здесь не нужен.
+ifeq ($(ARCH),wasm)
+	arch = any
+	bits = 32
+	prefetch = no
+	popcnt = no
+	sse = no
+	mmx = no
+	sse2 = no
+	ssse3 = no
+	sse41 = no
+	avx2 = no
+	COMP = emscripten
+	EXE = stockfish-16-trace.js
+endif
 endif
 
 
