+# KS-3653 / ADR-107 rev 2: emscripten (em++) для WASM-сборки.
+# Берётся при ARCH=wasm. Single-thread, classical eval (NNUE-incbin
+# отключён через NNUE_EMBEDDING_OFF — иначе .nnue ~40 МБ попадёт в
+# артефакт и перебьёт acceptance < 5 МБ).
+ifeq ($(COMP),emscripten)
+	comp=clang
+	CXX=em++
+	# -UMADV_HUGEPAGE: emcc-libc определяет MADV_HUGEPAGE, но `madvise()`
+	# не имеет реализации в wasm (`undefined symbol: __syscall_madvise`).
+	# Снимаем preprocessor-флаг, чтобы misc.cpp не вызывал madvise().
+	CXXFLAGS += -Wno-deprecated-declarations -DNNUE_EMBEDDING_OFF -UMADV_HUGEPAGE -UMADV_RANDOM
+	# JS/WASM-выход. EXPORT_NAME=StockfishTrace — модуль будет
+	# `await StockfishTrace()` на клиенте. ENVIRONMENT=web,worker,node
+	# чтобы smoke прогонять через Node, а в продукте грузить как worker.
+	EMFLAGS  = -s MODULARIZE=1 -s EXPORT_NAME=StockfishTrace
+	EMFLAGS += -s ENVIRONMENT=web,worker,node
+	EMFLAGS += -s EXIT_RUNTIME=0
+	EMFLAGS += -s ALLOW_MEMORY_GROWTH=1
+	EMFLAGS += -s INITIAL_MEMORY=33554432
+	EMFLAGS += -s MAXIMUM_MEMORY=536870912
+	EMFLAGS += -s FILESYSTEM=0
+	EMFLAGS += -s STRICT=1
+	EMFLAGS += -s ASSERTIONS=0
+	# Stockfish внутри использует std::thread даже в single-thread сценарии
+	# (UCI worker, ttsave и т.п.). `-pthread` — новый стандартный флаг (вместо
+	# устаревшего USE_PTHREADS=1) для minimal pthread-runtime поверх
+	# SharedArrayBuffer. PTHREAD_POOL_SIZE=1 — один воркер достаточно для
+	# `eval json` (поиска не делаем).
+	EMFLAGS += -pthread -s PTHREAD_POOL_SIZE=1
+	EMFLAGS += -s EXPORTED_RUNTIME_METHODS=['ccall','UTF8ToString','stringToUTF8']
+	# Stockfish tbprobe.cpp использует mmap/madvise/munmap для Syzygy
+	# tablebase. В WASM эти syscall'ы не реализованы — нам tablebase в
+	# браузерном `eval json` не нужны, поэтому даём линкеру разрешение
+	# оставить эти символы как stub-ы; в рантайме Tablebases::probe_* не
+	# вызываются (по факту использования только `position` + `eval json`).
+	EMFLAGS += -s ERROR_ON_UNDEFINED_SYMBOLS=0
+	# Имя .wasm em++ определяет из имени .js (stockfish-16-trace.js →
+	# stockfish-16-trace.wasm). WASM_BINARY_FILE задавать вручную нельзя —
+	# это internal-setting emcc.
+	CXXFLAGS += $(EMFLAGS)
+	LDFLAGS  += $(EMFLAGS) --closure 1
+endif
+
 # To cross-compile for Android, NDK version r21 or later is recommended.
 # In earlier NDK versions, you'll need to pass -fno-addrsig if using GNU binutils.
 # Currently we don't know how to make PGO builds with the NDK yet.
@@ -535,7 +598,9 @@ ifeq ($(COMP),gcc)
 endif
 
 ### On mingw use Windows threads, otherwise POSIX
+# KS-3653: emscripten single-thread → исключаем pthread полностью.
 ifneq ($(comp),mingw)
+ifneq ($(COMP),emscripten)
 	CXXFLAGS += -DUSE_PTHREADS
 	# On Android Bionic's C library comes with its own pthread implementation bundled in
 	ifneq ($(OS),Android)
@@ -547,6 +612,7 @@ ifneq ($(comp),mingw)
 		endif
 	endif
 endif
+endif
 
 ### 3.2.1 Debugging
 ifeq ($(debug),no)
@@ -585,9 +651,14 @@ ifeq ($(optimize),yes)
 	endif
 
 	ifeq ($(comp),clang)
-		clangmajorversion = $(shell $(CXX) -dumpversion 2>/dev/null | cut -f1 -d.)
-		ifeq ($(shell expr $(clangmajorversion) \< 16),1)
-			CXXFLAGS += -fexperimental-new-pass-manager
+		# KS-3653: для em++ (`-dumpversion` возвращает 3.1.55 emscripten,
+		# но underlying clang новее 16) флаг -fexperimental-new-pass-manager
+		# неизвестен. Отключаем для COMP=emscripten.
+		ifneq ($(COMP),emscripten)
+			clangmajorversion = $(shell $(CXX) -dumpversion 2>/dev/null | cut -f1 -d.)
+			ifeq ($(shell expr $(clangmajorversion) \< 16),1)
+				CXXFLAGS += -fexperimental-new-pass-manager
+			endif
 		endif
 	endif
 endif
@@ -718,7 +789,12 @@ endif
 ### needs access to the optimization flags.
 ifeq ($(optimize),yes)
 ifeq ($(debug), no)
-	ifeq ($(comp),$(filter $(comp),clang icx))
+	# KS-3653: для COMP=emscripten LTO выключаем — даёт ложные подтягивания
+	# из libc.a (madvise.o → undefined __syscall_madvise) и не уменьшает
+	# .wasm так же сильно как -Oz/--closure. Размер контролируется отдельно.
+	ifeq ($(COMP),emscripten)
+		LDFLAGS += $(CXXFLAGS)
+	else ifeq ($(comp),$(filter $(comp),clang icx))
 		CXXFLAGS += -flto=full
 		ifeq ($(comp),icx)
 			CXXFLAGS += -fwhole-program-vtables
